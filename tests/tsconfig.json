{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist-tests",
    "module": "CommonJS",
    // TypeScript 6 deprecates `node10` resolution and `baseUrl`; `paths` resolve
    // relative to this file instead.
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    // #778 — ts-jest reads this and compiles each file on its own without type-checking, which
    // makes the suites about a fifth faster. Type errors are still caught: typecheck:tests
    // checks this whole program in CI, and with this flag it also refuses the patterns that
    // can't be compiled one file at a time (const enums, re-exported types without `type`).
    "isolatedModules": true,
    // The generated hey-api fetch client is DOM-typed (BodyInit, RequestInit).
    // Tests import through it, so the tests program needs the DOM lib.
    "lib": ["ES2022", "DOM"],
    // The functional suites use Jest's globals; TypeScript 6 loads only listed @types.
    "types": ["node", "jest"],
    "paths": {
      "@poolmaster/shared/*": ["../packages/shared/*"],
      "@poolmaster/mock-contest-feed-provider/generated/hey-api/types": [
        "../packages/mock-contest-feed-provider/generated/hey-api/types.gen.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../packages/*/src/**/*.ts",
    "../packages/shared/**/*.ts"
  ],
  "exclude": [
    // Build tooling config, not test or product code. It is typed against the
    // generator's own CLI types and does not belong in the tests program;
    // `packages/shared/tsconfig.node.json` typechecks it instead.
    "../packages/shared/openapi-ts.config.ts"
  ]
}
