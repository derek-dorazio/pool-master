model LeagueInvitation {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId    String                       @map("league_id") @db.Uuid
  email       String?                      @db.VarChar(255)
  inviteCode  String                       @unique @map("invite_code") @db.VarChar(100)
  inviteType  PrismaLeagueInviteType       @default(EMAIL) @map("invite_type")
  status      PrismaLeagueInvitationStatus @default(PENDING)
  maxUses     Int                          @default(1) @map("max_uses")
  currentUses Int                          @default(0) @map("current_uses")
  invitedBy   String                       @map("invited_by") @db.Uuid
  expiresAt   DateTime?                    @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?                    @map("accepted_at") @db.Timestamptz
  acceptedBy  String?                      @map("accepted_by") @db.Uuid
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  league   League @relation(fields: [leagueId], references: [id])
  inviter  User   @relation("InvitedBy", fields: [invitedBy], references: [id])
  acceptor User?  @relation("AcceptedBy", fields: [acceptedBy], references: [id])

  emailMessages EmailMessage[]

  @@index([leagueId, status])
  @@index([invitedBy])
  @@index([acceptedBy])
  @@map("league_invitations")
}

/// One system email to one person (#844): queued and sent by the sender, or skipped with the
/// reason. A check constraint holds skip_reason to exactly the SKIPPED rows.
model EmailMessage {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey        PrismaEmailTemplateKey   @map("template_key")
  recipientUserId    String?                  @map("recipient_user_id") @db.Uuid
  recipientEmail     String                   @map("recipient_email") @db.VarChar(255)
  leagueId           String?                  @map("league_id") @db.Uuid
  contestId          String?                  @map("contest_id") @db.Uuid
  entryId            String?                  @map("entry_id") @db.Uuid
  invitationId       String?                  @map("invitation_id") @db.Uuid
  idempotencyKey     String                   @unique @map("idempotency_key")
  /// The subject a sweep asks "already told?" about (#1169), such as the event an "event coming
  /// up" email is about: its idempotency key without the league or the recipient. Matched exactly,
  /// so the check reads only that subject's rows. Null on an email no sweep checks for.
  noticeAbout        String?                  @map("notice_about") @db.VarChar(200)
  fromName           String                   @map("from_name") @db.VarChar(255)
  fromAddress        String                   @map("from_address") @db.VarChar(255)
  subject            String?
  textBody           String?                  @map("text_body")
  htmlBody           String?                  @map("html_body")
  /// The one-click unsubscribe URL sent as List-Unsubscribe, on an email a member can turn off.
  listUnsubscribeUrl String?                  @map("list_unsubscribe_url")
  status             PrismaEmailMessageStatus
  skipReason         PrismaEmailSkipReason?   @map("skip_reason")
  attempts           Int                      @default(0)
  nextAttemptAt      DateTime?                @map("next_attempt_at") @db.Timestamptz
  lastError          String?                  @map("last_error")
  providerMessageId  String?                  @map("provider_message_id") @db.VarChar(255)
  sentAt             DateTime?                @map("sent_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  // Deleting an account deletes the emails it was sent; deleting what an email is about keeps it.
  recipient  User?             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  league     League?           @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  contest    Contest?          @relation(fields: [contestId], references: [id], onDelete: SetNull)
  entry      ContestEntry?     @relation(fields: [entryId], references: [id], onDelete: SetNull)
  invitation LeagueInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  suppressions EmailSuppression[]

  @@index([status, nextAttemptAt])
  @@index([invitationId, createdAt])
  @@index([createdAt])
  @@index([providerMessageId])
  @@index([contestId, templateKey])
  @@index([templateKey, noticeAbout, leagueId])
  @@index([entryId])
  @@index([leagueId])
  @@index([recipientUserId])
  /// The Notifications page's sent counts and latest send per email (#1870).
  @@index([templateKey, sentAt])
  @@map("email_messages")
}

/// #844 SES slice 4: addresses the app no longer emails, after a permanent bounce or a complaint.
model EmailSuppression {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lower-cased.
  email             String                       @unique @db.VarChar(255)
  suppressionReason PrismaEmailSuppressionReason @map("suppression_reason")
  emailMessageId    String?                      @map("email_message_id") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  @@index([emailMessageId])
  @@map("email_suppressions")
}

model SquadOwnerInvitation {
  id                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId             String                           @map("league_id") @db.Uuid
  squadId              String                           @map("squad_id") @db.Uuid
  email                String                           @db.VarChar(255)
  inviteCode           String                           @unique @map("invite_code") @db.VarChar(100)
  status               PrismaSquadOwnerInvitationStatus @default(PENDING)
  invitedBy            String                           @map("invited_by") @db.Uuid
  expiresAt            DateTime?                        @map("expires_at") @db.Timestamptz
  acceptedAt           DateTime?                        @map("accepted_at") @db.Timestamptz
  acceptedBy           String?                          @map("accepted_by") @db.Uuid
  replacementForUserId String?                          @map("replacement_for_user_id") @db.Uuid
  createdAt            DateTime                         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                         @updatedAt @map("updated_at") @db.Timestamptz

  league   League @relation(fields: [leagueId], references: [id])
  squad    Squad  @relation(fields: [squadId], references: [id])
  inviter  User   @relation("SquadOwnerInvitedBy", fields: [invitedBy], references: [id])
  acceptor User?  @relation("SquadOwnerAcceptedBy", fields: [acceptedBy], references: [id])

  @@index([leagueId, status])
  @@index([squadId, status])
