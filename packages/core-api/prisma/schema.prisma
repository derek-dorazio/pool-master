  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PrismaSquadOwnerInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PrismaParticipantType {
  INDIVIDUAL
  TEAM
}

enum PrismaParticipantStatus {
  ACTIVE
  INACTIVE
  RETIRED
  SUSPENDED
}

enum PrismaParticipantFormTrend {
  RISING
  STABLE
  FALLING
}

enum PrismaParticipantMappingConfidence {
  EXACT
  HIGH
  MANUAL
}

enum PrismaSportEventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

/// Why a SportEventParticipant is inactive. Cross-sport: a golfer who misses
/// the cut, a knocked-out seed and an eliminated driver are all ELIMINATED; a
/// golf surface renders ELIMINATED as "Cut" for its audience. null means
/// "inactive, no more specific reason recorded" — there is no OTHER.
enum ParticipantInactiveReason {
  WITHDRAWN
  ELIMINATED
}

enum PrismaSportEventSyncScope {
  NONE
  SCORES_ONLY
  FULL
}

/// How a SportEventParticipantValuation's tier or price was set.
enum ValuationSource {
  AUTO_ODDS
  AUTO_RANKING
  MANUAL
}

/// A participant's live state within one event. Cross-sport: ELIMINATED covers
/// a golfer who missed the cut as well as a knocked-out team.
enum ParticipantStandingStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETE
  WITHDRAWN
  ELIMINATED
}

// =============================================================================
// Substrate redesign — pool-master-rop.78 / Phase 4 (rop.78.4)
// =============================================================================

/// Sport category — drives per-category detail table dispatch.
/// One row per category; multiple Sport rows may share the same category
/// (e.g., "PGA Masters" and "Wimbledon" use different category but share
/// the ROSTER pool format via tournamentFormat).
enum PrismaSportCategory {
  GOLF
  BASKETBALL
  FOOTBALL
  F1
  NASCAR
  TENNIS
  SOCCER
}

/// Tournament structural format — drives which contest types are valid
/// pool formats for a given Sport. Composes with category to form the
/// (sport × pool format) compatibility matrix in shared/domain.
enum PrismaTournamentFormat {
  STROKE_PLAY_TOURNAMENT
  KNOCKOUT_BRACKET
  SERIES_PLAYOFF
  ROUND_ROBIN_SEASON
  WEEKLY_GAMES_SEASON
  TIME_TRIAL_RACE
  SEASON_OF_RACES
  GROUP_STAGE_KNOCKOUT
  MATCH_PLAY
}

/// Contest format — the pool format applied to a SportEvent. Validity vs.
/// tournamentFormat is enforced by the const map in packages/shared/domain
/// (see plans/117 §9). Replaces the legacy `ContestType.SINGLE_EVENT` enum
/// which was a duration/scope concept that turned out not to be load-bearing.
/// Multi-event contest coverage will be re-modeled when a real multi-event
/// contest type is built (the speculative ContestSportEvent M:N join that
/// once anticipated it was removed as dead scaffolding — plans/124 §4.11).
enum PrismaContestFormat {
  ROSTER
  BRACKET
  PICKEM_CONFIDENCE
  SURVIVOR
  PREDICT_TOP_N
}

// =============================================================================
// UTC Storage Convention
// =============================================================================
//
// ALL timestamps in this schema are stored as UTC.
//
// - Every DateTime column uses @db.Timestamptz (PostgreSQL `timestamptz`).
// - Application code MUST write UTC values — never local times.
// - Timezone conversion is a **display concern** handled by the client using
//   the user's persisted account timezone or the league default timezone when
//   it exists.
// - Resolution order: user timezone > league timezone.
//
// See plans/14-poolmaster-localisation-i18n.md for the full timezone strategy.
// =============================================================================

// =============================================================================
// Identity
// =============================================================================

model User {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String            @unique
  username     String            @unique @db.VarChar(100)
  passwordHash String?           @map("password_hash")
  firstName    String            @map("first_name") @db.VarChar(100)
  lastName     String            @map("last_name") @db.VarChar(100)
  isActive     Boolean           @default(true) @map("is_active")
  authProvider UserAuthProvider? @map("auth_provider")
  authId       String?           @map("auth_id")
  isRootAdmin  Boolean           @default(false) @map("is_root_admin")
  timezone     String?           @db.VarChar(50)
  locale       String?           @default("en-US") @db.VarChar(10)
  timeFormat   UserTimeFormat?   @default(TWELVE_HOUR) @map("time_format")
  dateFormat   UserDateFormat?   @default(MDY) @map("date_format")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  memberships                   LeagueMembership[]
  createdSquads                 Squad[]                @relation("SquadCreatedBy")
  squadMemberships              SquadMembership[]
  invitationsSent               LeagueInvitation[]     @relation("InvitedBy")
  invitationsAccepted           LeagueInvitation[]     @relation("AcceptedBy")
  squadOwnerInvitationsSent     SquadOwnerInvitation[] @relation("SquadOwnerInvitedBy")
  squadOwnerInvitationsAccepted SquadOwnerInvitation[] @relation("SquadOwnerAcceptedBy")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique
  sessionId String    @default(uuid()) @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

// =============================================================================
// League
// =============================================================================

model League {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueCode  String                 @unique @map("league_code") @db.VarChar(16)
  name        String
  description String?
  isActive    Boolean                @default(true) @map("is_active")
  iconKey     PrismaLeagueIconKey    @default(TROPHY) @map("icon_key")
  joinPolicy  PrismaLeagueJoinPolicy @default(COMMISSIONER_ONLY) @map("join_policy")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  memberships           LeagueMembership[]
  squads                Squad[]
  squadMemberships      SquadMembership[]
  contests              Contest[]
  invitations           LeagueInvitation[]
  squadOwnerInvitations SquadOwnerInvitation[]

  @@map("leagues")
}

model LeagueMembership {
  id        String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId  String                       @map("league_id") @db.Uuid
  userId    String                       @map("user_id") @db.Uuid
  role      PrismaLeagueRole             @default(MEMBER)
  status    PrismaLeagueMembershipStatus @default(ACTIVE)
  joinedAt  DateTime                     @default(now()) @map("joined_at") @db.Timestamptz
  createdAt DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([leagueId, userId])
  @@index([leagueId, status])
  @@map("league_memberships")
}

model Squad {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId  String             @map("league_id") @db.Uuid
  createdBy String             @map("created_by") @db.Uuid
  name      String
  iconKey   PrismaSquadIconKey @default(CAPTAIN_SMILE_FIELD) @map("icon_key")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  league           League                 @relation(fields: [leagueId], references: [id])
  creator          User                   @relation("SquadCreatedBy", fields: [createdBy], references: [id])
  memberships      SquadMembership[]
  entries          ContestEntry[]
  ownerInvitations SquadOwnerInvitation[]

  @@unique([leagueId, name])
  @@index([leagueId, isActive])
  @@map("squads")
}

model SquadMembership {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  squadId   String                      @map("squad_id") @db.Uuid
  leagueId  String                      @map("league_id") @db.Uuid
  userId    String                      @map("user_id") @db.Uuid
  status    PrismaSquadMembershipStatus @default(ACTIVE)
  joinedAt  DateTime                    @default(now()) @map("joined_at") @db.Timestamptz
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  squad  Squad  @relation(fields: [squadId], references: [id])
  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([squadId, userId])
  @@unique([leagueId, userId])
  @@index([squadId, status])
  @@map("squad_memberships")
}

model LeagueInvitation {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId    String                       @map("league_id") @db.Uuid
  email       String?                      @db.VarChar(255)
  inviteCode  String                       @unique @map("invite_code") @db.VarChar(100)
  inviteType  PrismaLeagueInviteType       @default(EMAIL) @map("invite_type")
  status      PrismaLeagueInvitationStatus @default(PENDING)
  maxUses     Int                          @default(1) @map("max_uses")
  currentUses Int                          @default(0) @map("current_uses")
  invitedBy   String                       @map("invited_by") @db.Uuid
  expiresAt   DateTime?                    @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?                    @map("accepted_at") @db.Timestamptz
  acceptedBy  String?                      @map("accepted_by") @db.Uuid
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  league   League @relation(fields: [leagueId], references: [id])
  inviter  User   @relation("InvitedBy", fields: [invitedBy], references: [id])
  acceptor User?  @relation("AcceptedBy", fields: [acceptedBy], references: [id])

  @@index([leagueId, status])
  @@map("league_invitations")
}

model SquadOwnerInvitation {
  id                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId             String                           @map("league_id") @db.Uuid
  squadId              String                           @map("squad_id") @db.Uuid
  email                String                           @db.VarChar(255)
  inviteCode           String                           @unique @map("invite_code") @db.VarChar(100)
  status               PrismaSquadOwnerInvitationStatus @default(PENDING)
  invitedBy            String                           @map("invited_by") @db.Uuid
  expiresAt            DateTime?                        @map("expires_at") @db.Timestamptz
  acceptedAt           DateTime?                        @map("accepted_at") @db.Timestamptz
  acceptedBy           String?                          @map("accepted_by") @db.Uuid
  replacementForUserId String?                          @map("replacement_for_user_id") @db.Uuid
  createdAt            DateTime                         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                         @updatedAt @map("updated_at") @db.Timestamptz

  league   League @relation(fields: [leagueId], references: [id])
  squad    Squad  @relation(fields: [squadId], references: [id])
  inviter  User   @relation("SquadOwnerInvitedBy", fields: [invitedBy], references: [id])
  acceptor User?  @relation("SquadOwnerAcceptedBy", fields: [acceptedBy], references: [id])

  @@index([leagueId, status])
  @@index([squadId, status])
  @@map("squad_owner_invitations")
}

// =============================================================================
// Sport & Participant
// =============================================================================

model Sport {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                 @unique
  participantType  PrismaParticipantType  @map("participant_type")
  category         PrismaSportCategory    @default(GOLF)
  /// No default (#236): the table that discriminates between sports must not
  /// make a row a stroke-play golf sport by omission. Creators take it from
  /// DEFAULT_TOURNAMENT_FORMAT_BY_SPORT. `category` still defaults to GOLF —
  /// the enum has no value for NHL, MLB, UFC or horse racing and nothing reads
  /// the column, so it is raised on #236 rather than guessed here.
  tournamentFormat PrismaTournamentFormat @map("tournament_format")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  participants Participant[]
  sportLeagues SportLeague[]

  @@map("sports")
}

/// A real-world sport league/tour/conference — PGA Tour, LIV Golf, LPGA Tour
/// for golf; NBA, NCAA Basketball for basketball; etc. Cross-sport by design
/// (sportId scopes it), not golf-specific. Named SportLeague, not League,
/// because League is already the PoolMaster office-pool model. See plans/124
/// §4.2 design note.
model SportLeague {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportId          String   @map("sport_id") @db.Uuid
  name             String   @db.VarChar(255)
  matchKeyword     String?  @map("match_keyword") @db.VarChar(255)
  /// The event year the tour is currently on — a business pointer, not a foreign
  /// key: "set as current" refuses a year with no events for this tour, which is the
  /// integrity the season FK used to give (plans/147 decision 6).
  currentEventYear Int?     @map("current_event_year")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sport        Sport                          @relation(fields: [sportId], references: [id])
  affiliations ParticipantLeagueAffiliation[]
  eventSeries  EventSeries[]

  @@unique([sportId, name])
  @@map("sport_leagues")
}

/// A recurring, named tournament that repeats year after year under one
/// stable identity — "The Masters," "The US Open" — separate from any one
/// year's SportEvent edition of it. SportEvent rows point here; this never
/// points to a specific year. Auto-resolved by find-or-create on
/// (sportLeagueId, name) at tournament creation — no new admin decision
/// (plans/124 §4.3a). See plans/147.
model EventSeries {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId String   @map("sport_league_id") @db.Uuid
  name          String
  /// A dimension's lifecycle, like SportLeague's: false retires the series
  /// without touching its past editions (plans/147 decision 9).
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague SportLeague  @relation(fields: [sportLeagueId], references: [id])
  sportEvents SportEvent[]

  @@unique([sportLeagueId, name])
  @@map("event_series")
}

/// Which participants are currently affiliated with which sport league, plus
/// their current ranking there. Sport-league-scoped, not season-scoped — a
/// competitor's membership and ranking don't reset every year. Current value
/// only, no history. See plans/124 §4.2.
model ParticipantLeagueAffiliation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  sportLeagueId String   @map("sport_league_id") @db.Uuid
  /// The competitor's current rank in this sport league (1 is best).
  ranking       Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  participant Participant @relation(fields: [participantId], references: [id])
  sportLeague SportLeague @relation(fields: [sportLeagueId], references: [id])

  @@unique([participantId, sportLeagueId])
  @@index([sportLeagueId, ranking])
  @@map("participant_league_affiliations")
}

model Participant {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportId         String                @map("sport_id") @db.Uuid
  name            String
  participantType PrismaParticipantType @map("participant_type")
  externalId      String?               @map("external_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  // Enriched profile fields (Plan 05)
  firstName        String?                 @map("first_name")
  lastName         String?                 @map("last_name")
  shortName        String?                 @map("short_name") @db.VarChar(100)
  nationality      String?                 @db.VarChar(10)
  /// Playing role ("GOLFER", "QB"), not a rank — `position` means rank on the standing tables.
  role             String?                 @db.VarChar(50)
  teamAffiliation  String?                 @map("team_affiliation")
  status           PrismaParticipantStatus @default(ACTIVE)
  injuryStatus     Json                    @default("{\"status\": \"HEALTHY\"}") @map("injury_status")
  photoUrl         String?                 @map("photo_url")
  photoLastUpdated DateTime?               @map("photo_last_updated") @db.Timestamptz
  externalIds      Json                    @default("{}") @map("external_ids")

  sport                  Sport                          @relation(fields: [sportId], references: [id])
  providerMappings       ParticipantProviderMapping[]
  rankingSnapshots       ParticipantRankingSnapshot[]
  sportEventParticipants SportEventParticipant[]
  leagueAffiliations     ParticipantLeagueAffiliation[]

  @@index([sportId])
  @@index([sportId, status])
  @@map("participants")
}

model ParticipantProviderMapping {
  id            String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String                             @map("participant_id") @db.Uuid
  providerId    String                             @map("provider_id") @db.VarChar(100)
  externalId    String                             @map("external_id") @db.VarChar(255)
  confidence    PrismaParticipantMappingConfidence @default(EXACT)
  mappedAt      DateTime                           @default(now()) @map("mapped_at") @db.Timestamptz
  createdAt     DateTime                           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                           @updatedAt @map("updated_at") @db.Timestamptz

  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([providerId, externalId])
  @@index([participantId])
  @@map("participant_provider_mappings")
}

model ParticipantRankingSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  providerId    String   @map("provider_id") @db.VarChar(100)
  rankingType   String   @map("ranking_type") @db.VarChar(50)
  rank          Int
  points        Decimal? @db.Decimal(12, 4)
  asOfDate      DateTime @map("as_of_date") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([providerId, participantId, rankingType, asOfDate])
  @@index([providerId, rankingType, asOfDate])
  @@index([participantId, rankingType, asOfDate])
  @@map("participant_ranking_snapshots")
}

