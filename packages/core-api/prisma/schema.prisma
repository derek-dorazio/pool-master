  @@map("squad_owner_invitations")
}

// =============================================================================
// Sport & Participant
// =============================================================================

model Sport {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Which sport this row is (#603). One row per built sport, seeded by the
  /// migration that adds the sport's support.
  sport            PrismaSport            @unique
  /// The sport's name in addresses (#2042): `/play/football/...`, `?sport=horse-racing`.
  /// Stored, never built from the code, so the API and the web app spell it the same way. Set by
  /// the migration that adds the sport, and kept forever, because addresses are.
  urlSegment       String                 @unique @map("url_segment") @db.VarChar(50)
  /// Where the sport sits wherever sports are listed together, grids included (#2042): the most
  /// popular first. Lower comes first. Display only, never used to identify a sport.
  displayOrder     Int                    @unique @map("display_order")
  /// No default (#236): the table that discriminates between sports must not
  /// make a row a stroke-play golf sport by omission. Creators take it from
  /// DEFAULT_TOURNAMENT_FORMAT_BY_SPORT.
  tournamentFormat PrismaTournamentFormat @map("tournament_format")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  sportLeagues    SportLeague[]
  providerLeagues ProviderLeague[]
  eventPages      EventPage[]

  @@map("sports")
}

/// A real-world sport league/tour/conference — PGA Tour, LIV Golf, LPGA Tour
/// for golf; NBA, NCAA Basketball for basketball; etc. Cross-sport by design
/// (sportId scopes it), not golf-specific. Named SportLeague, not League,
/// because League is already the PoolMaster office-pool model. See plans/124
/// §4.2 design note.
model SportLeague {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportId                    String                   @map("sport_id") @db.Uuid
  name                       String                   @db.VarChar(255)
  /// The sport league's name in addresses (#2042, #2143): How to Play's
  /// `?sport=basketball&league=wnba`. A short code that names the league on its own, unique
  /// across every sport. Stored, never built from the name, and kept forever.
  urlSegment                 String                   @unique @map("url_segment") @db.VarChar(100)
  /// The league's current Season (#2003, plan §2): recomputed once a day from the Season rows by
  /// one global rule (`currentSeasonOf`), never set by hand. Null only for a league no migration
  /// has given a Season.
  currentSeasonId            String?                  @map("current_season_id") @db.Uuid
  /// The IANA time zone the league's calendar weeks break in (#2003, plan §1): Monday to Sunday
  /// there. Reference data, set by the migration that seeds the league.
  timeZone                   String                   @map("time_zone") @db.VarChar(64)
  isActive                   Boolean                  @default(true) @map("is_active")
  /// The tier profile a new event of the sport league is tiered with (#1844): how many tiers it
  /// starts with, how many participants auto-tiering puts in each, and what the last tier takes.
  /// Every league names one; a new league gets its profile from the migration that seeds it.
  platformTierProfileId      String                   @map("platform_tier_profile_id") @db.Uuid
  /// The pricing profile an event of the sport league is priced with after a field sync (#1844),
  /// until an admin prices it with other values. Every league names one.
  platformPricingProfileId   String                   @map("platform_pricing_profile_id") @db.Uuid
  /// The first round whose matches are single games a squares pool can be played on, when not
  /// every round's are (#787: a Champions League two-legged tie or an MLS best-of-three series
  /// is one match with no half-time score). Null: every round. Reference data, set by the
  /// migration that seeds the league.
  squaresFromRound           Int?                     @map("squares_from_round")
  /// What screens call the sport league, when not what its sport calls one (#834: the NCAA's
  /// tennis championships are leagues, not tours). Null: the sport's noun. Reference data, set by
  /// the migration that seeds the league.
  noun                       PrismaSportLeagueNoun?   @map("noun")
  /// Where the sport league sits among its sport's leagues wherever they are listed together
  /// (How to Play's chips): the major professional leagues first, then the NCAA's. Lower comes
  /// first; null comes after every ordered league, by name. Reference data, set by the migration
  /// that seeds the league.
  displayOrder               Int?                     @map("display_order")
  /// Who competes in its events: teams or individuals (#2001). The league is the one home of
  /// this fact; the sport says nothing about it. Reference data, set by the migration that
  /// seeds the league.
  participantType            PrismaParticipantType    @map("participant_type")
  /// How its events' results are stored and scored (#2001). The league is the one home of this
  /// fact. Reference data, set by the migration that seeds the league.
  scoringFamily              PrismaScoringFamily      @map("scoring_family")
  /// The provider league whose sync creates and keeps this sport league's events (ADR 0011,
  /// #1997): one of the league's own provider mappings, so a league can be mapped to a second
  /// provider before it switches. Null: the league is not synced. Set by a root admin.
  selectedProviderMappingId  String?                  @map("selected_provider_mapping_id") @db.Uuid
  /// How many days before its start a synced DRAFT event of this sport league is released on its
  /// own once every ready check passes (#1823): the release sweep tries it each hour of that
  /// window and logs each try. Null: never automatically; a root admin releases by hand. 1 to 30.
  autoReleaseDaysBeforeStart Int?                     @default(7) @map("auto_release_days_before_start")
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  sport                       Sport                        @relation(fields: [sportId], references: [id])
  platformTierProfile         PlatformTierProfile          @relation(fields: [platformTierProfileId], references: [id], onDelete: Restrict)
  platformPricingProfile      PlatformPricingProfile       @relation(fields: [platformPricingProfileId], references: [id], onDelete: Restrict)
  participants                Participant[]
  providerMappings            ParticipantProviderMapping[]
  sportEvents                 SportEvent[]
  contestConfigTemplates      ContestConfigTemplate[]
  cups                        Cup[]
  eventPageOffers             EventPageOffer[]
  sportLeagueProviderMappings SportLeagueProviderMapping[] @relation("SportLeagueProviderMappings")
  phases                      SportLeaguePhase[]
  competitions                SportLeagueCompetition[]
  competitionSlots            SportLeagueCompetitionSlot[]
  seasons                     SportLeagueSeason[]
  /// The composite key keeps the current Season one of the league's own.
  currentSeason               SportLeagueSeason?           @relation("CurrentSportLeagueSeason", fields: [id, currentSeasonId], references: [sportLeagueId, id], onDelete: NoAction, onUpdate: NoAction, map: "sport_leagues_current_season_fkey")
  syncFindings                ProviderSyncFinding[]
  syncRuns                    ProviderSyncRun[]
  positions                   SportLeaguePosition[]
  /// The composite key keeps the selected mapping one of the league's own.
  selectedProviderMapping     SportLeagueProviderMapping?  @relation("SelectedSportLeagueProviderMapping", fields: [id, selectedProviderMappingId], references: [sportLeagueId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sportId, name])
  /// A mapping is selected by at most its own league, once.
  @@unique([id, selectedProviderMappingId])
  /// A Season is current for at most its own league.
  @@unique([id, currentSeasonId])
  @@index([platformTierProfileId])
  @@index([platformPricingProfileId])
  @@map("sport_leagues")
}

/// What a tier profile's last tier takes (#1844).
enum PrismaPlatformTierProfileLastTier {
  /// Everyone left after the tiers before it are filled.
  ALL_REMAINING
  /// At most `lastTierMax`; anyone beyond is in no tier and can't be picked.
  CAPPED
}

/// A value a field can be put in order by (#1807, #2160): odds to win, seed or rank.
enum PrismaFieldOrderBasis {
  ODDS
  SEED
  RANKING
}

/// How a tier profile lays a field out in tiers (#2160).
enum PrismaTierProfileType {
  /// Tiers of one size, filled in the field's order.
  EQUAL_GROUPS
  /// Each tier the seeds or ranks its range holds (`PlatformTierProfileRange`).
  RANGES
}

/// A tier layout, defined once for the platform (#1844): each sport league names one, and a new
/// event of the league starts with its tiers and is auto-tiered by it. Nothing is set per sport.
/// The field is put in order by the profile's sources (#2160), then laid out by its type. A
/// database check keeps the EQUAL_GROUPS columns set on EQUAL_GROUPS rows and null on RANGES rows.
/// On EQUAL_GROUPS, a field too small to reach the last tier is split evenly over the tiers, a
/// rule fixed in code.
model PlatformTierProfile {
  id          String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The profile's key (#2000): migrations, seed scripts and test data find a profile by it, never
  /// by its name. Upper case letters, digits and underscores; set when the profile is made.
  code        String                             @unique @db.VarChar(50)
  /// The root admin's name for the profile. Screens read the display strings keyed by `code`
  /// (`tierProfile.<CODE>.name`) and fall back to it only until a change seeds them (#2194).
  name        String                             @unique @db.VarChar(50)
  /// Plain English for agents and root admins: what the profile is and why it exists. Not
  /// translated and not shown to commissioners or members (#2194).
  description String                             @db.VarChar(500)
  type        PrismaTierProfileType
  /// EQUAL_GROUPS only: how many tiers a new event starts with. A RANGES profile has one per range.
  tierCount   Int?                               @map("tier_count")
  /// EQUAL_GROUPS only: participants auto-tiering puts in each tier before the last.
  tierSize    Int?                               @map("tier_size")
  /// EQUAL_GROUPS only.
  lastTier    PrismaPlatformTierProfileLastTier? @map("last_tier")
  /// EQUAL_GROUPS only: the most the last tier takes when it is CAPPED; null when it takes all remaining.
  lastTierMax Int?                               @map("last_tier_max")
  createdAt   DateTime                           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                           @updatedAt @map("updated_at") @db.Timestamptz

  sportLeagues SportLeague[]
  sportEvents  SportEvent[]
  sources      PlatformTierProfileSource[]
  ranges       PlatformTierProfileRange[]

  @@map("platform_tier_profiles")
}

/// One value a tier profile orders the field by (#2160), at its place in the profile's list: the
/// first every participant has orders the field, and the later ones break ties.
model PlatformTierProfileSource {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformTierProfileId String                @map("platform_tier_profile_id") @db.Uuid
  /// The source's place in the list, from 0.
  orderIndex            Int                   @map("order_index")
  basis                 PrismaFieldOrderBasis

  platformTierProfile PlatformTierProfile @relation(fields: [platformTierProfileId], references: [id], onDelete: Cascade)

  @@unique([platformTierProfileId, orderIndex], map: "platform_tier_profile_sources_order_key")
  @@unique([platformTierProfileId, basis], map: "platform_tier_profile_sources_basis_key")
  @@map("platform_tier_profile_sources")
}

/// One tier of a RANGES tier profile (#2160): the seeds or ranks, in its first source's values,
/// the tier takes.
model PlatformTierProfileRange {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformTierProfileId String @map("platform_tier_profile_id") @db.Uuid
  tierNumber            Int    @map("tier_number")
  fromValue             Int    @map("from_value")
  /// Null: everyone from `fromValue` on, which only the last tier may be.
  toValue               Int?   @map("to_value")

  platformTierProfile PlatformTierProfile @relation(fields: [platformTierProfileId], references: [id], onDelete: Cascade)

  @@unique([platformTierProfileId, tierNumber])
  @@map("platform_tier_profile_ranges")
}

/// A set of budget pricing values (#93), defined once for the platform (#1844): each sport league
/// names one, which prices its events' fields after a sync. Replaced the Budget pricing app
/// settings list.
model PlatformPricingProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The profile's key (#2000): migrations, seed scripts and test data find a profile by it, never
  /// by its name. Upper case letters, digits and underscores; set when the profile is made.
  code              String   @unique @db.VarChar(50)
  /// The root admin's name for the profile. Screens read the display strings keyed by `code`
  /// (`pricingProfile.<CODE>.name`) and fall back to it only until a change seeds them (#2194).
  name              String   @unique @db.VarChar(50)
  /// Plain English for agents and root admins: what the profile is and why it exists. Not
  /// translated and not shown to commissioners or members (#2194).
  description       String   @db.VarChar(500)
  /// Whole dollars: the cap prices are a share of.
  salaryCap         Int      @map("salary_cap")
  /// Whole dollars: every price is rounded to a multiple of it.
  unit              Int
  topSharePercent   Float    @map("top_share_percent")
  floorSharePercent Float    @map("floor_share_percent")
  steepness         Float
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportLeagues SportLeague[]
  sportEvents  SportEvent[]
  sources      PlatformPricingProfileSource[]

  @@map("platform_pricing_profiles")
}

/// One value a pricing profile orders the field by before pricing it (#2160), at its place in the
/// profile's list: the first every participant has orders the field, and the later ones break ties.
model PlatformPricingProfileSource {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformPricingProfileId String                @map("platform_pricing_profile_id") @db.Uuid
  /// The source's place in the list, from 0.
  orderIndex               Int                   @map("order_index")
  basis                    PrismaFieldOrderBasis

  platformPricingProfile PlatformPricingProfile @relation(fields: [platformPricingProfileId], references: [id], onDelete: Cascade)

  @@unique([platformPricingProfileId, orderIndex], map: "platform_pricing_profile_sources_order_key")
  @@unique([platformPricingProfileId, basis], map: "platform_pricing_profile_sources_basis_key")
  @@map("platform_pricing_profile_sources")
}

/// Which participants are currently affiliated with which sport league, plus
/// their current ranking there. Sport-league-scoped, not season-scoped — a
/// competitor's membership and ranking don't reset every year. Current value
/// only, no history. See plans/124 §4.2.
/// A competitor of one sport league (#1853): the provider's ids are per league, so the same
/// person or club in two leagues (a star in the LCS and the World Series) is two participants.
/// The sport is the league's.
model Participant {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId   String                @map("sport_league_id") @db.Uuid
  /// The competitor's current rank in their sport league (1 is best).
  ranking         Int?
  name            String
  participantType PrismaParticipantType @map("participant_type")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  // Enriched profile fields (Plan 05)
  firstName        String?                 @map("first_name")
  lastName         String?                 @map("last_name")
  shortName        String?                 @map("short_name") @db.VarChar(100)
  nationality      String?                 @db.VarChar(10)
  /// Playing role ("GOLFER", "QB"), not a rank — `position` means rank on the standing tables.
  role             String?                 @db.VarChar(50)
  teamAffiliation  String?                 @map("team_affiliation")
  status           PrismaParticipantStatus @default(ACTIVE)
  injuryStatus     Json                    @default("{\"status\": \"HEALTHY\"}") @map("injury_status")
  photoUrl         String?                 @map("photo_url")
  photoLastUpdated DateTime?               @map("photo_last_updated") @db.Timestamptz
  /// A test participant (QA only, #2096), marked as test slots are: made for a test slot's field,
  /// the one participant a provider-synced league takes without a feed id. It joins only a test
  /// slot's field, never gets a provider mapping, and no roster or sync reads it.
  isTestData       Boolean                 @default(false) @map("is_test_data")

  sportLeague            SportLeague                  @relation(fields: [sportLeagueId], references: [id])
  providerMappings       ParticipantProviderMapping[]
  sportEventParticipants SportEventParticipant[]
  championOf             SportLeagueSeasonCompetition[]

  @@index([sportLeagueId, status])
  /// A sport league's participants by name: the catalog list's filter and order.
  @@index([sportLeagueId, name])
  /// A sport league's roster in rank order.
  @@index([sportLeagueId, ranking])
  /// Trigram indexes serve the participant search across sports, a substring match on each column (#1180).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "participants_name_trgm_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "participants_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "participants_last_name_trgm_idx")
  @@index([shortName(ops: raw("gin_trgm_ops"))], type: Gin, map: "participants_short_name_trgm_idx")
  @@index([teamAffiliation(ops: raw("gin_trgm_ops"))], type: Gin, map: "participants_team_affiliation_trgm_idx")
  @@map("participants")
}

/// A provider's id for a participant (#2040): the only place a participant's feed id is kept. The
/// id is the provider's raw id, never prefixed: it is unique per provider, sport league and kind of
/// participant, so a team and a player the feed numbers alike cannot collide.
model ParticipantProviderMapping {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId   String                @map("participant_id") @db.Uuid
  /// The participant's sport league (#1853): one feed id names one competitor per league, so
  /// the same feed player maps to the LCS star and the World Series star.
  sportLeagueId   String                @map("sport_league_id") @db.Uuid
  /// The participant's kind, kept with the id so a team and a player never share one.
  participantType PrismaParticipantType @map("participant_type")
  providerId      String                @map("provider_id") @db.Uuid
  externalId      String                @map("external_id") @db.VarChar(255)
  mappedAt        DateTime              @default(now()) @map("mapped_at") @db.Timestamptz
  /// When a sync last saw the participant in its provider's feed (#1865): touched for a whole
  /// field at once by each field sync that lists it. Null until a sync sees it.
  lastSeenAt      DateTime?             @map("last_seen_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  participant Participant @relation(fields: [participantId], references: [id])
  sportLeague SportLeague @relation(fields: [sportLeagueId], references: [id])
  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, externalId, sportLeagueId, participantType])
  /// One provider's feed ids in one sport league: the test data load's read, and the sync's within an event's league.
  @@index([sportLeagueId, providerId])
  /// A feed id in one sport league at any provider: a ranking upload's row that names a feed id
  /// (`findMatchingAny`, #2040). The candidates' own feed ids are read by participant id.
  @@index([sportLeagueId, externalId])
  @@index([participantId])
  @@map("participant_provider_mappings")
}

// =============================================================================
// Contest
// =============================================================================

model Contest {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId       String              @map("league_id") @db.Uuid
  name           String
  status         PrismaContestStatus @default(DRAFT)
  contestFormat  PrismaContestFormat @default(ROSTER) @map("contest_format")
  selectionType  PrismaSelectionType @map("selection_type")
  /// When the commissioner opened the contest to the league (#845); null for a draft, and for contests opened before it was kept.
  openedAt       DateTime?           @map("opened_at") @db.Timestamptz
  startsAt       DateTime?           @map("starts_at") @db.Timestamptz
  endsAt         DateTime?           @map("ends_at") @db.Timestamptz
  /// When the entry reminder sweep next looks at the contest (#1170): its next reminder's moment,
  /// the end of the quiet hours after it opened, or once its events or their times change. Null
  /// when no reminder is left; the sweep reads only contests whose moment has come.
  nextReminderAt DateTime?           @map("next_reminder_at") @db.Timestamptz
  /// The season whose cup the contest counts toward (#841): its first event's year at creation.
  seasonYear     Int                 @map("season_year")
  /// How much it counts toward its cup and the championship (#841); fixed once COMPLETED.
  cupWeight      PrismaCupWeight     @default(NORMAL) @map("cup_weight")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  league               League                       @relation(fields: [leagueId], references: [id])
  sportEvents          ContestSportEvent[]
  configuration        ContestConfiguration?
  entries              ContestEntry[]
  entryStandings       ContestEntryStanding[]
  entryEventStandings  ContestEntryEventStanding[]
  draw                 ContestDraw?
  squaresGame          ContestSquaresGame?
  squares              ContestEntrySquare[]
  squaresDraw          ContestSquaresDraw?
  squaresWinners       ContestSquaresWinner[]
  emailMessages        EmailMessage[]
  yearFinishes         LeagueYearFinish[]
  expansions           ContestExpansion[]
  payments             LeaguePayment[]
  leaderboardSnapshots ContestLeaderboardSnapshot[]

  @@index([leagueId, seasonYear])
  @@index([status])
  @@index([nextReminderAt])
  @@map("contests")
}

/// One sports league's season-long points race in a league (#841): "2026 PGA Tour Cup". Made when
/// the league's first contest of that season and sports league is created, and never deleted. Which
/// contests count is worked out on read: the league's contests of the season and sports league,
/// not NOT_COUNTED. Its name is built from the season and the sports league; there is no column.
model Cup {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId            String                @map("league_id") @db.Uuid
  seasonYear          Int                   @map("season_year")
  sportLeagueId       String                @map("sport_league_id") @db.Uuid
  status              PrismaCupStatus       @default(OPEN)
  /// Set with CROWNED (database check), like the points table frozen with it.
  crownedAt           DateTime?             @map("crowned_at") @db.Timestamptz
  crownedPointsScale  PrismaCupPointsScale? @map("crowned_points_scale")
  crownedCustomPoints Int[]                 @default([]) @map("crowned_custom_points")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz

  // A cup is the league's, so it goes with the league; nothing else deletes one.
  league      League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  sportLeague SportLeague   @relation(fields: [sportLeagueId], references: [id], onDelete: Cascade)
  standings   CupStanding[]

  @@unique([leagueId, seasonYear, sportLeagueId])
  @@index([sportLeagueId])
  @@map("cups")
}

/// One squad's frozen place in a crowned cup (#841), written once at crowning.
model CupStanding {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cupId           String           @map("cup_id") @db.Uuid
  squadId         String           @map("squad_id") @db.Uuid
  position        Int
  /// "T2" for a shared 2nd.
  displayPosition String           @map("display_position")
  /// Tenths of a point.
  points          Int
  wins            Int
  podiums         Int
  contestsCounted Int              @map("contests_counted")
  trophy          PrismaCupTrophy?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  // The squad delete guard keeps a squad with results; the cascades let a league go whole.
  cup   Cup   @relation(fields: [cupId], references: [id], onDelete: Cascade)
  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([cupId, squadId])
  @@index([squadId])
  @@map("cup_standings")
}

/// One squad's finish in one settled contest, for the league championship (#863): written once,
/// when the contest goes final, from its best entry's frozen place and the league's points table
/// at that moment, so a later table or weight change never shifts a past year. A contest counts in
/// the calendar year it went final, in US Eastern.
model LeagueYearFinish {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId         String          @map("league_id") @db.Uuid
  year             Int
  squadId          String          @map("squad_id") @db.Uuid
  contestId        String          @map("contest_id") @db.Uuid
  /// The squad's best entry's place, 1 best.
  place            Int
  /// Entries sharing the place, the squad's own included, for the point split.
  tiedCount        Int             @map("tied_count")
  /// Entries ranked in the contest.
  rankedEntryCount Int             @map("ranked_entry_count")
  weight           PrismaCupWeight
  /// Tenths of a point, from the points table and weight at settlement.
  points           Int
  settledAt        DateTime        @map("settled_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // The squad delete guard keeps a squad with results; the cascades let a league go whole.
  league  League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  squad   Squad   @relation(fields: [squadId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, squadId])
  @@index([leagueId, year])
  @@index([squadId])
  @@map("league_year_finishes")
}

/// A league's year in review (#872): its commissioner sent every squad its year's email. One per
/// league and year; the unique key is what stops two presses sending twice, and its existence
/// clears the "ready to send" banner.
model LeagueYearReview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId     String   @map("league_id") @db.Uuid
  year         Int
  sentByUserId String?  @map("sent_by_user_id") @db.Uuid
  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  sentBy User?  @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([leagueId, year])
  @@index([sentByUserId])
  @@map("league_year_reviews")
}

// One event a contest covers (#713). Every contest has at least one: a golf or race contest has
// one row, a majors pool or a pick'em season one per event. `sequence` is the events' order by
// start, which the server keeps when the commissioner adds or removes events.
model ContestSportEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId    String   @map("contest_id") @db.Uuid
  sportEventId String   @map("sport_event_id") @db.Uuid
  sequence     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  contest    Contest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  sportEvent SportEvent @relation(fields: [sportEventId], references: [id])

  @@unique([contestId, sportEventId])
  @@unique([contestId, sequence])
  @@index([sportEventId])
  @@map("contest_sport_events")
}

model ContestConfiguration {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId            String              @unique @map("contest_id") @db.Uuid
  templateId           String?             @map("template_id") @db.Uuid
  templateVersion      Int?                @map("template_version")
  selectionType        PrismaSelectionType @map("selection_type")
  configJson           Json?               @map("config_json")
  minimumEntries       Int?                @map("minimum_entries")
  maxEntriesPerSquad   Int?                @map("max_entries_per_squad")
  totalPrizePoolAmount Float?              @map("total_prize_pool_amount")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  contest                 Contest                         @relation(fields: [contestId], references: [id])
  template                ContestConfigTemplate?          @relation(fields: [templateId], references: [id])
  participantScoringRules ParticipantContestScoringRule[]

  @@index([templateId])
  @@map("contest_configurations")
}

model ContestConfigTemplate {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The sport league whose events this template is offered for. Every setup belongs to one
  /// league (#1825): golf's PGA TOUR and LPGA Tour each have their own copy of the same setups,
  /// seeded by migration, so a league's setups can change without touching another's.
  sportLeagueId String                     @map("sport_league_id") @db.Uuid
  contestFormat PrismaContestFormat        @map("contest_type")
  /// A `SelectionType` value: how an entry in a contest created from this template picks.
  selectionType PrismaSelectionType        @map("selection_type")
  templateKey   String                     @map("template_key") @db.VarChar(100)
  name          String                     @db.VarChar(120)
  description   String                     @db.VarChar(500)
  sortOrder     Int                        @map("sort_order")
  isDefault     Boolean                    @default(false) @map("is_default")
  active        Boolean                    @default(true)
  configJson    Json                       @map("config_json")
  schemaVersion Int                        @default(1) @map("schema_version")
  /// How a contest made from the template covers its slot definitions (#2010).
  coverageMode  PrismaTemplateCoverageMode @map("coverage_mode")
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague     SportLeague                 @relation(fields: [sportLeagueId], references: [id], onDelete: Restrict)
  configurations  ContestConfiguration[]
  eventPageOffers EventPageOffer[]
  slots           ContestConfigTemplateSlot[]

  /// Two leagues' copies of one setup share its template key; a league has each key once. One
  /// default per (sport league, selection type) is a partial unique index the migration adds,
  /// which Prisma cannot declare.
  @@unique([sportLeagueId, templateKey])
  /// The target of a template slot's composite key, which keeps the slot in the template's league.
  @@unique([sportLeagueId, id])
  @@map("contest_config_templates")
}

/// One slot definition a contest template covers (#2010, plan §7): the template's coverage mode
/// says how a contest takes them. The composite keys keep the definition in the template's own
/// sport league, and a definition is listed once per template. A definition with a template
/// pointing at it cannot be deleted.
model ContestConfigTemplateSlot {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId          String   @map("sport_league_id") @db.Uuid
  templateId             String   @map("template_id") @db.Uuid
  sportLeagueCompetitionSlotId String   @map("sport_league_competition_slot_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  template   ContestConfigTemplate @relation(fields: [sportLeagueId, templateId], references: [sportLeagueId, id], onDelete: Cascade, map: "contest_config_template_slots_template_fkey")
  definition SportLeagueCompetitionSlot  @relation(fields: [sportLeagueId, sportLeagueCompetitionSlotId], references: [sportLeagueId, id], onDelete: Restrict, map: "contest_config_template_slots_definition_fkey")

  @@unique([templateId, sportLeagueCompetitionSlotId])
  @@index([sportLeagueId, sportLeagueCompetitionSlotId])
  @@map("contest_config_template_slots")
}

/// A public event page (#1007, `plans/event-landing-pages.md`): one event a fan would name,
/// "Championship Weekend", at /play/<sport>/<slug>. A curated grouping, not a series: its offers
/// name the contest setups it starts, each on its own sport league's series. Reference data,
/// seeded by migrations like contest templates, so every environment has the same pages.
model EventPage {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sport            PrismaSport
  /// The page's URL name within its sport: lower case letters and digits in words joined by
  /// single dashes (`isUrlSegment`, checked by the table too). Stored, never derived, and
  /// evergreen: it names the page, not a year.
  urlSegment       String      @map("url_segment") @db.VarChar(100)
  /// Where the page sits among its sport's pages wherever they are listed together (How to
  /// Play's Coming up row). Lower comes first.
  displayOrder     Int         @map("display_order")
  /// False retires the page: its URL redirects to `redirectToPageId`, or says it has moved.
  isActive         Boolean     @default(true) @map("is_active")
  /// The page a retired page's URL now goes to; null when it has no successor.
  redirectToPageId String?     @map("redirect_to_page_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  /// The page's sport row (#2042), for its URL segment and display order.
  sportConfig  Sport            @relation(fields: [sport], references: [sport], onDelete: Restrict)
  redirectTo   EventPage?       @relation("EventPageRedirect", fields: [redirectToPageId], references: [id], onDelete: Restrict)
  redirectedBy EventPage[]      @relation("EventPageRedirect")
  offers       EventPageOffer[]

  @@unique([sport, urlSegment])
  @@index([redirectToPageId])
  @@map("event_pages")
}

/// One way to play on an event page (#1007): a contest setup on one sport league's series. The
/// page shows it with the series' next edition, the one under way or else the soonest upcoming.
model EventPageOffer {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventPageId            String   @map("event_page_id") @db.Uuid
  sportLeagueId          String   @map("sport_league_id") @db.Uuid
  /// The slot definition whose next Season slot the offer is shown with (#2010): its owning
  /// event is the offer's edition. One of the offer's sport league's definitions.
  sportLeagueCompetitionSlotId String   @map("sport_league_competition_slot_id") @db.Uuid
  /// The contest setup the offer starts as (a template key alone is not unique).
  templateId             String   @map("template_id") @db.Uuid
  /// Where the offer sits on its page, first first.
  sortOrder              Int      @map("sort_order")
  /// The offer whose edition heads the page: its dates are the page's. One per page at most (a
  /// partial unique index the migration adds, which Prisma cannot declare).
  isPrimary              Boolean  @default(false) @map("is_primary")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  eventPage   EventPage             @relation(fields: [eventPageId], references: [id], onDelete: Cascade)
  sportLeague SportLeague           @relation(fields: [sportLeagueId], references: [id], onDelete: Restrict)
  template    ContestConfigTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// The composite key keeps the definition one of the offer's own sport league's.
  definition  SportLeagueCompetitionSlot  @relation(fields: [sportLeagueId, sportLeagueCompetitionSlotId], references: [sportLeagueId, id], onDelete: Restrict, map: "event_page_offers_definition_fkey")

  @@unique([eventPageId, sortOrder])
  @@index([sportLeagueId, sportLeagueCompetitionSlotId])
  @@index([templateId])
  @@map("event_page_offers")
}

model ParticipantContestScoringRule {
  id                             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestConfigurationId         String   @map("contest_configuration_id") @db.Uuid
  participantScoringDefinitionId String   @map("participant_scoring_definition_id") @db.VarChar(100)
  sortOrder                      Int      @map("sort_order")
  config                         Json     @default("{}")
  active                         Boolean  @default(true)
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contestConfiguration ContestConfiguration @relation(fields: [contestConfigurationId], references: [id])

  @@unique([contestConfigurationId, sortOrder])
  @@map("participant_contest_scoring_rules")
}

// =============================================================================
// Entry & Picks
// =============================================================================

model ContestEntry {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId                  String   @map("contest_id") @db.Uuid
  squadId                    String   @map("squad_id") @db.Uuid
  entryNumber                Int      @default(1) @map("entry_number")
  name                       String
  tiebreakerValue            Int?     @map("tiebreaker_value")
  /// The entry's place in the last live standings email of its contest (#877), which the next
  /// one's movement is measured from. Null until a standings email has gone out.
  lastStandingsEmailPosition Int?     @map("last_standings_email_position")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contest Contest @relation(fields: [contestId], references: [id])
  squad   Squad   @relation(fields: [squadId], references: [id])

  picks          ContestEntryPick[]
  events         ContestEntryEvent[]
  predictions    ContestEntryMatchPrediction[]
  standing       ContestEntryStanding?
  eventStandings ContestEntryEventStanding[]
  squares        ContestEntrySquare[]
  squaresWon     ContestSquaresWinner[]
  emailMessages  EmailMessage[]

  @@unique([contestId, squadId, entryNumber])
  // The key a claimed box's (contest, entry) foreign key names, so a box's entry is its contest's.
  @@unique([id, contestId])
  @@index([squadId])
  @@map("contest_entries")
}

// An entry's draft/submitted status for one event of its contest (#713, design Q5.4): "submit
// week 6", "submit your Masters picks". One row per event of the contest, created with the entry
// and when an event is added; only an event the entry submitted counts.
model ContestEntryEvent {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestEntryId  String                   @map("contest_entry_id") @db.Uuid
  sportEventId    String                   @map("sport_event_id") @db.Uuid
  status          PrismaContestEntryStatus @default(DRAFT)
  submittedAt     DateTime?                @map("submitted_at") @db.Timestamptz
  /// A prediction contest's tiebreaker for the event (#717): the guessed total points of its
  /// tiebreaker game (a pick'em week's last game, a bracket's final).
  tiebreakerValue Int?                     @map("tiebreaker_value")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  contestEntry ContestEntry @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  sportEvent   SportEvent   @relation(fields: [sportEventId], references: [id])

  @@unique([contestEntryId, sportEventId])
  @@index([sportEventId])
  @@map("contest_entry_events")
}

/// A prediction contest entry's pick of one game (#716): the team it says wins, or a tie (#792),
/// and in a confidence pool how sure it is (1 to the week's number of games, each once by
/// submit). One per entry per game. Database checks: `confidence` is at least 1, and the team is
/// named exactly when `predictedResult` is TEAM. That the team plays in the game, that the pool
/// takes a tie, and that the game is still open are the prediction service's checks.
model ContestEntryMatchPrediction {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestEntryId          String                @map("contest_entry_id") @db.Uuid
  sportEventRoundMatchId  String                @map("sport_event_round_match_id") @db.Uuid
  predictedResult         PrismaPredictedResult @default(TEAM) @map("predicted_result")
  /// The team picked to win; null for a tie pick. In a bracket a later game's side means "the
  /// winner of the game before", which can win while the team picked is out, so the team is kept
  /// with its side.
  sportEventParticipantId String?               @map("sport_event_participant_id") @db.Uuid
  /// The match side picked to win (#2046); null for a tie pick, and only then (database check).
  /// Tie picks go in #2016, which makes it required.
  sportEventRoundMatchSideId String?            @map("sport_event_round_match_side_id") @db.Uuid
  confidence              Int?
  pickedAt                DateTime              @map("picked_at") @db.Timestamptz
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  contestEntry          ContestEntry           @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  sportEventRoundMatch  SportEventRoundMatch   @relation(fields: [sportEventRoundMatchId], references: [id], onDelete: Restrict)
  sportEventParticipant SportEventParticipant? @relation(fields: [sportEventParticipantId], references: [id], onDelete: Restrict)
  /// The composite key keeps the side one of the predicted match's own (#2046).
  side                  SportEventRoundMatchSide? @relation(fields: [sportEventRoundMatchId, sportEventRoundMatchSideId], references: [sportEventRoundMatchId, id], onDelete: Restrict, map: "contest_entry_match_predictions_side_fkey")

  @@unique([contestEntryId, sportEventRoundMatchId])
  @@index([sportEventRoundMatchId, sportEventRoundMatchSideId])
  @@index([sportEventParticipantId])
  @@map("contest_entry_match_predictions")
}

/// A contest entry's standing, frozen when its contest settles — cross-sport.
///
/// Written once per entry by settlement when the linked SportEvent completes, and read by
/// the leaderboard of a COMPLETED contest instead of recomputing from live event scores:
/// a provider correction after settlement must not silently rewrite a finished result.
/// `position` is direction-free (1 is best), as on SportEventParticipantStanding. `totalScore`
/// is the entry's settled total that position was ranked from, in the unit of the contest's
/// scoring definition (golf's to-par total, a race's points); null while unscored. Every scoring
/// family stores it here, so no family keeps a settled-total table of its own (#695).
///
/// `countingPickLimit` is the rule's N captured at settlement (best N picks count).
/// Configuration stays editable after a contest is reopened, so without it a frozen result
/// could not be explained. `contestId` is a documented denormalization of
/// `contestEntry.contestId`: the leaderboard read is per contest and this table's primary
/// access path, so it gets a covering index instead of a join. Settlement's upsert is its
/// single writer.
model ContestEntryStanding {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId         String    @map("contest_id") @db.Uuid
  contestEntryId    String    @unique @map("contest_entry_id") @db.Uuid
  position          Int?
  displayPosition   String?   @map("display_position") @db.VarChar(20)
  countingPickLimit Int       @map("counting_pick_limit")
  scoredPickCount   Int       @map("scored_pick_count")
  totalScore        Int?      @map("total_score")
  asOf              DateTime? @map("as_of") @db.Timestamptz
  settledAt         DateTime  @map("settled_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)

  @@index([contestId, position])
  @@map("contest_entry_standings")
}

// An entry's settled result in one event of its contest (#713): the weekly winner in pick'em,
// one major's result in a majors pool. The contest total stays on ContestEntryStanding; the
// columns mirror it, narrowed to the event. Written only by settlement, when the event completes.
model ContestEntryEventStanding {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId         String    @map("contest_id") @db.Uuid
  contestEntryId    String    @map("contest_entry_id") @db.Uuid
  sportEventId      String    @map("sport_event_id") @db.Uuid
  position          Int?
  displayPosition   String?   @map("display_position") @db.VarChar(20)
  countingPickLimit Int       @map("counting_pick_limit")
  scoredPickCount   Int       @map("scored_pick_count")
  totalScore        Int?      @map("total_score")
  asOf              DateTime? @map("as_of") @db.Timestamptz
  settledAt         DateTime  @map("settled_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  sportEvent   SportEvent   @relation(fields: [sportEventId], references: [id])

  @@unique([contestEntryId, sportEventId])
  @@index([contestId, sportEventId, position])
  @@index([sportEventId])
  @@map("contest_entry_event_standings")
}

/// A contest's leaderboard as last computed (#1435), one row per contest and shown event,
/// overwritten in place. Rebuilt a few seconds after a write changes what it is computed from
/// (a score save, a sync, a settlement), so every viewer's poll is one read of this row instead of
/// a computation from every entry, pick and field row. No history is kept: the row goes with its
/// contest.
model ContestLeaderboardSnapshot {
  contestId        String    @map("contest_id") @db.Uuid
  /// The event whose picks it shows: that event's id, or '' for the board a viewer gets when
  /// naming none (the latest event whose picks are revealed).
  shownEvent       String    @map("shown_event") @db.VarChar(36)
  /// Goes up by one on every write: what a poll's ETag is built from (#1436).
  version          Int       @default(1)
  /// The board format it was written under (#1761): one older than the code's
  /// `LEADERBOARD_BOARD_FORMAT` is never served, but computed again. 0 is a row written by a task
  /// still running code from before formats were counted, during the deploy that adds this.
  boardFormat      Int       @default(0) @map("board_format")
  /// When the rebuild that wrote it began reading. A rebuild that began earlier never overwrites
  /// it, so a slow rebuild of older scores cannot replace a newer board.
  computedFrom     DateTime  @map("computed_from") @db.Timestamptz
  /// The contest's own `updatedAt` it was computed under: a contest changed since (its status,
  /// its name) is computed again on the next read.
  contestUpdatedAt DateTime  @map("contest_updated_at") @db.Timestamptz
  /// When the next of the contest's events not yet revealed in it starts, after which the board
  /// must be computed again to show it; null when every event is revealed.
  validUntil       DateTime? @map("valid_until") @db.Timestamptz
  /// The board as the API answers it.
  board            Json      @db.JsonB
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@id([contestId, shownEvent])
  @@map("contest_leaderboard_snapshots")
}

/// A random-draw contest's draw (#601): the commissioner's one explicit "Run draw", which dealt
/// every entry its picks. Its existence closes the contest's entries and reveals its picks.
///
/// Kept so the draw can be shown and replayed: the seed, and the orders the seeded shuffle put
/// the field (`sport_event_participants` ids) and the entries in. Dealing round-robin from
/// those two orders reproduces every pick. One per contest; the unique key is what stops two
/// presses racing from dealing twice.
model ContestDraw {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId                   String   @unique @map("contest_id") @db.Uuid
  seed                        String   @db.VarChar(64)
  fieldOrder                  String[] @map("field_order") @db.Uuid
  entryOrder                  String[] @map("entry_order") @db.Uuid
  drawnByUserId               String?  @map("drawn_by_user_id") @db.Uuid
  drawnAt                     DateTime @default(now()) @map("drawn_at") @db.Timestamptz
  /// The event whose dealt picks the entries' sweepstakes receipts are still to list (#1171): the
  /// draw sets it, and the next lifecycle sweep sends them and clears it. Null once sent.
  receiptsPendingSportEventId String?  @map("receipts_pending_sport_event_id") @db.Uuid

  contest                   Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  drawnBy                   User?       @relation(fields: [drawnByUserId], references: [id], onDelete: SetNull)
  receiptsPendingSportEvent SportEvent? @relation("ContestDrawReceiptsPending", fields: [receiptsPendingSportEventId], references: [id], onDelete: SetNull)

  @@index([drawnByUserId])
  @@index([receiptsPendingSportEventId])
  @@map("contest_draws")
}

/// The one game a squares contest is played on (#711): one of the contest's event's matches,
/// chosen at setup and changeable while the contest is a draft. Its kickoff closes the contest.
model ContestSquaresGame {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId              String   @unique @map("contest_id") @db.Uuid
  sportEventRoundMatchId String   @map("sport_event_round_match_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contest              Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  sportEventRoundMatch SportEventRoundMatch @relation(fields: [sportEventRoundMatchId], references: [id], onDelete: Restrict)

  @@index([sportEventRoundMatchId])
  @@map("contest_squares_games")
}

/// One claimed box of a squares grid (#711): a grid position, not a digit, so a box can be
/// claimed before the digits are drawn. Only claimed boxes have a row; the reader draws the other
/// boxes of the 10x10 grid empty. The unique key on (contest, row, column) is what stops two
/// people taking one box at once; `contestId` is the entry's, kept in step by the composite key.
model ContestEntrySquare {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId       String   @map("contest_id") @db.Uuid
  contestEntryId  String   @map("contest_entry_id") @db.Uuid
  rowIndex        Int      @map("row_index")
  columnIndex     Int      @map("column_index")
  claimedByUserId String?  @map("claimed_by_user_id") @db.Uuid
  claimedAt       DateTime @default(now()) @map("claimed_at") @db.Timestamptz

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry @relation(fields: [contestEntryId, contestId], references: [id, contestId], onDelete: Cascade)
  claimedBy    User?        @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@unique([contestId, rowIndex, columnIndex])
  @@index([contestEntryId])
  @@index([claimedByUserId])
  @@map("contest_entry_squares")
}

/// A squares contest's digits (#711): 0 to 9 shuffled once for the rows (the away team) and once
/// for the columns (the home team), replayable from the seed. Its existence closes claiming, as a
/// random draw's closes entries; the unique key stops two presses drawing twice.
model ContestSquaresDraw {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId     String   @unique @map("contest_id") @db.Uuid
  seed          String   @db.VarChar(64)
  rowDigits     Int[]    @map("row_digits")
  columnDigits  Int[]    @map("column_digits")
  drawnByUserId String?  @map("drawn_by_user_id") @db.Uuid
  drawnAt       DateTime @default(now()) @map("drawn_at") @db.Timestamptz

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  drawnBy User?   @relation(fields: [drawnByUserId], references: [id], onDelete: SetNull)

  @@index([drawnByUserId])
  @@map("contest_squares_draws")
}

/// Each scoring moment's winning box, frozen when a squares contest settles (#711, design Q3.7),
/// so a score correction after Final cannot move it. `periodNumber` runs 1 to the game's period
/// count, the last being the final score, overtime included. No entry when nobody held the box.
model ContestSquaresWinner {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId      String   @map("contest_id") @db.Uuid
  periodNumber   Int      @map("period_number")
  homeScore      Int      @map("home_score")
  awayScore      Int      @map("away_score")
  rowIndex       Int      @map("row_index")
  columnIndex    Int      @map("column_index")
  contestEntryId String?  @map("contest_entry_id") @db.Uuid
  settledAt      DateTime @map("settled_at") @db.Timestamptz

  contest      Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry? @relation(fields: [contestEntryId], references: [id], onDelete: SetNull)

  @@unique([contestId, periodNumber])
  @@index([contestEntryId])
  @@map("contest_squares_winners")
}

/// A pick on a contest entry — references a SportEventParticipant.
/// One participant an entry picked: a roster pick, the only kind of contest that picks
/// participants. An entry picks a participant at most once (`uq_pick_entry_participant`, #2042).
model ContestEntryPick {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId                 String   @map("entry_id") @db.Uuid
  sportEventParticipantId String   @map("sport_event_participant_id") @db.Uuid
  tier                    String?  @db.VarChar(50)
  cost                    Decimal? @db.Decimal(12, 2)
  isAutoPicked            Boolean  @default(false) @map("is_auto_picked")
  lineupSlot              Int?     @map("lineup_slot")
  pickSequence            Int?     @map("pick_sequence")
  pickedAt                DateTime @default(now()) @map("picked_at") @db.Timestamptz
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  entry                 ContestEntry          @relation(fields: [entryId], references: [id])
  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])

  @@unique([entryId, sportEventParticipantId], map: "uq_pick_entry_participant")
  @@index([sportEventParticipantId])
  @@map("contest_entry_picks")
}

// =============================================================================
// Results
// =============================================================================

// =============================================================================
// Sports Data Integration (Plan 06)
// =============================================================================

model SportEvent {
  id                         String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                         @db.VarChar(500)
  venue                      String?                        @db.VarChar(500)
  location                   String?                        @db.VarChar(500)
  startDate                  DateTime                       @map("start_date") @db.Timestamptz
  endDate                    DateTime?                      @map("end_date") @db.Timestamptz
  status                     PrismaSportEventStatus         @default(SCHEDULED)
  rounds                     Int?
  // Par for every round of the event (#478), set by an admin. Null derives each
  // round's par from the field's finished rounds (strokes minus to-par). Read
  // only by contest scoring, to turn an unplayed round's 80 strokes into to-par.
  roundsPar                  Int?                           @map("rounds_par")
  // The event's sport league (#2010): its Season is one of this league's, by a composite key.
  sportLeagueId              String                         @map("sport_league_id") @db.Uuid
  // The Season the event is played in (#2003): the synced Season the sync read it from, or the
  // league's current Season for one made by hand. Its championship year is the event's year.
  sportLeagueSeasonId        String                         @map("sport_league_season_id") @db.Uuid
  // Admin escape hatch: false stops the lifecycle scheduler (plans/124 §3.6)
  // from ever touching this event's status, no matter what the recorded
  // round schedule says — a rain delay, a dispute, etc.
  autoLifecycleEnabled       Boolean                        @default(true) @map("auto_lifecycle_enabled")
  // The values the field was last priced with for budget contests (#93), typed by
  // EventPricingConfigSchema. Null until prices are assigned; written with the
  // prices in one transaction and locked with them at release.
  pricingConfig              Json?                          @map("pricing_config")
  // The pricing profile the recorded values started from (#2205): set with them, null until the
  // field is first priced or once that profile is deleted. The values stay either way.
  platformPricingProfileId   String?                        @map("platform_pricing_profile_id") @db.Uuid
  // The tier layout the field was last auto-tiered with (#1844), typed by EventTierConfigSchema:
  // its sport league's tier profile at the time, with any tier size an admin sent instead. Null
  // until the field is first auto-tiered; written with the tiers in one transaction.
  tierConfig                 Json?                          @map("tier_config")
  // The tier profile the recorded layout came from (#2205): set with it, null until the field is
  // first auto-tiered or once that profile is deleted. The layout stays either way.
  platformTierProfileId      String?                        @map("platform_tier_profile_id") @db.Uuid
  // When the event's provider last sent a webhook notification about the event itself (#1499): a
  // golf round's. Null until one arrives. A game's notification is recorded on its Game (#2007).
  lastProviderNotificationAt DateTime?                      @map("last_provider_notification_at") @db.Timestamptz
  // The latest automatic release check (#1847): when the release job last judged the event,
  // whether it released or held it, and the checks that held it. Null and empty until the first
  // check; each check overwrites the one before, and a root admin's release by hand clears it. A
  // check that skips the event is not stored. Check constraints keep the time and outcome
  // together, and a RELEASED check with no failed checks. The Sports page counts the DRAFT
  // events a check HELD.
  autoReleaseCheckedAt       DateTime?                      @map("auto_release_checked_at") @db.Timestamptz
  autoReleaseOutcome         PrismaAutoReleaseCheckOutcome? @map("auto_release_outcome")
  autoReleaseFailedChecks    PrismaReleaseCheckKey[]        @default([]) @map("auto_release_failed_checks")
  // When the event was released for contests (#1865), by a root admin or by the automatic
  // release: written with the DRAFT to SCHEDULED move. Null for a draft, and for an event
  // released before the column existed.
  releasedAt                 DateTime?                      @map("released_at") @db.Timestamptz
  createdAt                  DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                       @updatedAt @map("updated_at") @db.Timestamptz

  contests                   ContestSportEvent[]
  contestEntryEvents         ContestEntryEvent[]
  pendingDrawReceipts        ContestDraw[]               @relation("ContestDrawReceiptsPending")
  contestEntryEventStandings ContestEntryEventStanding[]
  sportEventParticipants     SportEventParticipant[]
  tiers                      SportEventTier[]
  roundSchedule              SportEventRound[]
  matches                    SportEventRoundMatch[]
  syncRuns                   ProviderSyncRun[]
  syncFindings               ProviderSyncFinding[]
  sportLeague                SportLeague                 @relation(fields: [sportLeagueId], references: [id], onDelete: Restrict)
  /// The composite key keeps the event's Season one of its own league's.
  sportLeagueSeason          SportLeagueSeason           @relation(fields: [sportLeagueId, sportLeagueSeasonId], references: [sportLeagueId, id], onDelete: Restrict, map: "sport_events_season_fkey")
  providerMappings           SportEventProviderMapping[]
  slots                      SportEventSlot[]

  /// The target of an event slot's composite key, which keeps its slot in the event's own Season.
  platformPricingProfile     PlatformPricingProfile?        @relation(fields: [platformPricingProfileId], references: [id], onDelete: SetNull)
  platformTierProfile        PlatformTierProfile?           @relation(fields: [platformTierProfileId], references: [id], onDelete: SetNull)
  @@unique([id, sportLeagueSeasonId])
  @@index([sportLeagueId, sportLeagueSeasonId])
  @@index([sportLeagueSeasonId])
  @@index([platformPricingProfileId])
  @@index([platformTierProfileId])
  @@index([startDate, endDate])
  @@index([status])
  /// A trigram index serves the event name search, a substring match (#1301).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "sport_events_name_trgm_idx")
  @@map("sport_events")
}

/// The provider's id for an event (#2004, plan §9d): the sync writes one when it creates the event
/// from its provider's schedule, under the league's provider mapping it read. An event with none is
/// a test event, made by hand on a test slot. A provider's event id names at most one event.
model SportEventProviderMapping {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId                 String   @map("sport_event_id") @db.Uuid
  /// The Provider row whose id this is (a uuid, never the adapter's source id); one per event.
  providerId                   String   @map("provider_id") @db.Uuid
  /// The league's provider mapping the sync read the event under.
  sportLeagueProviderMappingId String   @map("sport_league_provider_mapping_id") @db.Uuid
  /// The provider's own id for the event, as it sends it.
  externalId                   String   @map("external_id") @db.VarChar(255)
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent                 SportEvent                 @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  provider                   Provider                   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  sportLeagueProviderMapping SportLeagueProviderMapping @relation(fields: [sportLeagueProviderMappingId], references: [id], onDelete: Restrict)

  @@unique([providerId, externalId])
  /// An event has one id per provider.
  @@unique([sportEventId, providerId])
  @@index([sportLeagueProviderMappingId])
  @@map("sport_event_provider_mappings")
}

/// One Season slot an event covers (#2004, plan §3): a SINGLE_SLOT event has one, a bracket event
/// one per round. The composite keys keep the slot in the event's own Season, and a slot belongs to
/// at most one event.
model SportEventSlot {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId                 String   @map("sport_event_id") @db.Uuid
  sportLeagueSeasonId          String   @map("sport_league_season_id") @db.Uuid
  sportLeagueSeasonCompetitionSlotId String   @map("sport_league_season_competition_slot_id") @db.Uuid
  /// The slot's tiebreaker game (#2048): the one Game whose combined score every contest covering
  /// the slot guesses. Set by one rule (the latest scheduled start, ties to the lower Game id, an
  /// unscheduled Game after every scheduled one, the later round first) once the slot has a Game,
  /// and chosen again on each schedule change until it starts;
  /// written only by `SlotTiebreakerService`, which keeps it one of the slot's own Games.
  tiebreakerGameId             String?   @unique @map("tiebreaker_game_id") @db.Uuid
  /// When a root admin chose the tiebreaker game by hand; null while the rule chose it. A chosen
  /// game stays until it starts, unless it is cancelled or moved, when the rule chooses again.
  tiebreakerGameChosenAt       DateTime? @map("tiebreaker_game_chosen_at") @db.Timestamptz
  /// The root admin who chose it; null while the rule chose it.
  tiebreakerGameChosenByUserId String?   @map("tiebreaker_game_chosen_by_user_id") @db.Uuid
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz

  sportEvent SportEvent                 @relation(fields: [sportEventId, sportLeagueSeasonId], references: [id, sportLeagueSeasonId], onDelete: Cascade, map: "sport_event_slots_event_fkey")
  seasonSlot SportLeagueSeasonCompetitionSlot @relation(fields: [sportLeagueSeasonId, sportLeagueSeasonCompetitionSlotId], references: [sportLeagueSeasonId, id], onDelete: Restrict, map: "sport_event_slots_season_slot_fkey")
  tiebreakerGame         SportEventRoundMatchGame? @relation("SportEventSlotTiebreakerGame", fields: [tiebreakerGameId], references: [id], onDelete: SetNull)
  tiebreakerGameChosenBy User?                     @relation("SportEventSlotTiebreakerGameChosenBy", fields: [tiebreakerGameChosenByUserId], references: [id], onDelete: SetNull)

  /// A slot belongs to at most one event (slot ids are unique, so the Season adds nothing).
  rounds     SportEventRound[]
  games      SportEventRoundMatchGame[]

  @@unique([sportLeagueSeasonId, sportLeagueSeasonCompetitionSlotId], map: "sport_event_slots_season_slot_key")
  /// The target of a round's composite key, which keeps the round in one of its own event's slots.
  @@unique([sportEventId, id], map: "sport_event_slots_event_id_key")
  @@index([sportEventId, sportLeagueSeasonId], map: "sport_event_slots_event_idx")
  @@index([tiebreakerGameChosenByUserId])
  @@map("sport_event_slots")
}

model SportEventParticipant {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId   String                     @map("sport_event_id") @db.Uuid
  participantId  String                     @map("participant_id") @db.Uuid
  status         SportEventParticipantStatus @default(ACTIVE)
  /// The rank that applied to this participant at this event (1 is best) —
  /// seeded from the provider or the sport-league affiliation, then editable.
  ranking        Int?
  oddsToWin      Decimal?                   @map("odds_to_win") @db.Decimal(10, 2)
  seedNumber     Int?                       @map("seed_number")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent  SportEvent                       @relation(fields: [sportEventId], references: [id])
  participant Participant                      @relation(fields: [participantId], references: [id])
  valuation   SportEventParticipantValuation?
  picks       ContestEntryPick[]
  rounds      SportEventParticipantRound[]
  standing    SportEventParticipantStanding?
  raceResult  SportEventParticipantRaceResult?
  matchSides  SportEventRoundMatchSide[]
  predictions ContestEntryMatchPrediction[]

  @@unique([sportEventId, participantId])
  /// The target of a match side's composite key, which keeps the side's team in its match's event (#2046).
  @@unique([sportEventId, id], map: "sport_event_participants_event_id_key")
  @@index([participantId])
  @@map("sport_event_participants")
}

/// A scheduled sub-period of a SportEvent with its own start/end time — a
/// golf tournament's Round 2, an NFL Week's set of games, a World Cup's
/// match day. Cross-sport by shape; plans/124 populates and uses it only for
/// golf rounds. Genuinely different from SportEventParticipantRound below:
/// this holds the round's own schedule, independent of any participant; that
/// one joins one participant to one round.
model SportEventRound {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId   String    @map("sport_event_id") @db.Uuid
  /// The event slot the round is played in (#2006): the composite key keeps it one of the round's
  /// own event's slots. A golf tournament's four rounds share its one slot; a bracket event has a
  /// round per slot.
  sportEventSlotId String  @map("sport_event_slot_id") @db.Uuid
  roundNumber    Int       @map("round_number")
  scheduledDate  DateTime  @map("scheduled_date") @db.Timestamptz
  scheduledEndAt DateTime? @map("scheduled_end_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent        SportEvent                   @relation(fields: [sportEventId], references: [id])
  eventSlot         SportEventSlot               @relation(fields: [sportEventId, sportEventSlotId], references: [sportEventId, id], onDelete: Restrict, map: "sport_event_rounds_event_slot_fkey")
  participantRounds SportEventParticipantRound[]
  matches           SportEventRoundMatch[]

  @@unique([sportEventId, roundNumber])
  @@map("sport_event_rounds")
}

/// One game or match of an event, played in one of its rounds (#698). Core event data, beside the
/// round schedule. Its two sides are SportEventRoundMatchSide rows (#2046), its games
/// SportEventRoundMatchGame rows with each side's result. In a bracket it is also a slot:
/// `advancesToMatchId`/`advancesToSideNumber` name the next match and the side its winner fills
/// (null for the final). Database check: both or neither. That the next match belongs to the
/// match's own event is the bracket service's check.
model SportEventRoundMatch {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId         String            @map("sport_event_id") @db.Uuid
  sportEventRoundId    String            @map("sport_event_round_id") @db.Uuid
  matchNumber          Int               @map("match_number")
  scheduledDate        DateTime?         @map("scheduled_date") @db.Timestamptz
  /// Rolled up from the match's Games by the result writer (#2046).
  status               PrismaMatchStatus @default(SCHEDULED)
  /// How the match ended (#704): PLAYED unless it stopped early. A walkover has no scores.
  ending               PrismaMatchEnding @default(PLAYED)
  advancesToMatchId    String?           @map("advances_to_match_id") @db.Uuid
  /// The side of the next match the winner fills (#2046): that match's `sideNumber`.
  advancesToSideNumber Int?              @map("advances_to_side_number")
  /// The bracket region or conference the match is in ("East", "AFC"); null where the bracket
  /// has none. A reseeded round pairs the teams of one region (#722).
  regionLabel          String?           @map("region_label") @db.VarChar(40)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent      SportEvent                    @relation(fields: [sportEventId], references: [id])
  sportEventRound SportEventRound               @relation(fields: [sportEventRoundId], references: [id])
  advancesTo      SportEventRoundMatch?         @relation("SportEventRoundMatchAdvancesTo", fields: [advancesToMatchId], references: [id], onDelete: NoAction)
  fedBy           SportEventRoundMatch[]        @relation("SportEventRoundMatchAdvancesTo")
  predictions     ContestEntryMatchPrediction[]
  squaresGames    ContestSquaresGame[]
  games           SportEventRoundMatchGame[]
  sides           SportEventRoundMatchSide[]

  // A match is numbered within its round (#2161): each round has its own match 1.
  @@unique([sportEventRoundId, matchNumber])
  /// The target of a Game's composite key, which keeps the Game in its match's event (#2007).
  @@unique([sportEventId, id], map: "sport_event_round_matches_event_id_key")
  // Two matches cannot feed the same side of the next one.
  @@unique([advancesToMatchId, advancesToSideNumber])
  @@map("sport_event_round_matches")
}

/// One side of a match (#2046): its fixed place (`sideNumber` 1 or 2, set by whoever creates the
/// match) and the field row playing it, empty until the side is known (a later-round slot waiting
/// on its feeder match). The spread is side 1's only (database check): -3.5 has side 1 favoured by
/// 3.5. `outcome` is rolled up from the match's Games, written only by the result writer.
model SportEventRoundMatchSide {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId            String                 @map("sport_event_id") @db.Uuid
  sportEventRoundMatchId  String                 @map("sport_event_round_match_id") @db.Uuid
  sideNumber              Int                    @map("side_number")
  sportEventParticipantId String?                @map("sport_event_participant_id") @db.Uuid
  /// Points spread on side 1; half points at most. A pick'em contest scored against the spread reads it.
  spread                  Decimal?               @db.Decimal(4, 1)
  outcome                 PrismaMatchSideOutcome @default(PENDING)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  /// The composite keys keep the side, and its team, in its match's own event.
  match                 SportEventRoundMatch                 @relation(fields: [sportEventId, sportEventRoundMatchId], references: [sportEventId, id], onDelete: Cascade, map: "sport_event_round_match_sides_match_fkey")
  sportEventParticipant SportEventParticipant?               @relation(fields: [sportEventId, sportEventParticipantId], references: [sportEventId, id], onDelete: Restrict, map: "sport_event_round_match_sides_participant_fkey")
  gameResults           SportEventRoundMatchGameSideResult[]
  predictions           ContestEntryMatchPrediction[]

  @@unique([sportEventRoundMatchId, sideNumber])
  /// A team plays one side of a match.
  @@unique([sportEventRoundMatchId, sportEventParticipantId])
  /// The target of a side result's and a prediction's composite keys.
  @@unique([sportEventRoundMatchId, id], map: "sport_event_round_match_sides_match_id_key")
  @@index([sportEventId, sportEventParticipantId])
  @@map("sport_event_round_match_sides")
}

/// One played game of a Match (#2007): a single game, or one game of a best-of series. Every Match
/// has a Game 1. Each side's score, and where it played, is a SportEventRoundMatchGameSideResult
/// (#2046). Provider game ids live in SportEventRoundMatchGameProviderMapping.
model SportEventRoundMatchGame {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId               String                   @map("sport_event_id") @db.Uuid
  sportEventRoundMatchId     String                   @map("sport_event_round_match_id") @db.Uuid
  /// The event slot the game is played in: its match's round's slot.
  sportEventSlotId           String                   @map("sport_event_slot_id") @db.Uuid
  /// 1 for a single game; a series' games in the order they are played.
  gameNumber                 Int                      @map("game_number")
  scheduledDate              DateTime?                @map("scheduled_date") @db.Timestamptz
  /// Neither side plays at home (#2047): a Super Bowl, a tournament game. Its side results then
  /// say NONE for home or away.
  isNeutralSite              Boolean                  @default(false) @map("is_neutral_site")
  status                     PrismaMatchStatus        @default(SCHEDULED)
  /// When the game was last written COMPLETED; null for any other status. A match's and a
  /// round's completion time are read from their Games.
  completedAt                DateTime?                @map("completed_at") @db.Timestamptz
  /// The Game a provider moved this one to (another week's): set once, never re-parented. This
  /// Game keeps its picks; the provider's id moves to the new Game.
  movedToGameId              String?                  @map("moved_to_game_id") @db.Uuid
  /// When a provider last sent a webhook notification about this game (#1499). Null until one
  /// arrives. The scheduler warns when play is under way and none has arrived for a while.
  lastProviderNotificationAt DateTime?                @map("last_provider_notification_at") @db.Timestamptz
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  match            SportEventRoundMatch                     @relation(fields: [sportEventId, sportEventRoundMatchId], references: [sportEventId, id], onDelete: Cascade, map: "sport_event_round_match_games_match_fkey")
  eventSlot        SportEventSlot                           @relation(fields: [sportEventId, sportEventSlotId], references: [sportEventId, id], onDelete: Restrict, map: "sport_event_round_match_games_event_slot_fkey")
  movedTo          SportEventRoundMatchGame?                @relation("SportEventRoundMatchGameMovedTo", fields: [movedToGameId], references: [id], onDelete: SetNull)
  movedFrom        SportEventRoundMatchGame[]               @relation("SportEventRoundMatchGameMovedTo")
  providerMappings SportEventRoundMatchGameProviderMapping[]
  /// The slot this Game is the tiebreaker game of, if it is (#2048).
  tiebreakerOfSlot SportEventSlot?                           @relation("SportEventSlotTiebreakerGame")
  sideResults      SportEventRoundMatchGameSideResult[]

  @@unique([sportEventRoundMatchId, gameNumber])
  /// The target of a side result's composite key, which keeps the result in its Game's match.
  @@unique([sportEventRoundMatchId, id], map: "sport_event_round_match_games_match_id_key")
  @@index([sportEventId, sportEventSlotId])
  @@index([movedToGameId])
  @@map("sport_event_round_match_games")
}

/// A provider's own id for one Game (#2007). Webhooks and score syncs find a game by it.
model SportEventRoundMatchGameProviderMapping {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventRoundMatchGameId String   @map("sport_event_round_match_game_id") @db.Uuid
  /// The Provider row whose id this is (a uuid, never the adapter's source id).
  providerId                 String   @map("provider_id") @db.Uuid
  /// The provider's own id for the game, as it sends it.
  externalId                 String   @map("external_id") @db.VarChar(255)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  game     SportEventRoundMatchGame @relation(fields: [sportEventRoundMatchGameId], references: [id], onDelete: Cascade)
  provider Provider                 @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, externalId])
  /// A game has one id per provider.
  @@unique([sportEventRoundMatchGameId, providerId])
  @@map("sport_event_round_match_game_provider_mappings")
}

/// One side's result in one Game (#2046): its score (null until the game starts; the final score,
/// overtime included, once it ends) and whether it played at home, away or at a neutral site. The
/// composite keys keep the Game and the side in one match.
model SportEventRoundMatchGameSideResult {
  id                         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventRoundMatchId     String         @map("sport_event_round_match_id") @db.Uuid
  sportEventRoundMatchGameId String         @map("sport_event_round_match_game_id") @db.Uuid
  sportEventRoundMatchSideId String         @map("sport_event_round_match_side_id") @db.Uuid
  score                      Int?
  homeAway                   PrismaHomeAway @default(NONE) @map("home_away")
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  game         SportEventRoundMatchGame                      @relation(fields: [sportEventRoundMatchId, sportEventRoundMatchGameId], references: [sportEventRoundMatchId, id], onDelete: Cascade, map: "sport_event_round_match_game_side_results_game_fkey")
  side         SportEventRoundMatchSide                      @relation(fields: [sportEventRoundMatchId, sportEventRoundMatchSideId], references: [sportEventRoundMatchId, id], onDelete: Cascade, map: "sport_event_round_match_game_side_results_side_fkey")
  periodScores SportEventRoundMatchGameSideResultPeriodScore[]

  @@unique([sportEventRoundMatchGameId, sportEventRoundMatchSideId])
  @@index([sportEventRoundMatchId, sportEventRoundMatchSideId])
  @@map("sport_event_round_match_game_side_results")
}

/// The points one side scored in one period of a Game (#2046): that period's own points, not the
/// running total (a squares pool sums them, #2019). A shoot-out is one SHOOTOUT row, period 1, with
/// the kicks scored; it is never part of the Game's score (IFAB Law 10).
model SportEventRoundMatchGameSideResultPeriodScore {
  id                                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventRoundMatchGameSideResultId String           @map("sport_event_round_match_game_side_result_id") @db.Uuid
  kind                                 PrismaPeriodKind
  periodNumber                         Int              @map("period_number")
  score                                Int
  createdAt                            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                            DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sideResult SportEventRoundMatchGameSideResult @relation(fields: [sportEventRoundMatchGameSideResultId], references: [id], onDelete: Cascade)

  @@unique([sportEventRoundMatchGameSideResultId, kind, periodNumber], map: "sport_event_round_match_game_side_result_period_scores_key")
  @@map("sport_event_round_match_game_side_result_period_scores")
}

/// One participant's part in one round of an event — the (participant, round)
/// join, cross-sport. Its order is the round's `roundNumber`. What was scored
/// in the round lives in the sport's extension row, never here
/// (SportEventParticipantGolfRound for golf). sportEventRoundId replaced a
/// bare `round: Int` (plans/124 §4.10): a round number that doesn't exist for
/// the event fails at insert with a foreign-key violation.
model SportEventParticipantRound {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String                       @map("sport_event_participant_id") @db.Uuid
  sportEventRoundId       String                       @map("sport_event_round_id") @db.Uuid
  /// Provider-normalized progress of this participant's round.
  status                  PrismaParticipantRoundStatus
  completedAt             DateTime?                    @map("completed_at") @db.Timestamptz
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant           @relation(fields: [sportEventParticipantId], references: [id])
  sportEventRound       SportEventRound                 @relation(fields: [sportEventRoundId], references: [id])
  golf                  SportEventParticipantGolfRound?

  @@unique([sportEventParticipantId, sportEventRoundId])
  @@index([sportEventRoundId])
  @@map("sport_event_participant_rounds")
}

/// Golf extension of SportEventParticipantRound: what one golfer scored in one
/// round. Keyed 1:1 to the core round row.
model SportEventParticipantGolfRound {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantRoundId String   @unique @map("participant_round_id") @db.Uuid
  strokes            Int
  scoreToPar         Int      @map("score_to_par")
  thru               Int?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  participantRound SportEventParticipantRound @relation(fields: [participantRoundId], references: [id])

  @@map("sport_event_participant_golf_rounds")
}

/// A participant's running standing in one event, cross-sport.
///
/// `position` is THE cross-sport rank key, and it is direction-free: 1 is best
/// in every sport. The raw score that produced it lives in the sport's
/// extension row (SportEventParticipantGolfStanding for golf), never here. A
/// cross-sport reader ranks on `position` and joins the extension only to
/// display a score — it never needs to know whether a higher or lower score is
/// better. Score direction is consulted at exactly one point: wherever
/// `position` is computed from a raw score.
model SportEventParticipantStanding {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String                    @unique @map("sport_event_participant_id") @db.Uuid
  position                Int?
  displayPosition         String?                   @map("display_position") @db.VarChar(20)
  status                  ParticipantStandingStatus @default(ACTIVE)
  asOf                    DateTime?                 @map("as_of") @db.Timestamptz
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant              @relation(fields: [sportEventParticipantId], references: [id])
  golf                  SportEventParticipantGolfStanding?

  @@map("sport_event_participant_standings")
}

/// Golf extension of SportEventParticipantStanding: the running event totals
/// one golfer's position was ranked from. Keyed 1:1 to the core standing row.
model SportEventParticipantGolfStanding {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standingId       String   @unique @map("standing_id") @db.Uuid
  eventScoreToPar  Int      @map("event_score_to_par")
  eventStrokes     Int      @map("event_strokes")
  currentRoundThru Int?     @map("current_round_thru")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  standing SportEventParticipantStanding @relation(fields: [standingId], references: [id])

  @@map("sport_event_participant_golf_standings")
}

/// Finish-position extension of a field row (#622): how one runner's race ended. Keyed 1:1 to
/// SportEventParticipant, because a race is one result per runner. Written only by the admin's
/// finishing order, which stores every value exactly as sent: `finishPosition` is null until
/// one is entered and for every status but FINISHED (a CHECK constraint holds that), and a
/// result counts in contest scoring only once `isOfficial`. `riderName` is the jockey for this
/// one start; the trainer is the participant's `teamAffiliation`.
model SportEventParticipantRaceResult {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String           @unique @map("sport_event_participant_id") @db.Uuid
  finishPosition          Int?             @map("finish_position")
  startPosition           Int?             @map("start_position")
  resultStatus            RaceResultStatus @map("result_status")
  isOfficial              Boolean          @default(false) @map("is_official")
  riderName               String?          @map("rider_name") @db.VarChar(255)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id], onDelete: Cascade)

  @@map("sport_event_participant_race_results")
}

/// Per-event tier definition, cross-sport. Event-level only — no contest
/// override (plans/124 §4.6). Tier count is however many rows exist for the
/// event, not a separate parameter (§4.5a).
model SportEventTier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId String   @map("sport_event_id") @db.Uuid
  tierKey      String   @map("tier_key") @db.VarChar(50)
  tierNumber   Int      @map("tier_number")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent SportEvent                       @relation(fields: [sportEventId], references: [id])
  valuations SportEventParticipantValuation[]

  @@unique([sportEventId, tierKey])
  @@unique([sportEventId, tierNumber])
  @@map("sport_event_tiers")
}

/// The tier and/or price for one participant in one event, cross-sport — one
/// row per SportEventParticipant, the same 1:1 shape as ranking/oddsToWin/
/// seedNumber living there (plans/124 §4.5/§4.6b).
model SportEventParticipantValuation {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String           @unique @map("sport_event_participant_id") @db.Uuid
  sportEventTierId        String?          @map("sport_event_tier_id") @db.Uuid
  tierOrderIndex          Int?             @map("tier_order_index")
  tierAssignedSource      ValuationSource? @map("tier_assigned_source")
  price                   Decimal?         @db.Decimal(10, 2)
  priceAssignedSource     ValuationSource? @map("price_assigned_source")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])
  sportEventTier        SportEventTier?       @relation(fields: [sportEventTierId], references: [id])

  @@index([sportEventTierId, tierOrderIndex])
  @@map("sport_event_participant_valuations")
}

// =============================================================================
// Providers (#1997)
// =============================================================================

/// Which data provider a Provider row is (#1997): the code picks the adapter in code; nothing
/// else about a provider is in code.
enum PrismaProviderCode {
  BALLDONTLIE
}

/// Which of a provider's webhook events a provider league sends for its games (#1997): a game's
/// start, each period's end and its end; a game's start, its half-time and its end; or a golf
/// tournament's start, each round's start, each player's round and its end. The adapter maps each
/// set to the provider's own event names.
enum PrismaProviderWebhookEventSet {
  GAME_PERIODS
  GAME_HALVES
  GOLF_ROUNDS
}

/// One data provider (#1997, plans/league-model-redesign.md §4), with the settings each
/// environment gives it: QA's free-tier rate and production's paid rate are row values, edited on
/// the Providers page. Seeded by migration. The API key and webhook secret stay in Secrets
/// Manager. Provider and ProviderLeague are the provider's own lists, so they are the stated
/// exception to the rule that provider codes live only in *ProviderMapping tables.
model Provider {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    PrismaProviderCode @unique
  name                    String             @db.VarChar(100)
  baseUrl                 String             @map("base_url") @db.VarChar(500)
  /// The provider plan's request limit a minute, which every sync service holds its calls to.
  requestsPerMinute       Int                @map("requests_per_minute")
  /// Whether the provider's webhook notifications are taken: only while its signing secret is
  /// set too. A notified event's scores are polled only at the safety-net pace below.
  webhooksEnabled         Boolean            @default(false) @map("webhooks_enabled")
  /// How often a notified event's scores are polled anyway while it is in play, in minutes.
  webhookPollMinutes      Int                @map("webhook_poll_minutes")
  /// How often a notified event played in rounds is polled while a round is under way, in
  /// minutes, since the provider does not notify each hole.
  webhookRoundPollMinutes Int                @map("webhook_round_poll_minutes")
  /// Whether its plan includes player box scores.
  hasPlayerStats          Boolean            @default(false) @map("has_player_stats")
  isEnabled               Boolean            @default(true) @map("is_enabled")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  leagues             ProviderLeague[]
  participantMappings ParticipantProviderMapping[]
  syncRuns            ProviderSyncRun[]
  backgroundJobs      BackgroundJob[]
  syncFindings        ProviderSyncFinding[]
  eventMappings       SportEventProviderMapping[]
  gameMappings        SportEventRoundMatchGameProviderMapping[]

  @@map("providers")
}

/// One of a provider's own leagues (#1997): its code for the league (`nfl`), the sport it plays
/// and how its webhooks behave. Seeded by migration with the provider; SportLeagueProviderMapping
/// links a sport league to one.
model ProviderLeague {
  id                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId         String                        @map("provider_id") @db.Uuid
  /// The provider's own code for the league, as its API names it.
  code               String                        @db.VarChar(50)
  /// The provider's own name for the league, shown beside its code.
  name               String                        @db.VarChar(100)
  sportId            String                        @map("sport_id") @db.Uuid
  webhookEventSet    PrismaProviderWebhookEventSet @map("webhook_event_set")
  /// How long a game may go between two of the league's notifications in normal play, in
  /// minutes, with room for overtime and breaks: past it, the webhook may have stopped.
  quietAfterMinutes  Int                           @map("quiet_after_minutes")
  /// How long one of its games usually takes from its scheduled start, in minutes: a start plus
  /// this is when a game with no scheduled end should have ended.
  typicalGameMinutes Int                           @map("typical_game_minutes")
  isEnabled          Boolean                       @default(true) @map("is_enabled")
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                      @updatedAt @map("updated_at") @db.Timestamptz

  provider     Provider                     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  sport        Sport                        @relation(fields: [sportId], references: [id], onDelete: Restrict)
  sportLeagues SportLeagueProviderMapping[]

  @@unique([providerId, code])
  @@index([sportId])
  @@map("provider_leagues")
}

/// Links a sport league to one provider's league (#1997): a league may be mapped to more than
/// one provider, and `SportLeague.selectedProviderMappingId` picks the one its sync reads.
model SportLeagueProviderMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId    String   @map("sport_league_id") @db.Uuid
  providerLeagueId String   @map("provider_league_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague     SportLeague                                 @relation("SportLeagueProviderMappings", fields: [sportLeagueId], references: [id], onDelete: Cascade)
  providerLeague  ProviderLeague                              @relation(fields: [providerLeagueId], references: [id], onDelete: Restrict)
  selectedBy      SportLeague?                                @relation("SelectedSportLeagueProviderMapping")
  positionCodes   SportLeaguePositionProviderMapping[]
  slotMappings    SportLeagueCompetitionSlotProviderMapping[]
  seasonMappings  SportLeagueSeasonProviderMapping[]
  eventMappings   SportEventProviderMapping[]
  seasonSlotLinks SportLeagueSeasonCompetitionSlotProviderMapping[]

  @@unique([sportLeagueId, providerLeagueId])
  /// The target of SportLeague's composite key to its selected mapping.
  @@unique([sportLeagueId, id])
  @@index([providerLeagueId])
  @@map("sport_league_provider_mappings")
}

/// One of a sport league's playing positions (#2001, plans/league-model-redesign.md §1): the NFL's
/// QB or K. Timeless, one set per league, set by migration. Only a field-eligible position's
/// players are kept on a Season's roster; the roster sync drops the rest while reading.
model SportLeaguePosition {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId   String   @map("sport_league_id") @db.Uuid
  /// The position's key within its league, capital letters, digits and underscores: QB. Screens
  /// read its words from the display strings by this code.
  code            String   @db.VarChar(20)
  /// Where the position sits when a league's positions are listed. Display only: never used to
  /// find a position or to order play.
  displayOrder    Int      @map("display_order")
  /// Whether the position's players can be picked into an event's field.
  isFieldEligible Boolean  @map("is_field_eligible")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague   SportLeague                          @relation(fields: [sportLeagueId], references: [id], onDelete: Cascade)
  providerCodes SportLeaguePositionProviderMapping[]

  @@unique([sportLeagueId, code])
  /// The target of the provider code rows' composite key, which keeps a code on its own league.
  @@unique([sportLeagueId, id])
  @@map("sport_league_positions")
}

/// A provider's code for one of a sport league's positions (#2001): BALLDONTLIE's NFL
/// `position_abbreviation` QB. Inclusion only: a code with no row is not one of the league's
/// positions. Several codes may name one position. Set by migration.
model SportLeaguePositionProviderMapping {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId                String   @map("sport_league_id") @db.Uuid
  sportLeaguePositionId        String   @map("sport_league_position_id") @db.Uuid
  sportLeagueProviderMappingId String   @map("sport_league_provider_mapping_id") @db.Uuid
  /// The provider's own code for the position, exactly as its feed sends it.
  providerCode                 String   @map("provider_code") @db.VarChar(50)
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// Both composite keys run through the sport league, so the position and the provider league
  /// mapping are always the same league's.
  position                   SportLeaguePosition        @relation(fields: [sportLeagueId, sportLeaguePositionId], references: [sportLeagueId, id], onDelete: Cascade, map: "sport_league_position_provider_mappings_position_fkey")
  sportLeagueProviderMapping SportLeagueProviderMapping @relation(fields: [sportLeagueId, sportLeagueProviderMappingId], references: [sportLeagueId, id], onDelete: Cascade, map: "sport_league_position_provider_mappings_provider_mapping_fkey")

  @@unique([sportLeagueProviderMappingId, providerCode])
  @@index([sportLeagueId, sportLeaguePositionId])
  @@index([sportLeagueId, sportLeagueProviderMappingId], map: "sport_league_position_provider_mappings_provider_mapping_idx")
  @@map("sport_league_position_provider_mappings")
}

/// The three phases a sport league's Season can have (#2002, plans/league-model-redesign.md §1).
/// The order they are declared in is the phases' only order. Mirrors the domain `LeaguePhase`.
enum PrismaLeaguePhase {
  PRESEASON
  REGULAR
  POSTSEASON_CONFERENCE
  POSTSEASON
}

/// How far a Season's competition or phase has got (#2153): its games not begun, under way, or all
/// final. The refresh handlers that move it belong to slice 14 (#2013). Mirrors the domain
/// `SeasonCompetitionStatus`.
enum PrismaSeasonCompetitionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

/// What a slot definition is within its phase (#2002). The order they are declared in, with a
/// WEEK slot's `weekNumber`, is the slots' order in play; TOURNAMENT slots are ordered by their
/// Season slot's dates, which slice 6 adds. Mirrors the domain `SlotKind`.
enum PrismaSlotKind {
  WEEK
  PLAY_IN
  ROUND_OF_64
  ROUND_OF_32
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  THIRD_PLACE
  FINAL
  TOURNAMENT
}

/// How one meeting of two sides in a slot is decided (#2002): one game, a best-of series, or
/// goals over two legs. Mirrors the domain `SeriesFormat`.
enum PrismaSeriesFormat {
  SINGLE_GAME
  BEST_OF
  AGGREGATE
}

/// How a slot's winners meet in the next slot (#2002): by the bracket's fixed links, or reseeded
/// by seed (the NFL's). Mirrors the domain `SlotPairing`.
enum PrismaSlotPairing {
  FIXED
  RESEEDED
}

/// Where a Season's slot is in play (#2003, plan §2). CANCELLED is set from the feed or by a root
/// admin (slice 14). Mirrors the domain `SeasonSlotStatus`.
enum PrismaSeasonSlotStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// How a provider's games are matched to a slot definition (#2002, plan §1 and §6): the code its
/// adapter reduces a game to, a normalized tournament name, a date window, or the calendar week.
/// Mirrors the domain `SlotProviderMatchType`.
enum PrismaSlotProviderMatchType {
  PROVIDER_CODE
  NAME_PATTERN
  DATE_WINDOW
  CALENDAR_WEEK
}

/// Whether a Season slot's date window is the schedule's published dates or a best guess while
/// the shape is known but the games are not (#2012). Mirrors the domain `SlotWindowStatus`.
enum PrismaSlotWindowStatus {
  TENTATIVE
  CONFIRMED
}

/// How a slot's games are contested (#2043): two sides meeting, or a whole field ranked. Mirrors
/// the domain `MatchFormat`.
enum PrismaMatchFormat {
  HEAD_TO_HEAD
  FIELD
}

/// What a slot's games are played in (#2043); the words come from the display strings. Mirrors the
/// domain `PeriodUnit`.
enum PrismaPeriodUnit {
  QUARTER
  HALF
  PERIOD
  INNING
  HOLE
}

/// One phase of a sport league's Seasons, timeless (#2002): set by migration, one row per phase
/// the league plays. An unsynced phase (the NFL's PRESEASON) has no slots.
model SportLeaguePhase {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId String            @map("sport_league_id") @db.Uuid
  phase         PrismaLeaguePhase
  /// Whether the league's sync reads this phase: false, and the phase gets no slots, events or
  /// findings.
  isSynced      Boolean           @map("is_synced")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague  SportLeague              @relation(fields: [sportLeagueId], references: [id], onDelete: Cascade)
  competitions SportLeagueCompetition[]
  seasonPhases SportLeagueSeasonPhase[]

  @@unique([sportLeagueId, phase])
  /// The target of a competition's composite key, which keeps it in a phase of its own league.
  @@unique([sportLeagueId, id])
  @@map("sport_league_phases")
}

/// One competition of a phase, timeless (#2153): what a phase's slots are played as, set by
/// migration. Most phases hold one (code = the phase); NCAA Men's Football's POSTSEASON holds the
/// CFP, and a POSTSEASON_CONFERENCE phase one tournament per conference. No contest crosses
/// competitions. Database checks: the code is a code, and the order is from 1.
model SportLeagueCompetition {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId      String   @map("sport_league_id") @db.Uuid
  sportLeaguePhaseId String   @map("sport_league_phase_id") @db.Uuid
  /// A readable key unique in the league (REGULAR, CFP), typed into migrations; nothing builds or
  /// parses it.
  code               String   @db.VarChar(64)
  /// Its place among its phase's competitions, from 1.
  orderIndex         Int      @map("order_index")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague        SportLeague                    @relation(fields: [sportLeagueId], references: [id], onDelete: Cascade)
  /// The composite key keeps the competition in a phase of its own league.
  phase              SportLeaguePhase               @relation(fields: [sportLeagueId, sportLeaguePhaseId], references: [sportLeagueId, id], onDelete: Cascade)
  slots              SportLeagueCompetitionSlot[]
  seasonCompetitions SportLeagueSeasonCompetition[]

  @@unique([sportLeagueId, code])
  @@unique([sportLeaguePhaseId, orderIndex])
  /// The target of a slot's composite key, which keeps the slot in its own league's competition.
  @@unique([sportLeagueId, id])
  /// The target of a Season competition's composite key, which keeps it in its competition's phase.
  @@unique([sportLeaguePhaseId, id])
  @@index([sportLeagueId, sportLeaguePhaseId])
  @@map("sport_league_competitions")
}

/// One slot definition in a competition, timeless (#2002, #2153): a week, a knockout round or a recurring
/// tournament, and the strong key that Seasons, events, contest templates and event pages link
/// on. Set by migration. Database checks: the key is a code, `weekNumber` is set exactly for a
/// WEEK slot, and the series length fits its format; a week number, and every kind but WEEK and
/// TOURNAMENT, is used once per competition.
model SportLeagueCompetitionSlot {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId      String             @map("sport_league_id") @db.Uuid
  sportLeagueCompetitionId String       @map("sport_league_competition_id") @db.Uuid
  /// A code unique in the league that nothing parses (WEEK_14, FINAL, MASTERS).
  key                String             @db.VarChar(64)
  slotKind           PrismaSlotKind     @map("slot_kind")
  /// The week's number in its phase, from 1; only on a WEEK slot.
  weekNumber         Int?               @map("week_number")
  /// The league's own proper name for the slot (Super Bowl, Sweet 16, Masters Tournament). Null:
  /// screens show the word for its kind from the display strings.
  name               String?            @db.VarChar(100)
  /// Whether winning the slot wins a trophy.
  awardsTrophy       Boolean            @map("awards_trophy")
  /// Whether a squares pool can be played on the slot's games: single games with period scores.
  squaresEligible    Boolean            @map("squares_eligible")
  /// The series format each Season's slot is copied from (slice 6), so a later format change never
  /// rewrites a past Season.
  seriesFormat       PrismaSeriesFormat @map("series_format")
  /// Games in a meeting: 1 for SINGLE_GAME, an odd 3 or more for BEST_OF, 2 or more legs for
  /// AGGREGATE.
  seriesGames        Int                @map("series_games")
  pairing            PrismaSlotPairing
  /// Two sides meeting, or a whole field ranked (#2043); each Round copies it once events carry slots.
  matchFormat        PrismaMatchFormat  @map("match_format")
  /// Whether a game can finish level (#2043): a soccer league's regular season. A slot that cannot
  /// is decided by overtime or a shoot-out.
  canEndTied         Boolean            @map("can_end_tied")
  /// What a game is played in (#2043). Null, with `periodCount`, for a game kept by no period.
  periodUnit         PrismaPeriodUnit?  @map("period_unit")
  /// How many periods a game has, overtime aside. Database check: set exactly when `periodUnit` is.
  periodCount        Int?               @map("period_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague      SportLeague                           @relation(fields: [sportLeagueId], references: [id], onDelete: Cascade)
  /// The composite key keeps the slot in a competition of its own league.
  competition      SportLeagueCompetition                @relation(fields: [sportLeagueId, sportLeagueCompetitionId], references: [sportLeagueId, id], onDelete: Cascade)
  providerMappings SportLeagueCompetitionSlotProviderMapping[]
  seasonSlots      SportLeagueSeasonCompetitionSlot[]
  templateSlots    ContestConfigTemplateSlot[]
  eventPageOffers  EventPageOffer[]

  @@unique([sportLeagueId, key])
  /// The target of a provider mapping's composite key.
  @@unique([sportLeagueId, id])
  @@index([sportLeagueId, sportLeagueCompetitionId])
  @@map("sport_league_competition_slots")
}

/// How one provider's games are matched to a slot definition (#2002, plan §1): inclusion only, so
/// a provider value no row names is never synced. Keyed by the league's own provider mapping, so
/// the slot and the provider league are always the same sport league's. Set by migration; slice 12
/// adds NAME_PATTERN rows from findings. Database check: `providerValue` is null exactly for
/// CALENDAR_WEEK and DATE_WINDOW.
model SportLeagueCompetitionSlotProviderMapping {
  id                           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId                String                      @map("sport_league_id") @db.Uuid
  sportLeagueCompetitionSlotId       String                      @map("sport_league_competition_slot_id") @db.Uuid
  sportLeagueProviderMappingId String                      @map("sport_league_provider_mapping_id") @db.Uuid
  matchType                    PrismaSlotProviderMatchType @map("match_type")
  /// What the provider's game is matched on: the adapter's code (`REG:5`, `POST:3`) or a
  /// normalized tournament name. Null for CALENDAR_WEEK, which matches by the global date rule,
  /// and for DATE_WINDOW, which matches by the Season slot's window.
  providerValue                String?                     @map("provider_value") @db.VarChar(200)
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  slot                       SportLeagueCompetitionSlot       @relation(fields: [sportLeagueId, sportLeagueCompetitionSlotId], references: [sportLeagueId, id], onDelete: Cascade, map: "competition_slot_provider_mappings_slot_fkey")
  sportLeagueProviderMapping SportLeagueProviderMapping @relation(fields: [sportLeagueId, sportLeagueProviderMappingId], references: [sportLeagueId, id], onDelete: Cascade, map: "competition_slot_provider_mappings_provider_mapping_fkey")

  /// A provider value names at most one slot of the league.
  @@unique([sportLeagueProviderMappingId, matchType, providerValue], map: "competition_slot_provider_mappings_value_key")
  /// A slot has one row per provider (plan §1), one way each feed's games are matched to it, except
  /// NAME_PATTERN: "link to existing" adds a tournament's other names as more patterns (#2011). A
  /// partial unique index in the migration (`..._one_per_provider`, WHERE match_type is not
  /// NAME_PATTERN) holds it; Prisma cannot declare one.
  @@index([sportLeagueCompetitionSlotId, sportLeagueProviderMappingId], map: "competition_slot_provider_mappings_slot_provider_idx")
  @@index([sportLeagueId, sportLeagueCompetitionSlotId], map: "competition_slot_provider_mappings_slot_idx")
  @@index([sportLeagueId, sportLeagueProviderMappingId], map: "competition_slot_provider_mappings_provider_mapping_idx")
  @@map("sport_league_competition_slot_provider_mappings")
}

/// One real Season of a sport league (#2003, plan §2): its own identity, named and dated by the
/// migration that adds it, never computed from a clock. The sync reads a Season only through a
/// provider mapping (`SportLeagueSeasonProviderMapping`); a league with no Season to read raises a
/// SEASON_MISSING finding until a migration adds the next one (#1995 defers a root admin action).
model SportLeagueSeason {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId    String   @map("sport_league_id") @db.Uuid
  /// What screens call it ("2025-26", "2026"), so no screen builds a Season label.
  name             String   @db.VarChar(32)
  /// The year the Season is named for (Derek 2026-11-24): NFL 2025 is 2025, Super Bowl included;
  /// a season split over New Year (NBA 2025-26) is its end year; a calendar-year league's is its
  /// year. Set by migration, never computed.
  championshipYear Int      @map("championship_year")
  /// The Season's date span. A slot outside it raises a finding and never blocks a write.
  startsAt         DateTime @map("starts_at") @db.Timestamptz
  endsAt           DateTime @map("ends_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague      SportLeague                        @relation(fields: [sportLeagueId], references: [id], onDelete: Cascade)
  currentOf        SportLeague?                       @relation("CurrentSportLeagueSeason")
  providerMappings SportLeagueSeasonProviderMapping[]
  phases           SportLeagueSeasonPhase[]
  competitions     SportLeagueSeasonCompetition[]
  slots            SportLeagueSeasonCompetitionSlot[]
  sportEvents      SportEvent[]

  @@unique([sportLeagueId, championshipYear])
  /// The target of the composite keys that keep a Season's rows in its own league.
  @@unique([sportLeagueId, id])
  @@map("sport_league_seasons")
}

/// A provider's own id for a Season (#2003, plan §6), keyed by the league's provider mapping: how
/// the sync asks a feed for that Season. Set by migration with the Season.
model SportLeagueSeasonProviderMapping {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId                String   @map("sport_league_id") @db.Uuid
  sportLeagueSeasonId          String   @map("sport_league_season_id") @db.Uuid
  sportLeagueProviderMappingId String   @map("sport_league_provider_mapping_id") @db.Uuid
  /// The provider's season id as it sends it (BALLDONTLIE's `season`).
  providerSeasonId             String   @map("provider_season_id") @db.VarChar(64)
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  season                     SportLeagueSeason          @relation(fields: [sportLeagueId, sportLeagueSeasonId], references: [sportLeagueId, id], onDelete: Cascade, map: "sport_league_season_provider_mappings_season_fkey")
  sportLeagueProviderMapping SportLeagueProviderMapping @relation(fields: [sportLeagueId, sportLeagueProviderMappingId], references: [sportLeagueId, id], onDelete: Cascade, map: "sport_league_season_provider_mappings_provider_mapping_fkey")

  /// A provider's season id names at most one Season of the league.
  @@unique([sportLeagueProviderMappingId, providerSeasonId], map: "sport_league_season_provider_mappings_value_key")
  /// A Season has one id per provider.
  @@unique([sportLeagueSeasonId, sportLeagueProviderMappingId], map: "sport_league_season_provider_mappings_season_provider_key")
  @@index([sportLeagueId, sportLeagueSeasonId], map: "sport_league_season_provider_mappings_season_idx")
  @@index([sportLeagueId, sportLeagueProviderMappingId], map: "sport_league_season_provider_mappings_provider_mapping_idx")
  @@map("sport_league_season_provider_mappings")
}

/// One phase of one Season (#2003): every phase definition of the league, synced or not.
model SportLeagueSeasonPhase {
  id                  String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId       String                        @map("sport_league_id") @db.Uuid
  sportLeagueSeasonId String                        @map("sport_league_season_id") @db.Uuid
  sportLeaguePhaseId  String                        @map("sport_league_phase_id") @db.Uuid
  /// How far the phase has got this Season (#2153); slice 14 (#2013) moves it.
  status              PrismaSeasonCompetitionStatus @default(SCHEDULED)
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz

  season SportLeagueSeason @relation(fields: [sportLeagueId, sportLeagueSeasonId], references: [sportLeagueId, id], onDelete: Cascade, map: "sport_league_season_phases_season_fkey")
  phase  SportLeaguePhase  @relation(fields: [sportLeagueId, sportLeaguePhaseId], references: [sportLeagueId, id], onDelete: Restrict, map: "sport_league_season_phases_phase_fkey")
  competitions SportLeagueSeasonCompetition[]

  @@unique([sportLeagueSeasonId, sportLeaguePhaseId])
  @@unique([sportLeagueSeasonId, id])
  @@index([sportLeagueId, sportLeaguePhaseId])
  @@map("sport_league_season_phases")
}

/// One competition of one Season (#2153): every competition definition of the league, with how
/// far it has got and its champion. Slice 14 (#2013) moves the status and sets the champion from
/// the FINAL slot's match. Database check: the champion is set only once the competition is
/// COMPLETED.
model SportLeagueSeasonCompetition {
  id                       String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId            String                        @map("sport_league_id") @db.Uuid
  sportLeagueSeasonId      String                        @map("sport_league_season_id") @db.Uuid
  /// The competition's phase, carried so the composite keys hold the Season competition under its
  /// own Season phase and the competition in that phase.
  sportLeaguePhaseId       String                        @map("sport_league_phase_id") @db.Uuid
  sportLeagueCompetitionId String                        @map("sport_league_competition_id") @db.Uuid
  status                   PrismaSeasonCompetitionStatus @default(SCHEDULED)
  /// The participant who won it; null until COMPLETED, and always null for a competition with no
  /// FINAL slot.
  championParticipantId    String?                       @map("champion_participant_id") @db.Uuid
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                      @updatedAt @map("updated_at") @db.Timestamptz

  season      SportLeagueSeason                  @relation(fields: [sportLeagueId, sportLeagueSeasonId], references: [sportLeagueId, id], onDelete: Cascade, map: "sport_league_season_competitions_season_fkey")
  seasonPhase SportLeagueSeasonPhase             @relation(fields: [sportLeagueSeasonId, sportLeaguePhaseId], references: [sportLeagueSeasonId, sportLeaguePhaseId], onDelete: Cascade, map: "sport_league_season_competitions_season_phase_fkey")
  competition SportLeagueCompetition             @relation(fields: [sportLeaguePhaseId, sportLeagueCompetitionId], references: [sportLeaguePhaseId, id], onDelete: Restrict, map: "sport_league_season_competitions_competition_fkey")
  champion    Participant?                       @relation(fields: [championParticipantId], references: [id], onDelete: Restrict, map: "sport_league_season_competitions_champion_fkey")
  slots       SportLeagueSeasonCompetitionSlot[]

  @@unique([sportLeagueSeasonId, sportLeagueCompetitionId])
  /// The target of a Season slot's composite key.
  @@unique([sportLeagueSeasonId, id])
  @@index([sportLeagueId, sportLeagueCompetitionId])
  /// Behind the competition key, so deleting a competition never scans this table.
  @@index([sportLeaguePhaseId, sportLeagueCompetitionId])
  @@index([championParticipantId])
  @@map("sport_league_season_competitions")
}

/// One slot of one Season (#2003, plan §2): a slot definition played in that Season, or a labelled
/// test slot. A synced phase's slots are added with the Season, except TOURNAMENT slots, which the
/// sync adds when the first tournament matches (slice 12). Dates come from the slot's Games once
/// the sync matches games to slots (slices 8 and 13); until then they are null. The series format
/// is copied from the definition, so a later format change never rewrites a past Season. Database
/// checks: a test slot has a label and a synced one none; a definition has one synced slot per
/// Season and any number of test slots, each label once.
model SportLeagueSeasonCompetitionSlot {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId            String                  @map("sport_league_id") @db.Uuid
  sportLeagueSeasonId      String                  @map("sport_league_season_id") @db.Uuid
  sportLeagueSeasonCompetitionId String            @map("sport_league_season_competition_id") @db.Uuid
  sportLeagueCompetitionSlotId   String                  @map("sport_league_competition_slot_id") @db.Uuid
  /// The earliest start and latest end of the slot's Games; null until the sync has matched one.
  startsAt                 DateTime?               @map("starts_at") @db.Timestamptz
  endsAt                   DateTime?               @map("ends_at") @db.Timestamptz
  /// The dates a DATE_WINDOW slot's games are placed by (#2012): the schedule's own published dates
  /// for this Season, set by migration, kept apart from the dates derived from the placed games.
  /// Null on every other slot, and on a DATE_WINDOW slot whose dates are not announced yet.
  /// Database check: both or neither, and the end after the start.
  windowStartsAt           DateTime?               @map("window_starts_at") @db.Timestamptz
  windowEndsAt             DateTime?               @map("window_ends_at") @db.Timestamptz
  /// Whether the window is the published dates or a best guess; set exactly when the window is.
  windowStatus             PrismaSlotWindowStatus? @map("window_status")
  status                   PrismaSeasonSlotStatus  @default(SCHEDULED)
  seriesFormat             PrismaSeriesFormat      @map("series_format")
  seriesGames              Int                     @map("series_games")
  pairing                  PrismaSlotPairing
  /// A test slot (QA only, never in production): the sync never reads or writes it, so test and
  /// synced events never share a slot. Several per definition, told apart by `label`.
  isTestData               Boolean                 @default(false) @map("is_test_data")
  /// A test slot's label, unique per Season and definition; null on a synced slot.
  label                    String?                 @db.VarChar(64)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  season        SportLeagueSeason                           @relation(fields: [sportLeagueId, sportLeagueSeasonId], references: [sportLeagueId, id], onDelete: Cascade, map: "sport_league_season_competition_slots_season_fkey")
  /// The composite key keeps the slot in a competition of its own Season.
  seasonCompetition SportLeagueSeasonCompetition          @relation(fields: [sportLeagueSeasonId, sportLeagueSeasonCompetitionId], references: [sportLeagueSeasonId, id], onDelete: Cascade, map: "sport_league_season_competition_slots_season_competition_fkey")
  /// The composite key keeps the definition one of its own league's.
  definition    SportLeagueCompetitionSlot                        @relation(fields: [sportLeagueId, sportLeagueCompetitionSlotId], references: [sportLeagueId, id], onDelete: Restrict, map: "sport_league_season_competition_slots_definition_fkey")
  eventSlot     SportEventSlot?
  providerLinks SportLeagueSeasonCompetitionSlotProviderMapping[]

  /// The target of an event slot's composite key.
  @@unique([sportLeagueSeasonId, id], map: "sport_league_season_competition_slots_season_id_key")
  /// The target of a provider link's composite key, which keeps the link on the slot's own league.
  @@unique([sportLeagueId, id], map: "sport_league_season_competition_slots_league_id_key")
  @@index([sportLeagueSeasonId, sportLeagueSeasonCompetitionId], map: "sport_league_season_competition_slots_season_competition_idx")
  @@index([sportLeagueId, sportLeagueCompetitionSlotId], map: "sport_league_season_competition_slots_definition_idx")
  @@map("sport_league_season_competition_slots")
}

/// The provider's tournament a Season slot was linked to by its name (#2011, plan §6 item 2): the
/// first time an open-phase tournament's normalized name matches one NAME_PATTERN mapping, its
/// Season slot is created and linked here, and from then on the tournament matches by this code
/// whatever it is called. One link per slot and provider mapping; a code links one slot.
model SportLeagueSeasonCompetitionSlotProviderMapping {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId                String   @map("sport_league_id") @db.Uuid
  sportLeagueSeasonCompetitionSlotId String   @map("sport_league_season_competition_slot_id") @db.Uuid
  sportLeagueProviderMappingId String   @map("sport_league_provider_mapping_id") @db.Uuid
  /// The code the provider's adapter names the tournament's place by: its tournament id.
  providerValue                String   @map("provider_value") @db.VarChar(200)
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seasonSlot                 SportLeagueSeasonCompetitionSlot @relation(fields: [sportLeagueId, sportLeagueSeasonCompetitionSlotId], references: [sportLeagueId, id], onDelete: Cascade, map: "season_competition_slot_provider_mappings_slot_fkey")
  sportLeagueProviderMapping SportLeagueProviderMapping @relation(fields: [sportLeagueId, sportLeagueProviderMappingId], references: [sportLeagueId, id], onDelete: Cascade, map: "season_competition_slot_provider_mappings_mapping_fkey")

  @@unique([sportLeagueSeasonCompetitionSlotId, sportLeagueProviderMappingId], map: "season_competition_slot_provider_mappings_slot_key")
  @@unique([sportLeagueProviderMappingId, providerValue], map: "season_competition_slot_provider_mappings_value_key")
  @@index([sportLeagueId, sportLeagueSeasonCompetitionSlotId], map: "season_competition_slot_provider_mappings_slot_idx")
  @@map("sport_league_season_competition_slot_provider_mappings")
}

model ProviderSyncRun {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The provider the run read (#2040).
  providerId      String                      @map("provider_id") @db.Uuid
  /// What the run syncs and what started it (#1819).
  kind            PrismaProviderSyncKind
  trigger         PrismaJobTrigger
  /// The run's scope in PoolMaster's own ids (#1819): the sport league of an EVENTS run; the
  /// event of a FIELD or SCORES run and that event's sport league (#1847). Null where the run's
  /// provider event is linked to no event of ours.
  sportLeagueId   String?                     @map("sport_league_id") @db.Uuid
  sportEventId    String?                     @map("sport_event_id") @db.Uuid
  /// The background job that ran it, so Activity opens a job's runs (#1819). Kept after the job is deleted.
  backgroundJobId String?                     @map("background_job_id") @db.Uuid
  status          PrismaProviderSyncRunStatus
  startedAt       DateTime?                   @map("started_at") @db.Timestamptz
  completedAt     DateTime?                   @map("completed_at") @db.Timestamptz
  /// What the run did, in one line for the sync history (#1999).
  summary         String                      @default("")
  /// Its numeric counts by name, for the root admin's diagnostics. Display only: nothing reads a count from it.
  stats           Json                        @default("{}")
  /// The rows it created or updated; null until it completes, or when it counted none.
  changedCount    Int?                        @map("changed_count")
  /// The errors it hit; a FAILED run has at least one.
  errorCount      Int                         @default(0) @map("error_count")
  /// The run's detailed diagnostics: the changed rows, the job record and the raw provider
  /// payload. Read one run at a time; the nightly cleanup clears it 30 days after submission
  /// and deletes the run after a year (#1174).
  detailsJson     Json?                       @map("details_json")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  /// The run's sport league (#2042), which gives the run its sport; a run with none has no sport.
  sportLeague SportLeague? @relation(fields: [sportLeagueId], references: [id], onDelete: SetNull)
  /// The run's event (#2040); a deleted event leaves its runs, unscoped.
  sportEvent  SportEvent?  @relation(fields: [sportEventId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([backgroundJobId])
  /// The Sports page's latest finished run of each sync kind per sport league (#1847).
  @@index([sportLeagueId, kind, createdAt(sort: Desc)])
  @@index([sportEventId, kind, createdAt(sort: Desc)])
  @@map("provider_sync_runs")
}

/// A problem a sync found (#1999), one row per kind and subject: the sync raising it again
/// updates the row's last-seen time instead of adding one. The subject is the sport league
/// always, then the event, the Provider and the provider's own value where the kind has them;
/// one NULLS NOT DISTINCT unique index in the migration keeps it to one row, which
/// Prisma cannot declare. `providerValue` is the stated exception to "provider keys live only in
/// ProviderMapping tables": it is what the feed sent that nothing maps.
model ProviderSyncFinding {
  id                    String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                  PrismaProviderSyncFindingKind
  severity              PrismaProviderSyncFindingSeverity
  status                PrismaProviderSyncFindingStatus   @default(OPEN)
  sportLeagueId         String                            @map("sport_league_id") @db.Uuid
  sportEventId          String?                           @map("sport_event_id") @db.Uuid
  providerId            String?                           @map("provider_id") @db.Uuid
  /// What the feed sent that nothing maps (a participant id). Part of the subject.
  providerValue         String?                           @map("provider_value") @db.VarChar(255)
  /// The feed's own name for that value, when it sent one. Not part of the subject.
  providerValueName     String?                           @map("provider_value_name") @db.VarChar(255)
  /// Why an admin waived it; required while WAIVED (a check in the migration).
  waiveNote             String?                           @map("waive_note")
  firstSeenAt           DateTime                          @map("first_seen_at") @db.Timestamptz
  lastSeenAt            DateTime                          @map("last_seen_at") @db.Timestamptz
  /// How many sync passes have raised it.
  seenCount             Int                               @default(1) @map("seen_count")
  statusChangedAt       DateTime                          @map("status_changed_at") @db.Timestamptz
  /// The root admin who last set its status; null when the sync did.
  statusChangedByUserId String?                           @map("status_changed_by_user_id") @db.Uuid
  createdAt             DateTime                          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                          @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague     SportLeague @relation(fields: [sportLeagueId], references: [id], onDelete: Cascade)
  sportEvent      SportEvent? @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  provider        Provider?   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  statusChangedBy User?       @relation("SyncFindingStatusChangedBy", fields: [statusChangedByUserId], references: [id], onDelete: SetNull)

  /// One row per kind and subject. The migration builds it NULLS NOT DISTINCT, so a subject
  /// with no event or value still has one row; Prisma cannot say so here.
  @@unique([kind, sportLeagueId, sportEventId, providerId, providerValue], map: "provider_sync_findings_subject_key")
  /// The Sports page's open counts per league, and a league's findings.
  @@index([sportLeagueId, status, severity])
  @@index([sportEventId])
  @@index([providerId])
  @@index([statusChangedByUserId])
  /// The retention cleanup's resolved rows, oldest first.
  @@index([status, statusChangedAt])
  @@map("provider_sync_findings")
}

// =============================================================================
// Platform
// =============================================================================

model PlatformRuntimeConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configJson  Json     @map("config_json")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_runtime_configs")
}

/// Durable work a request handed off (#1439), claimed and run by any server task. Written in
/// the transaction of the change that caused it; the nightly cleanup deletes finished jobs.
model BackgroundJob {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            PrismaBackgroundJobType
  payload         Json
  status          PrismaBackgroundJobStatus @default(QUEUED)
  runAt           DateTime                  @default(now()) @map("run_at") @db.Timestamptz
  attempts        Int                       @default(0)
  /// While RUNNING, until when the claiming task holds it; past this the job is due again.
  leaseUntil      DateTime?                 @map("lease_until") @db.Timestamptz
  lastError       String?                   @map("last_error")
  /// One job waiting for its first try per subject: an enqueue with a key such a job holds
  /// writes nothing. Cleared for good when the job is claimed, so a later enqueue (even while
  /// the job waits to be retried) queues a fresh job.
  dedupeKey       String?                   @unique @map("dedupe_key") @db.VarChar(200)
  /// The job's scope (#1819), set from its payload when queued (`BACKGROUND_JOB_SCOPES`), so
  /// Activity filters by sport league and event on indexed columns. A job on an event carries the
  /// event; its league is read through the event.
  sportLeagueId   String?                   @map("sport_league_id") @db.Uuid
  sportEventId    String?                   @map("sport_event_id") @db.Uuid
  /// The provider a sync job reads (#2040); null for a job that calls no provider.
  providerId      String?                   @map("provider_id") @db.Uuid
  /// What a SUCCEEDED job's handler reported it did (#1819), shown on Activity; null when it reported nothing.
  result          Json?
  /// What started it (#1861); jobs from before #1861 read SYSTEM.
  trigger         PrismaJobTrigger
  /// The person whose request queued it: set only for ADMIN and COMMISSIONER (#1861). Null once they are deleted.
  startedByUserId String?                   @map("started_by_user_id") @db.Uuid
  /// When its latest try started (#1861); null until first claimed.
  startedAt       DateTime?                 @map("started_at") @db.Timestamptz
  /// How many rows a SUCCEEDED job created or changed (#1861); null until it succeeds.
  changedCount    Int?                      @map("changed_count")
  /// Why it did not do its work (#1861): with a failed try's error, or a hold on a finished job.
  errorType       PrismaJobErrorType?       @map("error_type")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime?                 @map("completed_at") @db.Timestamptz

  startedBy User?     @relation("BackgroundJobStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  provider  Provider? @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
  @@index([status, leaseUntil])
  @@index([status, completedAt])
  @@index([createdAt(sort: Desc)])
  @@index([sportLeagueId, createdAt(sort: Desc)])
  @@index([sportEventId, createdAt(sort: Desc)])
  @@index([startedByUserId])
  @@index([providerId])
  @@map("background_jobs")
}

/// One saved change to a platform_runtime_configs row (#450). Append-only.
model PlatformRuntimeConfigHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey    String   @map("config_key") @db.VarChar(100)
  previousJson Json?    @map("previous_json")
  newJson      Json     @map("new_json")
  changedById  String?  @map("changed_by_id") @db.Uuid
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz

  @@index([configKey, changedAt(sort: Desc)])
  @@map("platform_runtime_config_history")
}

/// A category of email a user turned off (#844 slice 5); no row means it is on.
model EmailOptOut {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                      @map("user_id") @db.Uuid
  category  PrismaOptionalEmailCategory
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("email_opt_outs")
}
