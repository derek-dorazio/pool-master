}

/// Tournament structural format — drives which contest types are valid
/// pool formats for a given Sport. Composes with category to form the
/// (sport × pool format) compatibility matrix in shared/domain.
enum PrismaTournamentFormat {
  STROKE_PLAY_TOURNAMENT
  /// One race: one field, one finishing order (#623).
  RACE
  /// Games between two sides (#698; KNOCKOUT_BRACKET until #715). Whether they form a bracket
  /// is read from the match links.
  MATCHES
}

/// Where one match stands (#698). Mirrors the domain `MatchStatus`.
enum PrismaMatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

/// How one side of a match came out (#2046), rolled up from its Games by the result writer alone.
/// PENDING until the match is decided. Mirrors the domain `MatchSideOutcome`.
enum PrismaMatchSideOutcome {
  PENDING
  WON
  LOST
  TIED
}

/// Where one side played one Game (#2046): HOME, AWAY, or NONE at a neutral site. Per Game, since
/// home court alternates in a series. Mirrors the domain `HomeAway`.
enum PrismaHomeAway {
  HOME
  AWAY
  NONE
}

/// What a period score counts (#2046): a period of play, an overtime period, or the shoot-out's
