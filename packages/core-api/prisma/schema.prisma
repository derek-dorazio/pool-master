// =============================================================================
// Results
// =============================================================================

// =============================================================================
// Sports Data Integration (Plan 06)
// =============================================================================

model SportEvent {
  id                   String                    @id @default(uuid()) @db.Uuid
  externalId           String                    @map("external_id") @db.VarChar(255)
  providerId           String                    @map("provider_id") @db.VarChar(100)
  sport                String                    @db.VarChar(50)
  name                 String                    @db.VarChar(500)
  venue                String?                   @db.VarChar(500)
  location             String?                   @db.VarChar(500)
  startDate            DateTime                  @map("start_date") @db.Timestamptz
  endDate              DateTime?                 @map("end_date") @db.Timestamptz
  status               PrismaSportEventStatus    @default(SCHEDULED)
  rounds               Int?
  participantCount     Int?                      @map("participant_count")
  releaseAt            DateTime                  @map("release_at") @db.Timestamptz
  fieldLocksAt         DateTime                  @map("field_locks_at") @db.Timestamptz
  fieldLocked          Boolean                   @default(false) @map("field_locked")
  metadata             Json                      @default("{}")
  // Nullable for now — sync-created events (the only SportEvent write path
  // that exists today) have no season context. Tightens to required once
  // admin-authored creation (plans/124 §5.2) is the only creation path and
  // the sync-create path is retired (plans/125) — see plans/124 §4.3.
  seasonId             String?                   @map("season_id") @db.Uuid
  // Nullable — not every tournament is a recurring one (a one-off exhibition
  // doesn't need a stable identity). Auto-resolved by find-or-create on
  // (sportLeagueId, name) at tournament creation, never an admin decision
  // (plans/124 §4.3a).
  leagueEventId        String?                   @map("league_event_id") @db.Uuid
  // Sync eligibility, separate from providerId/externalId identity — see
  // plans/124 §3.5/§4.4. @default(FULL) keeps every ingestion-created row
  // behaving exactly as it does today; only admin-authored tournaments
  // start at NONE.
  syncScope            PrismaSportEventSyncScope @default(FULL) @map("sync_scope")
  // Admin escape hatch: false stops the lifecycle scheduler (plans/124 §3.6)
  // from ever touching this event's status, no matter what the recorded
  // round schedule says — a rain delay, a dispute, etc.
  autoLifecycleEnabled Boolean                   @default(true) @map("auto_lifecycle_enabled")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  contests               Contest[]
  sportEventParticipants SportEventParticipant[]
  contestSportEvents     ContestSportEvent[]
  golfTiers              SportEventGolfTier[]
  roundSchedule          SportEventRound[]
  season                 Season?                 @relation(fields: [seasonId], references: [id])
  leagueEvent            LeagueEvent?            @relation(fields: [leagueEventId], references: [id])

  @@unique([providerId, externalId])
  @@index([sport, status])
  @@index([startDate, endDate])
  @@map("sport_events")
}

model ContestTimingPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  sport         String   @db.VarChar(50)
  eventType     String?  @map("event_type") @db.VarChar(100)
  contestFormat String?  @map("contest_type") @db.VarChar(100)
  releaseRule   String   @map("release_rule") @db.VarChar(255)
  fieldLockRule String   @map("field_lock_rule") @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([sport, eventType, contestFormat])
  @@index([sport, active])
  @@map("contest_timing_policies")
}

model SportEventParticipant {
  id             String                               @id @default(uuid()) @db.Uuid
  sportEventId   String                               @map("sport_event_id") @db.Uuid
  participantId  String                               @map("participant_id") @db.Uuid
  isActive       Boolean                              @default(true) @map("is_active")
  inactiveReason PrismaGolfParticipantInactiveReason? @map("inactive_reason")
  worldRanking   Int?                                 @map("world_ranking")
  oddsToWin      Decimal?                             @map("odds_to_win") @db.Decimal(10, 2)
  seedNumber     Int?                                 @map("seed_number")
  metadata       Json                                 @default("{}")
  createdAt      DateTime                             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                             @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent    SportEvent                          @relation(fields: [sportEventId], references: [id])
  participant   Participant                         @relation(fields: [participantId], references: [id])
  golfValuation SportEventParticipantGolfValuation?
  picks         ContestEntryPick[]
  golfRounds    SportEventParticipantGolfRound[]
  golfStanding  SportEventParticipantGolfStanding?

  @@unique([sportEventId, participantId])
  @@index([sportEventId])
  @@index([participantId])
  @@map("sport_event_participants")
}

/// A scheduled sub-period of a SportEvent with its own start/end time — a
/// golf tournament's Round 2, an NFL Week's set of games, a World Cup's
/// match day. Cross-sport by shape; plans/124 populates and uses it only for
/// golf rounds. Genuinely different from SportEventParticipantGolfRound
/// below: this holds the round's own schedule, independent of any
/// participant; that one holds one golfer's result for a round.
model SportEventRound {
  id             String    @id @default(uuid()) @db.Uuid
  sportEventId   String    @map("sport_event_id") @db.Uuid
  roundNumber    Int       @map("round_number")
  scheduledDate  DateTime  @map("scheduled_date") @db.Timestamptz
  scheduledEndAt DateTime? @map("scheduled_end_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent SportEvent                       @relation(fields: [sportEventId], references: [id])
  golfRounds SportEventParticipantGolfRound[]

  @@unique([sportEventId, roundNumber])
  @@map("sport_event_rounds")
}

/// Per-event per-participant golf round result. Sport-polymorphic detail
/// child of SportEventParticipant; cardinality 1..N where N is the
/// tournament's round count (4 for standard PGA tournament). Replaces the
/// untyped JSON storage in the dropped SportEventParticipantSourceData.
/// See plans/117 §6.1 for the column contract. sportEventRoundId replaces
/// the old bare `round: Int` (plans/124 §4.10) — a round number that
/// doesn't exist for this event now fails at insert time with a foreign-key
/// violation, not at read time with a confused leaderboard row.
model SportEventParticipantGolfRound {
  id                      String    @id @default(uuid()) @db.Uuid
  sportEventParticipantId String    @map("sport_event_participant_id") @db.Uuid
  sportEventRoundId       String    @map("sport_event_round_id") @db.Uuid
  strokes                 Int
  scoreToPar              Int       @map("score_to_par")
  thru                    Int?
  status                  String    @default("PENDING") @db.VarChar(20)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])
  sportEventRound       SportEventRound       @relation(fields: [sportEventRoundId], references: [id])

  @@unique([sportEventParticipantId, sportEventRoundId])
  @@index([sportEventParticipantId])
  @@map("sport_event_participant_golf_rounds")
}

/// Maintained event-level Golf participant standing. One row per event golfer,
/// updated from live/final round rows and used by member leaderboard reads.
model SportEventParticipantGolfStanding {
  id                      String               @id @default(uuid()) @db.Uuid
  sportEventParticipantId String               @unique @map("sport_event_participant_id") @db.Uuid
  eventScoreToPar         Int                  @map("event_score_to_par")
  eventStrokes            Int                  @map("event_strokes")
  currentRound            Int?                 @map("current_round")
  currentRoundThru        Int?                 @map("current_round_thru")
  status                  PrismaGolfLiveStatus @default(ACTIVE)
  position                Int?
  displayPosition         String?              @map("display_position") @db.VarChar(20)
  asOf                    DateTime?            @map("as_of") @db.Timestamptz
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])

  @@index([status])
  @@index([position])
  @@map("sport_event_participant_golf_standings")
}

/// Per-tournament tier definition. Event-level only — no contest override
/// (plans/124 §4.6). Tier count is however many rows exist for the event,
/// not a separate parameter (§4.5a).
model SportEventGolfTier {
  id               String   @id @default(uuid()) @db.Uuid
  sportEventId     String   @map("sport_event_id") @db.Uuid
  tierKey          String   @db.VarChar(50)
  label            String   @db.VarChar(100)
  tierNumber       Int      @map("tier_number")
  defaultPickCount Int      @map("default_pick_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent SportEvent                           @relation(fields: [sportEventId], references: [id])
  valuations SportEventParticipantGolfValuation[]

  @@unique([sportEventId, tierKey])
  @@unique([sportEventId, tierNumber])
  @@map("sport_event_golf_tiers")
}

/// The tier and/or price for one golfer in one tournament — one row per
/// SportEventParticipant, same 1:1 shape as worldRanking/oddsToWin/seedNumber
/// already living there. Replaces the legacy SportEventParticipantValuation
/// for all NEW writes; that table is not yet dropped because drafts/routes.ts
/// still reads it as the live draft room's tier/price source — see plans/124
/// §4.5/§4.6b. That rewiring + table drop is sequenced into a later slice.
model SportEventParticipantGolfValuation {
  id                      String                     @id @default(uuid()) @db.Uuid
  sportEventParticipantId String                     @unique @map("sport_event_participant_id") @db.Uuid
  sportEventGolfTierId    String?                    @map("sport_event_golf_tier_id") @db.Uuid
  tierOrderIndex          Int?                       @map("tier_order_index")
  tierAssignedSource      PrismaGolfValuationSource? @map("tier_assigned_source")
  price                   Decimal?                   @db.Decimal(10, 2)
  priceAssignedSource     PrismaGolfValuationSource? @map("price_assigned_source")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])
  sportEventGolfTier    SportEventGolfTier?   @relation(fields: [sportEventGolfTierId], references: [id])

  @@index([sportEventGolfTierId, tierOrderIndex])
  @@map("sport_event_participant_golf_valuations")
}

model IngestionJob {
