model Contest {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId                  String              @map("league_id") @db.Uuid
  sportEventId              String?             @map("sport_event_id") @db.Uuid
  name                      String
  status                    String              @default("DRAFT")
  contestFormat             PrismaContestFormat @default(ROSTER) @map("contest_format")
  selectionType             String              @map("selection_type")
  scoringEngine             String              @map("scoring_engine")
  isExclusive               Boolean             @default(false) @map("is_exclusive")
  scoringStopsOnElimination Boolean             @default(false) @map("scoring_stops_on_elimination")
  startsAt                  DateTime?           @map("starts_at") @db.Timestamptz
  endsAt                    DateTime?           @map("ends_at") @db.Timestamptz
  lockAt                    DateTime?           @map("lock_at") @db.Timestamptz
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  league         League                 @relation(fields: [leagueId], references: [id])
  sportEvent     SportEvent?            @relation(fields: [sportEventId], references: [id])
  configuration  ContestConfiguration?
  entries        ContestEntry[]
  entryStandings ContestEntryStanding[]
  draftSession   DraftSession?

  @@index([leagueId])
  @@index([sportEventId])
  @@index([status])
  @@map("contests")
}

model ContestConfiguration {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId            String    @unique @map("contest_id") @db.Uuid
  templateId           String?   @map("template_id") @db.Uuid
  templateVersion      Int?      @map("template_version")
  selectionType        String    @map("selection_type") @db.VarChar(50)
  configJson           Json?     @map("config_json")
  rounds               Int?
  timePerPickSeconds   Int?      @map("time_per_pick_seconds")
  autoPickPolicy       String?   @map("auto_pick_policy") @db.VarChar(50)
  tierConfig           Json?     @map("tier_config")
  budget               Int?
  pickCount            Int?      @map("pick_count")
  isExclusive          Boolean   @default(false) @map("is_exclusive")
  picksPerPeriod       Int?      @map("picks_per_period")
  roundValues          Json?     @map("round_values")
  startRound           String?   @map("start_round") @db.VarChar(50)
  locksAt              DateTime? @map("locks_at") @db.Timestamptz
  minimumEntries       Int?      @map("minimum_entries")
  maxEntriesPerSquad   Int?      @map("max_entries_per_squad")
  rosterSize           Int?      @map("roster_size")
  totalPrizePoolAmount Float?    @map("total_prize_pool_amount")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest                 Contest                         @relation(fields: [contestId], references: [id])
  template                ContestConfigTemplate?          @relation(fields: [templateId], references: [id])
  participantScoringRules ParticipantContestScoringRule[]
  prizeDefinitions        ContestPrizeDefinition[]

  @@map("contest_configurations")
}

model ContestConfigTemplate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sport         String   @db.VarChar(50)
  eventType     String?  @map("event_type") @db.VarChar(100)
  contestFormat String   @map("contest_type") @db.VarChar(50)
  /// A `SelectionType` value: how an entry in a contest created from this template picks.
  selectionType String   @map("selection_type") @db.VarChar(50)
  templateKey   String   @map("template_key") @db.VarChar(100)
  name          String   @db.VarChar(120)
  description   String   @db.VarChar(500)
  sortOrder     Int      @map("sort_order")
  isDefault     Boolean  @default(false) @map("is_default")
  active        Boolean  @default(true)
  configJson    Json     @map("config_json")
  schemaVersion Int      @default(1) @map("schema_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  configurations ContestConfiguration[]

  @@unique([sport, eventType, contestFormat, selectionType, templateKey])
  @@index([sport, contestFormat, active, sortOrder])
  @@map("contest_config_templates")
}

model ParticipantContestScoringRule {
  id                             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestConfigurationId         String   @map("contest_configuration_id") @db.Uuid
  participantScoringDefinitionId String   @map("participant_scoring_definition_id") @db.VarChar(100)
  sortOrder                      Int      @map("sort_order")
  config                         Json     @default("{}")
  active                         Boolean  @default(true)
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contestConfiguration ContestConfiguration @relation(fields: [contestConfigurationId], references: [id])

  @@unique([contestConfigurationId, sortOrder])
  @@index([contestConfigurationId])
  @@map("participant_contest_scoring_rules")
}

model ContestPrizeDefinition {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestConfigurationId String   @map("contest_configuration_id") @db.Uuid
  prizeDefinitionId      String   @map("prize_definition_id") @db.VarChar(100)
  displayName            String   @map("display_name") @db.VarChar(100)
  sortOrder              Int      @map("sort_order")
  ruleConfig             Json     @default("{}") @map("rule_config")
  payoutType             String?  @map("payout_type") @db.VarChar(50)
  amount                 Float?
  percentage             Float?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contestConfiguration ContestConfiguration @relation(fields: [contestConfigurationId], references: [id])

  @@unique([contestConfigurationId, sortOrder])
  @@index([contestConfigurationId])
  @@map("contest_prize_definitions")
}

// =============================================================================
// Entry & Picks
// =============================================================================

model ContestEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId       String   @map("contest_id") @db.Uuid
  squadId         String   @map("squad_id") @db.Uuid
  entryNumber     Int      @default(1) @map("entry_number")
  name            String
  status          String   @default("ACTIVE") @db.VarChar(20)
  tiebreakerValue Int?     @map("tiebreaker_value")
  isEliminated    Boolean  @default(false) @map("is_eliminated")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contest Contest @relation(fields: [contestId], references: [id])
  squad   Squad   @relation(fields: [squadId], references: [id])

  picks              ContestEntryPick[]
  draftPickHistories DraftPickHistory[]
  standing           ContestEntryStanding?

  @@unique([contestId, squadId, entryNumber])
  @@map("contest_entries")
}

/// A contest entry's standing, frozen when its contest settles — cross-sport.
///
/// Written once per entry by settlement when the linked SportEvent completes, and read by
/// the leaderboard of a COMPLETED contest instead of recomputing from live event scores:
/// a provider correction after settlement must not silently rewrite a finished result.
/// `position` is direction-free (1 is best), as on SportEventParticipantStanding; the raw
/// score lives in the sport's extension row.
///
/// `countingPickLimit` is the rule's N captured at settlement (best N picks count).
/// Configuration stays editable after a contest is reopened, so without it a frozen result
/// could not be explained. `contestId` is a documented denormalization of
/// `contestEntry.contestId`: the leaderboard read is per contest and this table's primary
/// access path, so it gets a covering index instead of a join. Settlement's upsert is its
/// single writer.
model ContestEntryStanding {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId         String    @map("contest_id") @db.Uuid
  contestEntryId    String    @unique @map("contest_entry_id") @db.Uuid
  position          Int?
  displayPosition   String?   @map("display_position") @db.VarChar(20)
  countingPickLimit Int       @map("counting_pick_limit")
  scoredPickCount   Int       @map("scored_pick_count")
  asOf              DateTime? @map("as_of") @db.Timestamptz
  settledAt         DateTime  @map("settled_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest      Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry              @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  golf         ContestEntryGolfStanding?

  @@index([contestId, position])
  @@map("contest_entry_standings")
}

/// Golf extension of ContestEntryStanding: the entry total its position was ranked from.
/// Keyed 1:1 to the core standing row.
model ContestEntryGolfStanding {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestEntryStandingId String   @unique @map("contest_entry_standing_id") @db.Uuid
  totalScoreToPar        Int?     @map("total_score_to_par")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contestEntryStanding ContestEntryStanding @relation(fields: [contestEntryStandingId], references: [id], onDelete: Cascade)

  @@map("contest_entry_golf_standings")
}

/// A pick on a contest entry — references a SportEventParticipant.
/// Unified across contest formats: optional period / slot / tier / cost
/// fields disambiguate per-format usage. The `contestFormat` column is
/// denormalized from the parent Contest to enable per-format partial
/// unique indexes (see plans/117 §7.1).
model ContestEntryPick {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId                 String              @map("entry_id") @db.Uuid
  sportEventParticipantId String              @map("sport_event_participant_id") @db.Uuid
  contestFormat           PrismaContestFormat @map("contest_format")
  period                  Int?
  slot                    Int?
  tier                    String?             @db.VarChar(50)
  cost                    Decimal?            @db.Decimal(12, 2)
  isAutoPicked            Boolean             @default(false) @map("is_auto_picked")
  draftRound              Int?                @map("draft_round")
  draftPickNumber         Int?                @map("draft_pick_number")
  pickedAt                DateTime            @default(now()) @map("picked_at") @db.Timestamptz
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  entry                 ContestEntry          @relation(fields: [entryId], references: [id])
  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])
  draftPickHistories    DraftPickHistory[]

  @@index([entryId])
  @@map("contest_entry_picks")
}

// =============================================================================
// Draft Session (Snake Draft only)
// =============================================================================

model DraftSession {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId            String    @unique @map("contest_id") @db.Uuid
  status               String    @default("PENDING")
  currentPickNumber    Int       @default(0) @map("current_pick_number")
  currentEntryId       String?   @map("current_entry_id") @db.Uuid
  startedAt            DateTime? @map("started_at") @db.Timestamptz
  currentTurnStartedAt DateTime? @map("current_turn_started_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest       Contest            @relation(fields: [contestId], references: [id])
  pickHistories DraftPickHistory[]

  @@map("draft_sessions")
}

model DraftPickHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftSessionId String   @map("draft_session_id") @db.Uuid
  pickId         String   @map("pick_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  pickNumber     Int      @map("pick_number")
  round          Int
  pickInRound    Int      @map("pick_in_round")
  autoPicked     Boolean  @default(false) @map("auto_picked")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  session DraftSession     @relation(fields: [draftSessionId], references: [id])
  pick    ContestEntryPick @relation(fields: [pickId], references: [id])
  entry   ContestEntry     @relation(fields: [entryId], references: [id])

  @@unique([draftSessionId, pickNumber])
  @@index([draftSessionId])
  @@index([pickId])
  @@map("draft_pick_histories")
}

// =============================================================================
// Results
// =============================================================================

// =============================================================================
// Sports Data Integration (Plan 06)
// =============================================================================

model SportEvent {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId           String                    @map("external_id") @db.VarChar(255)
  providerId           String                    @map("provider_id") @db.VarChar(100)
  sport                String                    @db.VarChar(50)
  name                 String                    @db.VarChar(500)
  venue                String?                   @db.VarChar(500)
  location             String?                   @db.VarChar(500)
  startDate            DateTime                  @map("start_date") @db.Timestamptz
  endDate              DateTime?                 @map("end_date") @db.Timestamptz
  status               PrismaSportEventStatus    @default(SCHEDULED)
  rounds               Int?
  participantCount     Int?                      @map("participant_count")
  releaseAt            DateTime                  @map("release_at") @db.Timestamptz
  fieldLocksAt         DateTime                  @map("field_locks_at") @db.Timestamptz
  fieldLocked          Boolean                   @default(false) @map("field_locked")
  metadata             Json                      @default("{}")
  // The series this is one edition of — the event's only parent, and its only
  // path to a sport league (plans/147). Auto-resolved by find-or-create on
  // (sportLeagueId, name) at tournament creation, never an admin decision
  // (plans/124 §4.3a).
  eventSeriesId        String                    @map("event_series_id") @db.Uuid
  // The year the edition is branded with — "the 2026 Masters" — which is not
  // always the year it starts in; startDate carries the real dates (plans/147
  // decision 3).
  eventYear            Int                       @map("event_year")
  // Sync eligibility, separate from providerId/externalId identity — see
  // plans/124 §3.5/§4.4. @default(FULL) keeps every ingestion-created row
  // behaving exactly as it does today; only admin-authored tournaments
  // start at NONE.
  syncScope            PrismaSportEventSyncScope @default(FULL) @map("sync_scope")
  // Admin escape hatch: false stops the lifecycle scheduler (plans/124 §3.6)
  // from ever touching this event's status, no matter what the recorded
  // round schedule says — a rain delay, a dispute, etc.
  autoLifecycleEnabled Boolean                   @default(true) @map("auto_lifecycle_enabled")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  contests               Contest[]
  sportEventParticipants SportEventParticipant[]
  tiers                  SportEventTier[]
  roundSchedule          SportEventRound[]
  eventSeries            EventSeries             @relation(fields: [eventSeriesId], references: [id])

  @@unique([providerId, externalId])
  // One edition of a series per year: there is one 2026 Masters (plans/147 decision 5).
  @@unique([eventSeriesId, eventYear])
  @@index([sport, status])
  @@index([startDate, endDate])
  @@map("sport_events")
}

model SportEventParticipant {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId   String                     @map("sport_event_id") @db.Uuid
  participantId  String                     @map("participant_id") @db.Uuid
  isActive       Boolean                    @default(true) @map("is_active")
  inactiveReason ParticipantInactiveReason? @map("inactive_reason")
  /// The rank that applied to this participant at this event (1 is best) —
  /// seeded from the provider or the sport-league affiliation, then editable.
  ranking        Int?
  oddsToWin      Decimal?                   @map("odds_to_win") @db.Decimal(10, 2)
  seedNumber     Int?                       @map("seed_number")
  metadata       Json                       @default("{}")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent  SportEvent                      @relation(fields: [sportEventId], references: [id])
  participant Participant                     @relation(fields: [participantId], references: [id])
  valuation   SportEventParticipantValuation?
  picks       ContestEntryPick[]
  rounds      SportEventParticipantRound[]
  standing    SportEventParticipantStanding?

  @@unique([sportEventId, participantId])
  @@index([sportEventId])
  @@index([participantId])
  @@map("sport_event_participants")
}

/// A scheduled sub-period of a SportEvent with its own start/end time — a
/// golf tournament's Round 2, an NFL Week's set of games, a World Cup's
/// match day. Cross-sport by shape; plans/124 populates and uses it only for
/// golf rounds. Genuinely different from SportEventParticipantRound below:
/// this holds the round's own schedule, independent of any participant; that
/// one joins one participant to one round.
model SportEventRound {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId   String    @map("sport_event_id") @db.Uuid
  roundNumber    Int       @map("round_number")
  scheduledDate  DateTime  @map("scheduled_date") @db.Timestamptz
  scheduledEndAt DateTime? @map("scheduled_end_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent        SportEvent                   @relation(fields: [sportEventId], references: [id])
  participantRounds SportEventParticipantRound[]

  @@unique([sportEventId, roundNumber])
  @@map("sport_event_rounds")
}

/// One participant's part in one round of an event — the (participant, round)
/// join, cross-sport. Its order is the round's `roundNumber`. What was scored
/// in the round lives in the sport's extension row, never here
/// (SportEventParticipantGolfRound for golf). sportEventRoundId replaced a
/// bare `round: Int` (plans/124 §4.10): a round number that doesn't exist for
/// the event fails at insert with a foreign-key violation.
model SportEventParticipantRound {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String    @map("sport_event_participant_id") @db.Uuid
  sportEventRoundId       String    @map("sport_event_round_id") @db.Uuid
  /// Provider-normalized progress of this participant's round.
  status                  String    @default("PENDING") @db.VarChar(20)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant           @relation(fields: [sportEventParticipantId], references: [id])
  sportEventRound       SportEventRound                 @relation(fields: [sportEventRoundId], references: [id])
  golf                  SportEventParticipantGolfRound?

  @@unique([sportEventParticipantId, sportEventRoundId])
  @@index([sportEventParticipantId])
  @@map("sport_event_participant_rounds")
}

/// Golf extension of SportEventParticipantRound: what one golfer scored in one
/// round. Keyed 1:1 to the core round row.
model SportEventParticipantGolfRound {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantRoundId String   @unique @map("participant_round_id") @db.Uuid
  strokes            Int
  scoreToPar         Int      @map("score_to_par")
  thru               Int?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  participantRound SportEventParticipantRound @relation(fields: [participantRoundId], references: [id])

  @@map("sport_event_participant_golf_rounds")
}

/// A participant's running standing in one event, cross-sport.
///
/// `position` is THE cross-sport rank key, and it is direction-free: 1 is best
/// in every sport. The raw score that produced it lives in the sport's
/// extension row (SportEventParticipantGolfStanding for golf), never here. A
/// cross-sport reader ranks on `position` and joins the extension only to
/// display a score — it never needs to know whether a higher or lower score is
/// better. Score direction is consulted at exactly one point: wherever
/// `position` is computed from a raw score.
model SportEventParticipantStanding {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String                    @unique @map("sport_event_participant_id") @db.Uuid
  position                Int?
  displayPosition         String?                   @map("display_position") @db.VarChar(20)
  status                  ParticipantStandingStatus @default(ACTIVE)
  asOf                    DateTime?                 @map("as_of") @db.Timestamptz
  currentRound            Int?                      @map("current_round")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant              @relation(fields: [sportEventParticipantId], references: [id])
  golf                  SportEventParticipantGolfStanding?

  @@index([status])
  @@index([position])
  @@map("sport_event_participant_standings")
}

/// Golf extension of SportEventParticipantStanding: the running event totals
/// one golfer's position was ranked from. Keyed 1:1 to the core standing row.
model SportEventParticipantGolfStanding {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standingId       String   @unique @map("standing_id") @db.Uuid
  eventScoreToPar  Int      @map("event_score_to_par")
  eventStrokes     Int      @map("event_strokes")
  currentRoundThru Int?     @map("current_round_thru")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  standing SportEventParticipantStanding @relation(fields: [standingId], references: [id])

  @@map("sport_event_participant_golf_standings")
}

/// Per-event tier definition, cross-sport. Event-level only — no contest
/// override (plans/124 §4.6). Tier count is however many rows exist for the
/// event, not a separate parameter (§4.5a).
model SportEventTier {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId     String   @map("sport_event_id") @db.Uuid
  tierKey          String   @map("tier_key") @db.VarChar(50)
  label            String   @db.VarChar(100)
  tierNumber       Int      @map("tier_number")
  defaultPickCount Int      @map("default_pick_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent SportEvent                       @relation(fields: [sportEventId], references: [id])
  valuations SportEventParticipantValuation[]

  @@unique([sportEventId, tierKey])
  @@unique([sportEventId, tierNumber])
  @@map("sport_event_tiers")
}

/// The tier and/or price for one participant in one event, cross-sport — one
/// row per SportEventParticipant, the same 1:1 shape as ranking/oddsToWin/
/// seedNumber living there (plans/124 §4.5/§4.6b).
model SportEventParticipantValuation {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String           @unique @map("sport_event_participant_id") @db.Uuid
  sportEventTierId        String?          @map("sport_event_tier_id") @db.Uuid
  tierOrderIndex          Int?             @map("tier_order_index")
  tierAssignedSource      ValuationSource? @map("tier_assigned_source")
  price                   Decimal?         @db.Decimal(10, 2)
  priceAssignedSource     ValuationSource? @map("price_assigned_source")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])
  sportEventTier        SportEventTier?       @relation(fields: [sportEventTierId], references: [id])

  @@index([sportEventTierId, tierOrderIndex])
  @@map("sport_event_participant_valuations")
}

model ProviderSyncRun {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String    @map("provider_id") @db.VarChar(100)
  sport       String    @db.VarChar(50)
  eventId     String?   @map("event_id") @db.VarChar(255)
  status      String    @db.VarChar(50)
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  payloadJson Json      @default("{}") @map("payload_json")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([sport, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("provider_sync_runs")
}

// =============================================================================
// Platform
// =============================================================================

model PlatformRuntimeConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configJson  Json     @map("config_json")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_runtime_configs")
}
