generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserAuthProvider {
  EMAIL  @map("email")
  GOOGLE @map("google")
  APPLE  @map("apple")
}

enum UserTimeFormat {
  TWELVE_HOUR      @map("12H")
  TWENTY_FOUR_HOUR @map("24H")
}

enum UserDateFormat {
  MDY
  DMY
  YMD
}

enum PrismaLeagueJoinPolicy {
  COMMISSIONER_ONLY
  LINK_INVITE
  OPEN
}

