/// Why a SportEventParticipant is inactive. Cross-sport: a golfer who misses
/// the cut, a knocked-out seed and an eliminated driver are all ELIMINATED; a
/// golf surface renders ELIMINATED as "Cut" for its audience. null means
/// "inactive, no more specific reason recorded" — there is no OTHER.
enum ParticipantInactiveReason {
  WITHDRAWN
  ELIMINATED
}

enum PrismaSportEventSyncScope {
  NONE
  SCORES_ONLY
}

/// How a SportEventParticipantValuation's tier or price was set.
enum ValuationSource {
  AUTO_ODDS
  AUTO_RANKING
  MANUAL
}

/// A participant's live state within one event. Cross-sport: ELIMINATED covers
/// a golfer who missed the cut as well as a knocked-out team.
enum ParticipantStandingStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETE
  WITHDRAWN
  ELIMINATED
}

// =============================================================================
// Substrate redesign — pool-master-rop.78 / Phase 4 (rop.78.4)
// =============================================================================

/// The sports PoolMaster runs contests for (#603, #605). Members mirror the domain `Sport`
/// const; a sport arrives with the migration and code that support it.
enum PrismaSport {
  GOLF
  HORSE_RACING
  AUTO_RACING
  CYCLING
  RUNNING
  BASKETBALL
  AMERICAN_FOOTBALL
  HOCKEY
  BASEBALL
  SOCCER
  TENNIS
}

/// Tournament structural format — drives which contest types are valid
/// pool formats for a given Sport. Composes with category to form the
/// (sport × pool format) compatibility matrix in shared/domain.
enum PrismaTournamentFormat {
  STROKE_PLAY_TOURNAMENT
  /// One race: one field, one finishing order (#623).
  RACE
  /// Games between two sides (#698; KNOCKOUT_BRACKET until #715). Whether they form a bracket
  /// is read from the match links.
  MATCHES
}

/// Where one match stands (#698). Mirrors the domain `MatchStatus`.
enum PrismaMatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// One side of a match (#698). Mirrors the domain `MatchSide`; on a neutral site HOME is the
/// upper line of the bracket.
enum PrismaMatchSide {
  HOME
  AWAY
}

/// How a match with a result ended (#704). Mirrors the domain `MatchEnding`.
enum PrismaMatchEnding {
  PLAYED
  RETIREMENT
  WALKOVER
  DEFAULT
}

/// What one game pick says happens (#792). Mirrors the domain `PredictedResult`.
enum PrismaPredictedResult {
  TEAM
  TIE
}

/// How a sport league's bracket winners reach their next match (#722). Mirrors the domain
/// `BracketAdvancement`.
enum PrismaBracketAdvancement {
  FIXED
  RESEED_BY_SEED
}

/// The periods a sport league's games are played in, when not its sport's (#786). Mirrors the
/// domain `MatchPeriodLayout`.
enum PrismaMatchPeriodLayout {
  QUARTERS
  HALVES
  THREE_PERIODS
}

/// What screens call a sport league when its sport's noun does not fit (#834). Mirrors the domain
/// `SportLeagueNoun`.
enum PrismaSportLeagueNoun {
  LEAGUE
}

/// How one field member's race ended (#622). Mirrors the domain `RaceResultStatus`. Only a
/// FINISHED runner has a finishing place; every other status scores the contest's
/// "did not finish" points.
enum RaceResultStatus {
  FINISHED
  DID_NOT_FINISH
  DISQUALIFIED
  DID_NOT_START
}

/// Contest format — the pool format applied to a SportEvent. Validity vs.
/// tournamentFormat is enforced by the const map in packages/shared/domain
/// (see plans/117 §9). Replaces the legacy `ContestType.SINGLE_EVENT` enum
/// which was a duration/scope concept that turned out not to be load-bearing.
/// Multi-event contest coverage will be re-modeled when a real multi-event
/// contest type is built (the speculative ContestSportEvent M:N join that
/// once anticipated it was removed as dead scaffolding — plans/124 §4.11).
enum PrismaContestFormat {
  ROSTER
  PREDICTION
  SQUARES
}

// #186: the lifecycle and discriminator columns below were free text until each
// got a Postgres enum. Members mirror the domain const of the same name in
// packages/shared/domain/enums.ts (without the Prisma prefix).

enum PrismaContestStatus {
  DRAFT
  OPEN
  ACTIVE
  COMPLETED
}

/// The kind of event a contest template is offered for (#802). Mirrors the domain
/// `ContestTemplateEventType`.
enum PrismaContestTemplateEventType {
  KNOCKOUT
  WEEK
}

enum PrismaSelectionType {
  TIERED
  BUDGET_PICK
  RANDOM_DRAW
  PICK_EM
  BRACKET
  SURVIVOR
  SQUARES
}

enum PrismaPrizePayoutType {
  FIXED_AMOUNT
  PERCENTAGE
}

/// DRAFT until its owner submits a valid lineup (#481); only SUBMITTED entries count anywhere.
enum PrismaContestEntryStatus {
  DRAFT
  SUBMITTED
}

enum PrismaParticipantRoundStatus {
  IN_PROGRESS
  COMPLETED
  DNF
  DSQ
  MISSED_CUT
}

enum PrismaProviderSyncRunStatus {
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// =============================================================================
// UTC Storage Convention
// =============================================================================
//
// ALL timestamps in this schema are stored as UTC.
//
// - Every DateTime column uses @db.Timestamptz (PostgreSQL `timestamptz`).
// - Application code MUST write UTC values — never local times.
// - Timezone conversion is a **display concern** handled by the client using
//   the user's persisted account timezone or the league default timezone when
//   it exists.
// - Resolution order: user timezone > league timezone.
//
// See plans/14-poolmaster-localisation-i18n.md for the full timezone strategy.
// =============================================================================

// =============================================================================
// Identity
// =============================================================================

model User {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String            @unique
  username     String            @unique @db.VarChar(100)
  passwordHash String?           @map("password_hash")
  firstName    String            @map("first_name") @db.VarChar(100)
  lastName     String            @map("last_name") @db.VarChar(100)
  isActive     Boolean           @default(true) @map("is_active")
  authProvider UserAuthProvider? @map("auth_provider")
  authId       String?           @map("auth_id")
  isRootAdmin  Boolean           @default(false) @map("is_root_admin")
  timezone     String?           @db.VarChar(50)
  locale       String?           @default("en-US") @db.VarChar(10)
  timeFormat   UserTimeFormat?   @default(TWELVE_HOUR) @map("time_format")
  dateFormat   UserDateFormat?   @default(MDY) @map("date_format")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  memberships                   LeagueMembership[]
  createdSquads                 Squad[]                @relation("SquadCreatedBy")
  squadMemberships              SquadMembership[]
  invitationsSent               LeagueInvitation[]     @relation("InvitedBy")
  invitationsAccepted           LeagueInvitation[]     @relation("AcceptedBy")
  squadOwnerInvitationsSent     SquadOwnerInvitation[] @relation("SquadOwnerInvitedBy")
  squadOwnerInvitationsAccepted SquadOwnerInvitation[] @relation("SquadOwnerAcceptedBy")

  contestDraws        ContestDraw[]
  squaresClaimed      ContestEntrySquare[]
  squaresDrawn        ContestSquaresDraw[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailMessages       EmailMessage[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique
  sessionId String    @default(uuid()) @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

/// A "Forgot password?" link (#847, plans/password-recovery.md). Only the SHA-256 of the
/// token is stored, so a database read cannot reset anybody. A link is live while it is
/// unused, not cancelled and not expired; a newer request or a password change cancels it.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// =============================================================================
// League
// =============================================================================

model League {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueCode  String              @unique @map("league_code") @db.VarChar(16)
  name        String
  description String?
  isActive    Boolean             @default(true) @map("is_active")
  iconKey     PrismaLeagueIconKey @default(TROPHY) @map("icon_key")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  memberships           LeagueMembership[]
  squads                Squad[]
  squadMemberships      SquadMembership[]
  contests              Contest[]
  invitations           LeagueInvitation[]
  squadOwnerInvitations SquadOwnerInvitation[]
  emailMessages         EmailMessage[]

  @@map("leagues")
}

model LeagueMembership {
  id        String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId  String                       @map("league_id") @db.Uuid
  userId    String                       @map("user_id") @db.Uuid
  role      PrismaLeagueRole             @default(MEMBER)
  status    PrismaLeagueMembershipStatus @default(ACTIVE)
  joinedAt  DateTime                     @default(now()) @map("joined_at") @db.Timestamptz
  createdAt DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([leagueId, userId])
  @@index([leagueId, status])
  @@map("league_memberships")
}

model Squad {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId  String             @map("league_id") @db.Uuid
  createdBy String             @map("created_by") @db.Uuid
  name      String
  iconKey   PrismaSquadIconKey @default(CAPTAIN_SMILE_FIELD) @map("icon_key")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  league           League                 @relation(fields: [leagueId], references: [id])
  creator          User                   @relation("SquadCreatedBy", fields: [createdBy], references: [id])
  memberships      SquadMembership[]
  entries          ContestEntry[]
  ownerInvitations SquadOwnerInvitation[]

  @@unique([leagueId, name])
  @@index([leagueId, isActive])
  @@map("squads")
}

model SquadMembership {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  squadId   String                      @map("squad_id") @db.Uuid
  leagueId  String                      @map("league_id") @db.Uuid
  userId    String                      @map("user_id") @db.Uuid
  status    PrismaSquadMembershipStatus @default(ACTIVE)
  joinedAt  DateTime                    @default(now()) @map("joined_at") @db.Timestamptz
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  squad  Squad  @relation(fields: [squadId], references: [id])
  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([squadId, userId])
  @@unique([leagueId, userId])
  @@index([squadId, status])
  @@map("squad_memberships")
}

model LeagueInvitation {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId    String                       @map("league_id") @db.Uuid
  email       String?                      @db.VarChar(255)
  inviteCode  String                       @unique @map("invite_code") @db.VarChar(100)
  inviteType  PrismaLeagueInviteType       @default(EMAIL) @map("invite_type")
  status      PrismaLeagueInvitationStatus @default(PENDING)
  maxUses     Int                          @default(1) @map("max_uses")
  currentUses Int                          @default(0) @map("current_uses")
  invitedBy   String                       @map("invited_by") @db.Uuid
  expiresAt   DateTime?                    @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?                    @map("accepted_at") @db.Timestamptz
  acceptedBy  String?                      @map("accepted_by") @db.Uuid
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  league   League @relation(fields: [leagueId], references: [id])
  inviter  User   @relation("InvitedBy", fields: [invitedBy], references: [id])
  acceptor User?  @relation("AcceptedBy", fields: [acceptedBy], references: [id])

  emailMessages EmailMessage[]

  @@index([leagueId, status])
  @@map("league_invitations")
}

/// One system email to one person (#844): queued and sent by the sender, or skipped with the
/// reason. A check constraint holds skip_reason to exactly the SKIPPED rows.
model EmailMessage {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey       PrismaEmailTemplateKey   @map("template_key")
  recipientUserId   String?                  @map("recipient_user_id") @db.Uuid
  recipientEmail    String                   @map("recipient_email") @db.VarChar(255)
  leagueId          String?                  @map("league_id") @db.Uuid
  contestId         String?                  @map("contest_id") @db.Uuid
  entryId           String?                  @map("entry_id") @db.Uuid
  invitationId      String?                  @map("invitation_id") @db.Uuid
  idempotencyKey    String                   @unique @map("idempotency_key")
  fromName          String                   @map("from_name") @db.VarChar(255)
  fromAddress       String                   @map("from_address") @db.VarChar(255)
  subject           String?
  textBody          String?                  @map("text_body")
  htmlBody          String?                  @map("html_body")
  status            PrismaEmailMessageStatus
  skipReason        PrismaEmailSkipReason?   @map("skip_reason")
  attempts          Int                      @default(0)
  nextAttemptAt     DateTime?                @map("next_attempt_at") @db.Timestamptz
  lastError         String?                  @map("last_error")
  providerMessageId String?                  @map("provider_message_id") @db.VarChar(255)
  sentAt            DateTime?                @map("sent_at") @db.Timestamptz
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  // Deleting an account deletes the emails it was sent; deleting what an email is about keeps it.
  recipient  User?             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  league     League?           @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  contest    Contest?          @relation(fields: [contestId], references: [id], onDelete: SetNull)
  entry      ContestEntry?     @relation(fields: [entryId], references: [id], onDelete: SetNull)
  invitation LeagueInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([invitationId, createdAt])
  @@index([createdAt])
  @@map("email_messages")
}

model SquadOwnerInvitation {
  id                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId             String                           @map("league_id") @db.Uuid
  squadId              String                           @map("squad_id") @db.Uuid
  email                String                           @db.VarChar(255)
  inviteCode           String                           @unique @map("invite_code") @db.VarChar(100)
  status               PrismaSquadOwnerInvitationStatus @default(PENDING)
  invitedBy            String                           @map("invited_by") @db.Uuid
  expiresAt            DateTime?                        @map("expires_at") @db.Timestamptz
  acceptedAt           DateTime?                        @map("accepted_at") @db.Timestamptz
  acceptedBy           String?                          @map("accepted_by") @db.Uuid
  replacementForUserId String?                          @map("replacement_for_user_id") @db.Uuid
  createdAt            DateTime                         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                         @updatedAt @map("updated_at") @db.Timestamptz

  league   League @relation(fields: [leagueId], references: [id])
  squad    Squad  @relation(fields: [squadId], references: [id])
  inviter  User   @relation("SquadOwnerInvitedBy", fields: [invitedBy], references: [id])
  acceptor User?  @relation("SquadOwnerAcceptedBy", fields: [acceptedBy], references: [id])

  @@index([leagueId, status])
  @@index([squadId, status])
  @@map("squad_owner_invitations")
}

// =============================================================================
// Sport & Participant
// =============================================================================

model Sport {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Which sport this row is (#603). One row per built sport, seeded by the
  /// migration that adds the sport's support.
  sport            PrismaSport            @unique
  participantType  PrismaParticipantType  @map("participant_type")
  /// No default (#236): the table that discriminates between sports must not
  /// make a row a stroke-play golf sport by omission. Creators take it from
  /// DEFAULT_TOURNAMENT_FORMAT_BY_SPORT.
  tournamentFormat PrismaTournamentFormat @map("tournament_format")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  participants Participant[]
  sportLeagues SportLeague[]

  @@map("sports")
}

/// A real-world sport league/tour/conference — PGA Tour, LIV Golf, LPGA Tour
/// for golf; NBA, NCAA Basketball for basketball; etc. Cross-sport by design
/// (sportId scopes it), not golf-specific. Named SportLeague, not League,
/// because League is already the PoolMaster office-pool model. See plans/124
/// §4.2 design note.
model SportLeague {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportId            String                   @map("sport_id") @db.Uuid
  name               String                   @db.VarChar(255)
  matchKeyword       String?                  @map("match_keyword") @db.VarChar(255)
  /// The event year the tour is currently on — a business pointer, not a foreign
  /// key: "set as current" refuses a year with no events for this tour, which is the
  /// integrity the season FK used to give (plans/147 decision 6).
  currentEventYear   Int?                     @map("current_event_year")
  isActive           Boolean                  @default(true) @map("is_active")
  /// How a bracket's winners reach their next match (#722): by fixed links, or reseeded by seed
  /// after a round (the NFL). Only a sport played as a bracket reads it.
  bracketAdvancement PrismaBracketAdvancement @default(FIXED) @map("bracket_advancement")
  /// What the sport league calls its bracket's rounds, first to final (#706: the NBA's First Round,
  /// Conference Semifinals, Conference Finals, NBA Finals). Empty: the sport's names are used.
  /// Reference data, set by the migration that seeds the league.
  roundNames         String[]                 @default([]) @map("round_names")
  /// How many tiers a new event of the sport league starts with (#707: the College Football
  /// Playoff's 12 teams in six tiers of two). Null: the sport's default tier count. Reference
  /// data, set by the migration that seeds the league.
  tierCount          Int?                     @map("tier_count")
  /// The periods its games are played in, when not its sport's (#786: men's college basketball
  /// plays halves). Null: the sport's layout. Reference data, set by the migration that seeds the
  /// league.
  matchPeriodLayout  PrismaMatchPeriodLayout? @map("match_period_layout")
  /// The first round whose matches are single games a squares pool can be played on, when not
  /// every round's are (#787: a Champions League two-legged tie or an MLS best-of-three series
  /// is one match with no half-time score). Null: every round. Reference data, set by the
  /// migration that seeds the league.
  squaresFromRound   Int?                     @map("squares_from_round")
  /// What screens call the sport league, when not what its sport calls one (#834: the NCAA's
  /// tennis championships are leagues, not tours). Null: the sport's noun. Reference data, set by
  /// the migration that seeds the league.
  noun               PrismaSportLeagueNoun?   @map("noun")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  sport                  Sport                          @relation(fields: [sportId], references: [id])
  affiliations           ParticipantLeagueAffiliation[]
  eventSeries            EventSeries[]
  contestConfigTemplates ContestConfigTemplate[]

  @@unique([sportId, name])
  @@map("sport_leagues")
}

/// A recurring, named tournament that repeats year after year under one
/// stable identity — "The Masters," "The US Open" — separate from any one
/// year's SportEvent edition of it. SportEvent rows point here; this never
/// points to a specific year. Auto-resolved by find-or-create on
/// (sportLeagueId, name) at tournament creation — no new admin decision
/// (plans/124 §4.3a). See plans/147.
model EventSeries {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportLeagueId String   @map("sport_league_id") @db.Uuid
  name          String
  /// A dimension's lifecycle, like SportLeague's: false retires the series
  /// without touching its past editions (plans/147 decision 9).
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague SportLeague  @relation(fields: [sportLeagueId], references: [id])
  sportEvents SportEvent[]

  @@unique([sportLeagueId, name])
  @@map("event_series")
}

/// Which participants are currently affiliated with which sport league, plus
/// their current ranking there. Sport-league-scoped, not season-scoped — a
/// competitor's membership and ranking don't reset every year. Current value
/// only, no history. See plans/124 §4.2.
model ParticipantLeagueAffiliation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  sportLeagueId String   @map("sport_league_id") @db.Uuid
  /// The competitor's current rank in this sport league (1 is best).
  ranking       Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  participant Participant @relation(fields: [participantId], references: [id])
  sportLeague SportLeague @relation(fields: [sportLeagueId], references: [id])

  @@unique([participantId, sportLeagueId])
  @@index([sportLeagueId, ranking])
  @@map("participant_league_affiliations")
}

model Participant {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportId         String                @map("sport_id") @db.Uuid
  name            String
  participantType PrismaParticipantType @map("participant_type")
  externalId      String?               @map("external_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  // Enriched profile fields (Plan 05)
  firstName        String?                 @map("first_name")
  lastName         String?                 @map("last_name")
  shortName        String?                 @map("short_name") @db.VarChar(100)
  nationality      String?                 @db.VarChar(10)
  /// Playing role ("GOLFER", "QB"), not a rank — `position` means rank on the standing tables.
  role             String?                 @db.VarChar(50)
  teamAffiliation  String?                 @map("team_affiliation")
  status           PrismaParticipantStatus @default(ACTIVE)
  injuryStatus     Json                    @default("{\"status\": \"HEALTHY\"}") @map("injury_status")
  photoUrl         String?                 @map("photo_url")
  photoLastUpdated DateTime?               @map("photo_last_updated") @db.Timestamptz
  externalIds      Json                    @default("{}") @map("external_ids")

  sport                  Sport                          @relation(fields: [sportId], references: [id])
  providerMappings       ParticipantProviderMapping[]
  sportEventParticipants SportEventParticipant[]
  leagueAffiliations     ParticipantLeagueAffiliation[]

  @@index([sportId])
  @@index([sportId, status])
  @@map("participants")
}

model ParticipantProviderMapping {
  id            String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String                             @map("participant_id") @db.Uuid
  providerId    String                             @map("provider_id") @db.VarChar(100)
  externalId    String                             @map("external_id") @db.VarChar(255)
  confidence    PrismaParticipantMappingConfidence @default(EXACT)
  mappedAt      DateTime                           @default(now()) @map("mapped_at") @db.Timestamptz
  createdAt     DateTime                           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                           @updatedAt @map("updated_at") @db.Timestamptz

  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([providerId, externalId])
  @@index([participantId])
  @@map("participant_provider_mappings")
}

// =============================================================================
// Contest
// =============================================================================

model Contest {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId      String              @map("league_id") @db.Uuid
  name          String
  status        PrismaContestStatus @default(DRAFT)
  contestFormat PrismaContestFormat @default(ROSTER) @map("contest_format")
  selectionType PrismaSelectionType @map("selection_type")
  startsAt      DateTime?           @map("starts_at") @db.Timestamptz
  endsAt        DateTime?           @map("ends_at") @db.Timestamptz
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  league              League                      @relation(fields: [leagueId], references: [id])
  sportEvents         ContestSportEvent[]
  configuration       ContestConfiguration?
  entries             ContestEntry[]
  entryStandings      ContestEntryStanding[]
  entryEventStandings ContestEntryEventStanding[]
  draw                ContestDraw?
  squaresGame         ContestSquaresGame?
  squares             ContestEntrySquare[]
  squaresDraw         ContestSquaresDraw?
  squaresWinners      ContestSquaresWinner[]
  emailMessages       EmailMessage[]

  @@index([leagueId])
  @@index([status])
  @@map("contests")
}

// One event a contest covers (#713). Every contest has at least one: a golf or race contest has
// one row, a majors pool or a pick'em season one per event. `sequence` is the events' order by
// start, which the server keeps when the commissioner adds or removes events.
model ContestSportEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId    String   @map("contest_id") @db.Uuid
  sportEventId String   @map("sport_event_id") @db.Uuid
  sequence     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  contest    Contest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  sportEvent SportEvent @relation(fields: [sportEventId], references: [id])

  @@unique([contestId, sportEventId])
  @@unique([contestId, sequence])
  @@index([sportEventId])
  @@map("contest_sport_events")
}

model ContestConfiguration {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId            String              @unique @map("contest_id") @db.Uuid
  templateId           String?             @map("template_id") @db.Uuid
  templateVersion      Int?                @map("template_version")
  selectionType        PrismaSelectionType @map("selection_type")
  configJson           Json?               @map("config_json")
  minimumEntries       Int?                @map("minimum_entries")
  maxEntriesPerSquad   Int?                @map("max_entries_per_squad")
  totalPrizePoolAmount Float?              @map("total_prize_pool_amount")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  contest                 Contest                         @relation(fields: [contestId], references: [id])
  template                ContestConfigTemplate?          @relation(fields: [templateId], references: [id])
  participantScoringRules ParticipantContestScoringRule[]
  prizeDefinitions        ContestPrizeDefinition[]

  @@map("contest_configurations")
}

model ContestConfigTemplate {
  id               String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sport            PrismaSport
  /// The sport league whose events this template is offered for — a league's own official
  /// preset (NASCAR, IndyCar, F1 points). Null offers it for every league of its sport.
  sportLeagueId    String?                         @map("sport_league_id") @db.Uuid
  /// The kind of event the template is offered for (#802): KNOCKOUT or WEEK for a sport played as
  /// matches. Null offers it for every event of its sport.
  eventType        PrismaContestTemplateEventType? @map("event_type")
  contestFormat    PrismaContestFormat             @map("contest_type")
  /// A `SelectionType` value: how an entry in a contest created from this template picks.
  selectionType    PrismaSelectionType             @map("selection_type")
  templateKey      String                          @map("template_key") @db.VarChar(100)
  name             String                          @db.VarChar(120)
  description      String                          @db.VarChar(500)
  sortOrder        Int                             @map("sort_order")
  isDefault        Boolean                         @default(false) @map("is_default")
  active           Boolean                         @default(true)
  configJson       Json                            @map("config_json")
  schemaVersion    Int                             @default(1) @map("schema_version")
  /// The event series a contest made from this template covers (#714: the four majors), by name
  /// in its sport league. A contest takes each series' edition of its year as it is released.
  /// Empty: the commissioner adds the contest's events.
  eventSeriesNames String[]                        @default([]) @map("event_series_names")
  createdAt        DateTime                        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                        @updatedAt @map("updated_at") @db.Timestamptz

  sportLeague    SportLeague?           @relation(fields: [sportLeagueId], references: [id], onDelete: Restrict)
  configurations ContestConfiguration[]

  @@unique([sport, eventType, contestFormat, selectionType, templateKey])
  @@index([sport, contestFormat, active, sortOrder])
  @@index([sportLeagueId])
  @@map("contest_config_templates")
}

model ParticipantContestScoringRule {
  id                             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestConfigurationId         String   @map("contest_configuration_id") @db.Uuid
  participantScoringDefinitionId String   @map("participant_scoring_definition_id") @db.VarChar(100)
  sortOrder                      Int      @map("sort_order")
  config                         Json     @default("{}")
  active                         Boolean  @default(true)
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contestConfiguration ContestConfiguration @relation(fields: [contestConfigurationId], references: [id])

  @@unique([contestConfigurationId, sortOrder])
  @@index([contestConfigurationId])
  @@map("participant_contest_scoring_rules")
}

model ContestPrizeDefinition {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestConfigurationId String                 @map("contest_configuration_id") @db.Uuid
  prizeDefinitionId      String                 @map("prize_definition_id") @db.VarChar(100)
  displayName            String                 @map("display_name") @db.VarChar(100)
  sortOrder              Int                    @map("sort_order")
  ruleConfig             Json                   @default("{}") @map("rule_config")
  payoutType             PrismaPrizePayoutType? @map("payout_type")
  amount                 Float?
  percentage             Float?
  active                 Boolean                @default(true)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  contestConfiguration ContestConfiguration @relation(fields: [contestConfigurationId], references: [id])

  @@unique([contestConfigurationId, sortOrder])
  @@index([contestConfigurationId])
  @@map("contest_prize_definitions")
}

// =============================================================================
// Entry & Picks
// =============================================================================

model ContestEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId       String   @map("contest_id") @db.Uuid
  squadId         String   @map("squad_id") @db.Uuid
  entryNumber     Int      @default(1) @map("entry_number")
  name            String
  tiebreakerValue Int?     @map("tiebreaker_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contest Contest @relation(fields: [contestId], references: [id])
  squad   Squad   @relation(fields: [squadId], references: [id])

  picks          ContestEntryPick[]
  events         ContestEntryEvent[]
  predictions    ContestEntryMatchPrediction[]
  standing       ContestEntryStanding?
  eventStandings ContestEntryEventStanding[]
  squares        ContestEntrySquare[]
  squaresWon     ContestSquaresWinner[]
  emailMessages  EmailMessage[]

  @@unique([contestId, squadId, entryNumber])
  // The key a claimed box's (contest, entry) foreign key names, so a box's entry is its contest's.
  @@unique([id, contestId])
  @@map("contest_entries")
}

// An entry's draft/submitted status for one event of its contest (#713, design Q5.4): "submit
// week 6", "submit your Masters picks". One row per event of the contest, created with the entry
// and when an event is added; only an event the entry submitted counts.
model ContestEntryEvent {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestEntryId  String                   @map("contest_entry_id") @db.Uuid
  sportEventId    String                   @map("sport_event_id") @db.Uuid
  status          PrismaContestEntryStatus @default(DRAFT)
  submittedAt     DateTime?                @map("submitted_at") @db.Timestamptz
  /// A prediction contest's tiebreaker for the event (#717): the guessed total points of its
  /// tiebreaker game (a pick'em week's last game, a bracket's final).
  tiebreakerValue Int?                     @map("tiebreaker_value")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  contestEntry ContestEntry @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  sportEvent   SportEvent   @relation(fields: [sportEventId], references: [id])

  @@unique([contestEntryId, sportEventId])
  @@index([sportEventId])
  @@map("contest_entry_events")
}

/// A prediction contest entry's pick of one game (#716): the team it says wins, or a tie (#792),
/// and in a confidence pool how sure it is (1 to the week's number of games, each once by
/// submit). One per entry per game. Database checks: `confidence` is at least 1, and the team is
/// named exactly when `predictedResult` is TEAM. That the team plays in the game, that the pool
/// takes a tie, and that the game is still open are the prediction service's checks.
model ContestEntryMatchPrediction {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestEntryId          String                @map("contest_entry_id") @db.Uuid
  sportEventMatchId       String                @map("sport_event_match_id") @db.Uuid
  predictedResult         PrismaPredictedResult @default(TEAM) @map("predicted_result")
  /// The team picked to win; null for a tie pick.
  sportEventParticipantId String?               @map("sport_event_participant_id") @db.Uuid
  confidence              Int?
  pickedAt                DateTime              @map("picked_at") @db.Timestamptz
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  contestEntry          ContestEntry           @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  sportEventMatch       SportEventMatch        @relation(fields: [sportEventMatchId], references: [id], onDelete: Restrict)
  sportEventParticipant SportEventParticipant? @relation(fields: [sportEventParticipantId], references: [id], onDelete: Restrict)

  @@unique([contestEntryId, sportEventMatchId])
  @@index([sportEventMatchId])
  @@index([sportEventParticipantId])
  @@map("contest_entry_match_predictions")
}

/// A contest entry's standing, frozen when its contest settles — cross-sport.
///
/// Written once per entry by settlement when the linked SportEvent completes, and read by
/// the leaderboard of a COMPLETED contest instead of recomputing from live event scores:
/// a provider correction after settlement must not silently rewrite a finished result.
/// `position` is direction-free (1 is best), as on SportEventParticipantStanding. `totalScore`
/// is the entry's settled total that position was ranked from, in the unit of the contest's
/// scoring definition (golf's to-par total, a race's points); null while unscored. Every scoring
/// family stores it here, so no family keeps a settled-total table of its own (#695).
///
/// `countingPickLimit` is the rule's N captured at settlement (best N picks count).
/// Configuration stays editable after a contest is reopened, so without it a frozen result
/// could not be explained. `contestId` is a documented denormalization of
/// `contestEntry.contestId`: the leaderboard read is per contest and this table's primary
/// access path, so it gets a covering index instead of a join. Settlement's upsert is its
/// single writer.
model ContestEntryStanding {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId         String    @map("contest_id") @db.Uuid
  contestEntryId    String    @unique @map("contest_entry_id") @db.Uuid
  position          Int?
  displayPosition   String?   @map("display_position") @db.VarChar(20)
  countingPickLimit Int       @map("counting_pick_limit")
  scoredPickCount   Int       @map("scored_pick_count")
  totalScore        Int?      @map("total_score")
  asOf              DateTime? @map("as_of") @db.Timestamptz
  settledAt         DateTime  @map("settled_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)

  @@index([contestId, position])
  @@map("contest_entry_standings")
}

// An entry's settled result in one event of its contest (#713): the weekly winner in pick'em,
// one major's result in a majors pool. The contest total stays on ContestEntryStanding; the
// columns mirror it, narrowed to the event. Written only by settlement, when the event completes.
model ContestEntryEventStanding {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId         String    @map("contest_id") @db.Uuid
  contestEntryId    String    @map("contest_entry_id") @db.Uuid
  sportEventId      String    @map("sport_event_id") @db.Uuid
  position          Int?
  displayPosition   String?   @map("display_position") @db.VarChar(20)
  countingPickLimit Int       @map("counting_pick_limit")
  scoredPickCount   Int       @map("scored_pick_count")
  totalScore        Int?      @map("total_score")
  asOf              DateTime? @map("as_of") @db.Timestamptz
  settledAt         DateTime  @map("settled_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  sportEvent   SportEvent   @relation(fields: [sportEventId], references: [id])

  @@unique([contestEntryId, sportEventId])
  @@index([contestId, sportEventId, position])
  @@map("contest_entry_event_standings")
}

/// A random-draw contest's draw (#601): the commissioner's one explicit "Run draw", which dealt
/// every entry its picks. Its existence closes the contest's entries and reveals its picks.
///
/// Kept so the draw can be shown and replayed: the seed, and the orders the seeded shuffle put
/// the field (`sport_event_participants` ids) and the entries in. Dealing round-robin from
/// those two orders reproduces every pick. One per contest; the unique key is what stops two
/// presses racing from dealing twice.
model ContestDraw {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId     String   @unique @map("contest_id") @db.Uuid
  seed          String   @db.VarChar(64)
  fieldOrder    String[] @map("field_order") @db.Uuid
  entryOrder    String[] @map("entry_order") @db.Uuid
  drawnByUserId String?  @map("drawn_by_user_id") @db.Uuid
  drawnAt       DateTime @default(now()) @map("drawn_at") @db.Timestamptz

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  drawnBy User?   @relation(fields: [drawnByUserId], references: [id], onDelete: SetNull)

  @@map("contest_draws")
}

/// The one game a squares contest is played on (#711): one of the contest's event's matches,
/// chosen at setup and changeable while the contest is a draft. Its kickoff closes the contest.
model ContestSquaresGame {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId         String   @unique @map("contest_id") @db.Uuid
  sportEventMatchId String   @map("sport_event_match_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contest         Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  sportEventMatch SportEventMatch @relation(fields: [sportEventMatchId], references: [id], onDelete: Restrict)

  @@index([sportEventMatchId])
  @@map("contest_squares_games")
}

/// One claimed box of a squares grid (#711): a grid position, not a digit, so a box can be
/// claimed before the digits are drawn. Only claimed boxes have a row; the reader draws the other
/// boxes of the 10x10 grid empty. The unique key on (contest, row, column) is what stops two
/// people taking one box at once; `contestId` is the entry's, kept in step by the composite key.
model ContestEntrySquare {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId       String   @map("contest_id") @db.Uuid
  contestEntryId  String   @map("contest_entry_id") @db.Uuid
  rowIndex        Int      @map("row_index")
  columnIndex     Int      @map("column_index")
  claimedByUserId String?  @map("claimed_by_user_id") @db.Uuid
  claimedAt       DateTime @default(now()) @map("claimed_at") @db.Timestamptz

  contest      Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry @relation(fields: [contestEntryId, contestId], references: [id, contestId], onDelete: Cascade)
  claimedBy    User?        @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@unique([contestId, rowIndex, columnIndex])
  @@index([contestEntryId])
  @@map("contest_entry_squares")
}

/// A squares contest's digits (#711): 0 to 9 shuffled once for the rows (the away team) and once
/// for the columns (the home team), replayable from the seed. Its existence closes claiming, as a
/// random draw's closes entries; the unique key stops two presses drawing twice.
model ContestSquaresDraw {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId     String   @unique @map("contest_id") @db.Uuid
  seed          String   @db.VarChar(64)
  rowDigits     Int[]    @map("row_digits")
  columnDigits  Int[]    @map("column_digits")
  drawnByUserId String?  @map("drawn_by_user_id") @db.Uuid
  drawnAt       DateTime @default(now()) @map("drawn_at") @db.Timestamptz

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  drawnBy User?   @relation(fields: [drawnByUserId], references: [id], onDelete: SetNull)

  @@map("contest_squares_draws")
}

/// Each scoring moment's winning box, frozen when a squares contest settles (#711, design Q3.7),
/// so a score correction after Final cannot move it. `periodNumber` runs 1 to the game's period
/// count, the last being the final score, overtime included. No entry when nobody held the box.
model ContestSquaresWinner {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId      String   @map("contest_id") @db.Uuid
  periodNumber   Int      @map("period_number")
  homeScore      Int      @map("home_score")
  awayScore      Int      @map("away_score")
  rowIndex       Int      @map("row_index")
  columnIndex    Int      @map("column_index")
  contestEntryId String?  @map("contest_entry_id") @db.Uuid
  settledAt      DateTime @map("settled_at") @db.Timestamptz

  contest      Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestEntry ContestEntry? @relation(fields: [contestEntryId], references: [id], onDelete: SetNull)

  @@unique([contestId, periodNumber])
  @@index([contestEntryId])
  @@map("contest_squares_winners")
}

/// A pick on a contest entry — references a SportEventParticipant.
/// Unified across contest formats: optional period / slot / tier / cost
/// fields disambiguate per-format usage. The `contestFormat` column is
/// denormalized from the parent Contest to enable per-format partial
/// unique indexes (see plans/117 §7.1).
model ContestEntryPick {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId                 String              @map("entry_id") @db.Uuid
  sportEventParticipantId String              @map("sport_event_participant_id") @db.Uuid
  contestFormat           PrismaContestFormat @map("contest_format")
  period                  Int?
  slot                    Int?
  tier                    String?             @db.VarChar(50)
  cost                    Decimal?            @db.Decimal(12, 2)
  isAutoPicked            Boolean             @default(false) @map("is_auto_picked")
  lineupSlot              Int?                @map("lineup_slot")
  pickSequence            Int?                @map("pick_sequence")
  pickedAt                DateTime            @default(now()) @map("picked_at") @db.Timestamptz
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  entry                 ContestEntry          @relation(fields: [entryId], references: [id])
  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])

  @@index([entryId])
  @@map("contest_entry_picks")
}

// =============================================================================
// Results
// =============================================================================

// =============================================================================
// Sports Data Integration (Plan 06)
// =============================================================================

model SportEvent {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId           String                    @map("external_id") @db.VarChar(255)
  providerId           String                    @map("provider_id") @db.VarChar(100)
  sport                PrismaSport
  name                 String                    @db.VarChar(500)
  venue                String?                   @db.VarChar(500)
  location             String?                   @db.VarChar(500)
  startDate            DateTime                  @map("start_date") @db.Timestamptz
  endDate              DateTime?                 @map("end_date") @db.Timestamptz
  status               PrismaSportEventStatus    @default(SCHEDULED)
  rounds               Int?
  // Par for every round of the event (#478), set by an admin. Null derives each
  // round's par from the field's finished rounds (strokes minus to-par). Read
  // only by contest scoring, to turn an unplayed round's 80 strokes into to-par.
  roundsPar            Int?                      @map("rounds_par")
  participantCount     Int?                      @map("participant_count")
  metadata             Json                      @default("{}")
  // The series this is one edition of — the event's only parent, and its only
  // path to a sport league (plans/147). Auto-resolved by find-or-create on
  // (sportLeagueId, name) at tournament creation, never an admin decision
  // (plans/124 §4.3a).
  eventSeriesId        String                    @map("event_series_id") @db.Uuid
  // The year the edition is branded with — "the 2026 Masters" — which is not
  // always the year it starts in; startDate carries the real dates (plans/147
  // decision 3).
  eventYear            Int                       @map("event_year")
  // Sync eligibility, separate from providerId/externalId identity: NONE for an
  // unlinked event, SCORES_ONLY once an admin links it to a provider event. Every
  // event is admin-owned; a provider never owns one (ADR-0009, #435).
  syncScope            PrismaSportEventSyncScope @default(NONE) @map("sync_scope")
  // Admin escape hatch: false stops the lifecycle scheduler (plans/124 §3.6)
  // from ever touching this event's status, no matter what the recorded
  // round schedule says — a rain delay, a dispute, etc.
  autoLifecycleEnabled Boolean                   @default(true) @map("auto_lifecycle_enabled")
  // The values the field was last priced with for budget contests (#93), typed by
  // EventPricingConfigSchema. Null until prices are assigned; written with the
  // prices in one transaction and locked with them at release.
  pricingConfig        Json?                     @map("pricing_config")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  contests                   ContestSportEvent[]
  contestEntryEvents         ContestEntryEvent[]
  contestEntryEventStandings ContestEntryEventStanding[]
  sportEventParticipants     SportEventParticipant[]
  tiers                      SportEventTier[]
  roundSchedule              SportEventRound[]
  matches                    SportEventMatch[]
  eventSeries                EventSeries                 @relation(fields: [eventSeriesId], references: [id])

  @@unique([providerId, externalId])
  // One edition of a series per year: there is one 2026 Masters (plans/147 decision 5).
  @@unique([eventSeriesId, eventYear])
  @@index([sport, status])
  @@index([startDate, endDate])
  @@map("sport_events")
}

model SportEventParticipant {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId   String                     @map("sport_event_id") @db.Uuid
  participantId  String                     @map("participant_id") @db.Uuid
  isActive       Boolean                    @default(true) @map("is_active")
  inactiveReason ParticipantInactiveReason? @map("inactive_reason")
  /// The rank that applied to this participant at this event (1 is best) —
  /// seeded from the provider or the sport-league affiliation, then editable.
  ranking        Int?
  oddsToWin      Decimal?                   @map("odds_to_win") @db.Decimal(10, 2)
  seedNumber     Int?                       @map("seed_number")
  /// A bracket place that stands for a play-in pairing ("Texas / Xavier") until its winner is
  /// known (#709). Only such a row can be filled; filling clears it.
  isPlayInPlace  Boolean                    @default(false) @map("is_play_in_place")
  metadata       Json                       @default("{}")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent  SportEvent                       @relation(fields: [sportEventId], references: [id])
  participant Participant                      @relation(fields: [participantId], references: [id])
  valuation   SportEventParticipantValuation?
  picks       ContestEntryPick[]
  rounds      SportEventParticipantRound[]
  standing    SportEventParticipantStanding?
  raceResult  SportEventParticipantRaceResult?
  homeMatches SportEventMatch[]                @relation("SportEventMatchHome")
  awayMatches SportEventMatch[]                @relation("SportEventMatchAway")
  predictions ContestEntryMatchPrediction[]

  @@unique([sportEventId, participantId])
  @@index([sportEventId])
  @@index([participantId])
  @@map("sport_event_participants")
}

/// A scheduled sub-period of a SportEvent with its own start/end time — a
/// golf tournament's Round 2, an NFL Week's set of games, a World Cup's
/// match day. Cross-sport by shape; plans/124 populates and uses it only for
/// golf rounds. Genuinely different from SportEventParticipantRound below:
/// this holds the round's own schedule, independent of any participant; that
/// one joins one participant to one round.
model SportEventRound {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId   String    @map("sport_event_id") @db.Uuid
  roundNumber    Int       @map("round_number")
  scheduledDate  DateTime  @map("scheduled_date") @db.Timestamptz
  scheduledEndAt DateTime? @map("scheduled_end_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent        SportEvent                   @relation(fields: [sportEventId], references: [id])
  participantRounds SportEventParticipantRound[]
  matches           SportEventMatch[]

  @@unique([sportEventId, roundNumber])
  @@map("sport_event_rounds")
}

/// One game or match of an event, played in one of its rounds (#698). Core event data, beside the
/// round schedule; a result is written by the head-to-head family. In a bracket it is also a slot:
/// `advancesToMatchId`/`advancesToSide` name where its winner goes (null for the final). A side is
/// a field row, null until decided. Database checks: the two sides differ, `advancesToSide` is set
/// exactly when `advancesToMatchId` is, a winner only on a COMPLETED match, scores never negative.
/// That both sides and the next match belong to the match's own event is the bracket service's check.
model SportEventMatch {
  id                          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId                String            @map("sport_event_id") @db.Uuid
  sportEventRoundId           String            @map("sport_event_round_id") @db.Uuid
  matchNumber                 Int               @map("match_number")
  homeSportEventParticipantId String?           @map("home_sport_event_participant_id") @db.Uuid
  awaySportEventParticipantId String?           @map("away_sport_event_participant_id") @db.Uuid
  isNeutralSite               Boolean           @map("is_neutral_site")
  scheduledDate               DateTime?         @map("scheduled_date") @db.Timestamptz
  status                      PrismaMatchStatus @default(SCHEDULED)
  winnerSide                  PrismaMatchSide?  @map("winner_side")
  homeScore                   Int?              @map("home_score")
  awayScore                   Int?              @map("away_score")
  /// A knockout match level after extra time is settled by a shoot-out (#791): both sides' kicks
  /// scored, or neither. Not part of the match score (IFAB Law 10); the winner's is the higher.
  homeShootoutScore           Int?              @map("home_shootout_score")
  awayShootoutScore           Int?              @map("away_shootout_score")
  /// How the match ended (#704): PLAYED unless it stopped early. A walkover has no scores.
  ending                      PrismaMatchEnding @default(PLAYED)
  advancesToMatchId           String?           @map("advances_to_match_id") @db.Uuid
  advancesToSide              PrismaMatchSide?  @map("advances_to_side")
  /// The bracket region or conference the match is in ("East", "AFC"); null where the bracket
  /// has none. A reseeded round pairs the teams of one region (#722).
  regionLabel                 String?           @map("region_label") @db.VarChar(40)
  /// The points spread from the home team's side (#720): -3.5 has the home team favoured by 3.5.
  /// Null until set; half points at most. A pick'em contest scored against the spread reads it.
  homeSpread                  Decimal?          @map("home_spread") @db.Decimal(4, 1)
  createdAt                   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent      SportEvent                    @relation(fields: [sportEventId], references: [id])
  sportEventRound SportEventRound               @relation(fields: [sportEventRoundId], references: [id])
  home            SportEventParticipant?        @relation("SportEventMatchHome", fields: [homeSportEventParticipantId], references: [id], onDelete: Restrict)
  away            SportEventParticipant?        @relation("SportEventMatchAway", fields: [awaySportEventParticipantId], references: [id], onDelete: Restrict)
  advancesTo      SportEventMatch?              @relation("SportEventMatchAdvancesTo", fields: [advancesToMatchId], references: [id], onDelete: NoAction)
  fedBy           SportEventMatch[]             @relation("SportEventMatchAdvancesTo")
  predictions     ContestEntryMatchPrediction[]
  periodScores    SportEventMatchPeriodScore[]
  squaresGames    ContestSquaresGame[]

  @@unique([sportEventId, matchNumber])
  // Two matches cannot feed the same side of the next one.
  @@unique([advancesToMatchId, advancesToSide])
  @@index([sportEventRoundId])
  @@index([homeSportEventParticipantId])
  @@index([awaySportEventParticipantId])
  @@map("sport_event_matches")
}

/// The score at the end of one period of a game (#772): the end of a quarter in American
/// football, as the scoreboard shows it, so a later period's score includes the earlier ones.
/// Rows exist for every period but the last: the final score, overtime included, is the match's
/// own result. Squares pools read it (#711); nothing derives one period from another.
model SportEventMatchPeriodScore {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventMatchId String   @map("sport_event_match_id") @db.Uuid
  periodNumber      Int      @map("period_number")
  homeScore         Int      @map("home_score")
  awayScore         Int      @map("away_score")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportEventMatch SportEventMatch @relation(fields: [sportEventMatchId], references: [id], onDelete: Cascade)

  @@unique([sportEventMatchId, periodNumber])
  @@map("sport_event_match_period_scores")
}

/// One participant's part in one round of an event — the (participant, round)
/// join, cross-sport. Its order is the round's `roundNumber`. What was scored
/// in the round lives in the sport's extension row, never here
/// (SportEventParticipantGolfRound for golf). sportEventRoundId replaced a
/// bare `round: Int` (plans/124 §4.10): a round number that doesn't exist for
/// the event fails at insert with a foreign-key violation.
model SportEventParticipantRound {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String                       @map("sport_event_participant_id") @db.Uuid
  sportEventRoundId       String                       @map("sport_event_round_id") @db.Uuid
  /// Provider-normalized progress of this participant's round.
  status                  PrismaParticipantRoundStatus
  completedAt             DateTime?                    @map("completed_at") @db.Timestamptz
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant           @relation(fields: [sportEventParticipantId], references: [id])
  sportEventRound       SportEventRound                 @relation(fields: [sportEventRoundId], references: [id])
  golf                  SportEventParticipantGolfRound?

  @@unique([sportEventParticipantId, sportEventRoundId])
  @@index([sportEventParticipantId])
  @@map("sport_event_participant_rounds")
}

/// Golf extension of SportEventParticipantRound: what one golfer scored in one
/// round. Keyed 1:1 to the core round row.
model SportEventParticipantGolfRound {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantRoundId String   @unique @map("participant_round_id") @db.Uuid
  strokes            Int
  scoreToPar         Int      @map("score_to_par")
  thru               Int?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  participantRound SportEventParticipantRound @relation(fields: [participantRoundId], references: [id])

  @@map("sport_event_participant_golf_rounds")
}

/// A participant's running standing in one event, cross-sport.
///
/// `position` is THE cross-sport rank key, and it is direction-free: 1 is best
/// in every sport. The raw score that produced it lives in the sport's
/// extension row (SportEventParticipantGolfStanding for golf), never here. A
/// cross-sport reader ranks on `position` and joins the extension only to
/// display a score — it never needs to know whether a higher or lower score is
/// better. Score direction is consulted at exactly one point: wherever
/// `position` is computed from a raw score.
model SportEventParticipantStanding {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String                    @unique @map("sport_event_participant_id") @db.Uuid
  position                Int?
  displayPosition         String?                   @map("display_position") @db.VarChar(20)
  status                  ParticipantStandingStatus @default(ACTIVE)
  asOf                    DateTime?                 @map("as_of") @db.Timestamptz
  currentRound            Int?                      @map("current_round")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant              @relation(fields: [sportEventParticipantId], references: [id])
  golf                  SportEventParticipantGolfStanding?

  @@index([status])
  @@index([position])
  @@map("sport_event_participant_standings")
}

/// Golf extension of SportEventParticipantStanding: the running event totals
/// one golfer's position was ranked from. Keyed 1:1 to the core standing row.
model SportEventParticipantGolfStanding {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standingId       String   @unique @map("standing_id") @db.Uuid
  eventScoreToPar  Int      @map("event_score_to_par")
  eventStrokes     Int      @map("event_strokes")
  currentRoundThru Int?     @map("current_round_thru")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  standing SportEventParticipantStanding @relation(fields: [standingId], references: [id])

  @@map("sport_event_participant_golf_standings")
}

/// Finish-position extension of a field row (#622): how one runner's race ended. Keyed 1:1 to
/// SportEventParticipant, because a race is one result per runner. Written only by the admin's
/// finishing order, which stores every value exactly as sent: `finishPosition` is null until
/// one is entered and for every status but FINISHED (a CHECK constraint holds that), and a
/// result counts in contest scoring only once `isOfficial`. `riderName` is the jockey for this
/// one start; the trainer is the participant's `teamAffiliation`.
model SportEventParticipantRaceResult {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String           @unique @map("sport_event_participant_id") @db.Uuid
  finishPosition          Int?             @map("finish_position")
  startPosition           Int?             @map("start_position")
  resultStatus            RaceResultStatus @map("result_status")
  isOfficial              Boolean          @default(false) @map("is_official")
  riderName               String?          @map("rider_name") @db.VarChar(255)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id], onDelete: Cascade)

  @@map("sport_event_participant_race_results")
}

/// Per-event tier definition, cross-sport. Event-level only — no contest
/// override (plans/124 §4.6). Tier count is however many rows exist for the
/// event, not a separate parameter (§4.5a).
model SportEventTier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventId String   @map("sport_event_id") @db.Uuid
  tierKey      String   @map("tier_key") @db.VarChar(50)
  label        String   @db.VarChar(100)
  tierNumber   Int      @map("tier_number")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sportEvent SportEvent                       @relation(fields: [sportEventId], references: [id])
  valuations SportEventParticipantValuation[]

  @@unique([sportEventId, tierKey])
  @@unique([sportEventId, tierNumber])
  @@map("sport_event_tiers")
}

/// The tier and/or price for one participant in one event, cross-sport — one
/// row per SportEventParticipant, the same 1:1 shape as ranking/oddsToWin/
/// seedNumber living there (plans/124 §4.5/§4.6b).
model SportEventParticipantValuation {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sportEventParticipantId String           @unique @map("sport_event_participant_id") @db.Uuid
  sportEventTierId        String?          @map("sport_event_tier_id") @db.Uuid
  tierOrderIndex          Int?             @map("tier_order_index")
  tierAssignedSource      ValuationSource? @map("tier_assigned_source")
  price                   Decimal?         @db.Decimal(10, 2)
  priceAssignedSource     ValuationSource? @map("price_assigned_source")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  sportEventParticipant SportEventParticipant @relation(fields: [sportEventParticipantId], references: [id])
  sportEventTier        SportEventTier?       @relation(fields: [sportEventTierId], references: [id])

  @@index([sportEventTierId, tierOrderIndex])
  @@map("sport_event_participant_valuations")
}

model ProviderSyncRun {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String                      @map("provider_id") @db.VarChar(100)
  sport       PrismaSport
  eventId     String?                     @map("event_id") @db.VarChar(255)
  status      PrismaProviderSyncRunStatus
  startedAt   DateTime?                   @map("started_at") @db.Timestamptz
  completedAt DateTime?                   @map("completed_at") @db.Timestamptz
  payloadJson Json                        @default("{}") @map("payload_json")
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([sport, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("provider_sync_runs")
}

// =============================================================================
// Platform
// =============================================================================

model PlatformRuntimeConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configJson  Json     @map("config_json")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_runtime_configs")
}

/// One saved change to a platform_runtime_configs row (#450). Append-only.
model PlatformRuntimeConfigHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey    String   @map("config_key") @db.VarChar(100)
  previousJson Json?    @map("previous_json")
  newJson      Json     @map("new_json")
  changedById  String?  @map("changed_by_id") @db.Uuid
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz

  @@index([configKey, changedAt(sort: Desc)])
  @@map("platform_runtime_config_history")
}
