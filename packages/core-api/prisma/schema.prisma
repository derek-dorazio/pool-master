// =============================================================================
// UTC Storage Convention
// =============================================================================
//
// ALL timestamps in this schema are stored as UTC.
//
// - Every DateTime column uses @db.Timestamptz (PostgreSQL `timestamptz`).
// - Application code MUST write UTC values — never local times.
// - Time zone conversion is a **display concern**: the app and emails show an
//   instant in the user's saved time zone (captured from the browser at
//   signup), or in US Eastern when they have none (#1039).
// =============================================================================

// =============================================================================
// Identity
// =============================================================================

model User {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String            @unique
  username     String            @unique @db.VarChar(100)
  passwordHash String?           @map("password_hash")
  firstName    String            @map("first_name") @db.VarChar(100)
  lastName     String            @map("last_name") @db.VarChar(100)
  isActive     Boolean           @default(true) @map("is_active")
  authProvider UserAuthProvider? @map("auth_provider")
  authId       String?           @map("auth_id")
  isRootAdmin  Boolean           @default(false) @map("is_root_admin")
  timezone     String?           @db.VarChar(50)
  locale       String?           @default("en-US") @db.VarChar(10)
  timeFormat   UserTimeFormat?   @default(TWELVE_HOUR) @map("time_format")
  colorScheme  UserColorScheme?  @map("color_scheme")
  /// When the user last started a session (#1882): signing in, signing up, or a session issued for them. Null until the first one after the column was added.
  lastSignInAt DateTime?         @map("last_sign_in_at") @db.Timestamptz
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  memberships                   LeagueMembership[]
  createdSquads                 Squad[]                @relation("SquadCreatedBy")
  squadMemberships              SquadMembership[]
  invitationsSent               LeagueInvitation[]     @relation("InvitedBy")
  invitationsAccepted           LeagueInvitation[]     @relation("AcceptedBy")
  squadOwnerInvitationsSent     SquadOwnerInvitation[] @relation("SquadOwnerInvitedBy")
  squadOwnerInvitationsAccepted SquadOwnerInvitation[] @relation("SquadOwnerAcceptedBy")

  contestDraws             ContestDraw[]
  yearReviewsSent          LeagueYearReview[]
  squaresClaimed           ContestEntrySquare[]
  squaresDrawn             ContestSquaresDraw[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailChangeUndoTokens    EmailChangeUndoToken[]
  emailMessages            EmailMessage[]
  emailOptOuts             EmailOptOut[]
  leaguePlanChanges        LeaguePlanChange[]        @relation("LeaguePlanChangedBy")
  leaguePlanRenewalChanges LeaguePlanRenewalChange[] @relation("LeaguePlanRenewalChangedBy")
  leaguePayments           LeaguePayment[]           @relation("LeaguePaymentPayer")
  startedBackgroundJobs    BackgroundJob[]           @relation("BackgroundJobStartedBy")
  syncFindingStatusChanges ProviderSyncFinding[]     @relation("SyncFindingStatusChangedBy")
  chosenTiebreakerGames    SportEventSlot[]          @relation("SportEventSlotTiebreakerGameChosenBy")

  @@index([isRootAdmin, isActive])
  /// Trigram indexes serve the root admin user search, a substring match on each column (#1180).
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_username_trgm_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_last_name_trgm_idx")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The SHA-256 of the token, in hex (#1230). The token itself is only ever in the client's cookie.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  sessionId String    @default(uuid()) @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  /// When a refresh replaced this token (#1229). Set with `revokedAt` on rotation only, never on a
  /// sign-out, so a rotated token that comes back can be told from one that was signed out.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  // The nightly cleanup finds the tokens expired for 30 days (#1175).
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A "Forgot password?" link (#847, plans/password-recovery.md). Only the SHA-256 of the
/// token is stored, so a database read cannot reset anybody. A link is live while it is
/// unused, not cancelled and not expired; a newer request or a password change cancels it.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

/// The "put my address back" link in the email an account's old address gets when its email
/// changes (#903 A5). Stored only as the token's SHA-256, usable once, live for 7 days.
model EmailChangeUndoToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  /// The address the link puts back.
  oldEmail    String    @map("old_email")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_change_undo_tokens")
}

// =============================================================================
// League
// =============================================================================

model League {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueCode          String                   @unique @map("league_code") @db.VarChar(16)
  name                String
  description         String?
  isActive            Boolean                  @default(true) @map("is_active")
  iconKey             PrismaLeagueIconKey      @default(TROPHY) @map("icon_key")
  /// The points table every cup and the championship score with (#841).
  cupPointsScale      PrismaCupPointsScale     @default(STANDARD) @map("cup_points_scale")
  /// The commissioner's points for 1st, 2nd ... ; set only for CUSTOM, empty otherwise (database check).
  cupCustomPoints     Int[]                    @default([]) @map("cup_custom_points")
  /// The league championship's name (#863), shown after its year: "2026 Derek's Pool Cup". Set to "<league name> Cup" at creation.
  cupName             String                   @map("cup_name")
  /// Whether the record book shows its Hall of Lame rows (#873): most 2nds, 4ths and last places, the longest drought.
  hallOfLameVisible   Boolean                  @default(true) @map("hall_of_lame_visible")
  /// What the league may do (#943): its caps and features come from PLAN_CONFIG. Premium at signup, a gift until `planRenewsAt` (plans/payments.md §3).
  plan                PrismaLeaguePlan         @default(PREMIUM)
  /// When the league's gifted plan ends (#986): six months after signup. Extending the gift moves it out.
  planRenewsAt        DateTime                 @default(dbgenerated("(now() + '6 mons'::interval)")) @map("plan_renews_at") @db.Timestamptz
  /// Sport leagues whose upcoming events this league's commissioners are not emailed about (#851):
  /// "Coming up soon" and "Ready for contests". Empty, the default: every sport league. A business
  /// list of sport league ids, checked when set, not a foreign key.
  mutedSportLeagueIds String[]                 @default([]) @map("muted_sport_league_ids") @db.Uuid
  /// How the commissioners hear about upcoming events (#851). Mirrors the domain `EventEmailDelivery`.
  eventEmailDelivery  PrismaEventEmailDelivery @default(PER_EVENT) @map("event_email_delivery")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  memberships           LeagueMembership[]
  cups                  Cup[]
  yearFinishes          LeagueYearFinish[]
  yearReviews           LeagueYearReview[]
  squads                Squad[]
  squadMemberships      SquadMembership[]
  contests              Contest[]
  invitations           LeagueInvitation[]
  squadOwnerInvitations SquadOwnerInvitation[]
  emailMessages         EmailMessage[]
  planChanges           LeaguePlanChange[]
  planRenewalChanges    LeaguePlanRenewalChange[]
  payments              LeaguePayment[]

  @@index([planRenewsAt])
  /// Serves the root admin league search, a substring match on the name (#1180).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "leagues_name_trgm_idx")
  @@map("leagues")
}

/// One line of a league's payment history (#980): what was bought or given, for how much, by whom
/// and when. Written once, never changed. No card details: those stay with the payment provider.
/// Deleting the contest or the payer keeps the row, with its description, and names nobody.
model LeaguePayment {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId    String                  @map("league_id") @db.Uuid
  contestId   String?                 @map("contest_id") @db.Uuid
  payerId     String?                 @map("payer_id") @db.Uuid
  kind        PrismaLeaguePaymentKind
  /// In US cents; 0 for an expansion given free (database check: never negative).
  amountCents Int                     @map("amount_cents")
  /// Written when the row is: "Masters pool: up to 200 entries, free while payments are off".
  description String
  paidAt      DateTime                @default(now()) @map("paid_at") @db.Timestamptz

  league    League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  contest   Contest?          @relation(fields: [contestId], references: [id], onDelete: SetNull)
  payer     User?             @relation("LeaguePaymentPayer", fields: [payerId], references: [id], onDelete: SetNull)
  expansion ContestExpansion?

  @@index([leagueId, paidAt(sort: Desc)])
  @@index([payerId, paidAt(sort: Desc)])
  @@index([contestId])
  @@map("league_payments")
}

/// One raise of a contest's entry cap (#980), bought or given: the contest takes up to
/// `entriesPerContest` entries, or its league plan's cap when that is higher. Append-only: a step
/// up adds a row, so the contest's expansion is its highest row and the rest are its history.
model ContestExpansion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contestId         String   @map("contest_id") @db.Uuid
  /// The band: the most entries the contest may hold (database check: at least 1).
  entriesPerContest Int      @map("entries_per_contest")
  /// The payment history line it came from, $0 when given free.
  paymentId         String   @unique @map("payment_id") @db.Uuid
  expandedAt        DateTime @default(now()) @map("expanded_at") @db.Timestamptz

  contest Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  payment LeaguePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([contestId, entriesPerContest])
  @@map("contest_expansions")
}

/// One change to a league's plan (#944): who moved it from which plan to which, and when. Append-only.
/// Deleting the user who made it keeps the row with nobody named, like platform_runtime_config_history.
model LeaguePlanChange {
  id           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId     String                       @map("league_id") @db.Uuid
  fromPlan     PrismaLeaguePlan             @map("from_plan")
  toPlan       PrismaLeaguePlan             @map("to_plan")
  /// Why it changed (#1032): picked by a person, the end of the preview period, or an ended gift put back.
  changeReason PrismaLeaguePlanChangeReason @map("change_reason")
  changedById  String?                      @map("changed_by_id") @db.Uuid
  changedAt    DateTime                     @default(now()) @map("changed_at") @db.Timestamptz

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("LeaguePlanChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leagueId, changedAt(sort: Desc)])
  @@index([changedById])
  @@map("league_plan_changes")
}

/// One move of a league's renewal date (#986): a root admin extending its gifted plan, from which date to which. Append-only.
/// Deleting the user who made it keeps the row with nobody named, like league_plan_changes.
model LeaguePlanRenewalChange {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId     String   @map("league_id") @db.Uuid
  fromRenewsAt DateTime @map("from_renews_at") @db.Timestamptz
  toRenewsAt   DateTime @map("to_renews_at") @db.Timestamptz
  changedById  String?  @map("changed_by_id") @db.Uuid
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("LeaguePlanRenewalChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leagueId, changedAt(sort: Desc)])
  @@index([changedById])
  @@map("league_plan_renewal_changes")
}

model LeagueMembership {
  id        String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId  String                       @map("league_id") @db.Uuid
