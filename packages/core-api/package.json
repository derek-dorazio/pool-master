{
  "name": "@poolmaster/core-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc && node --env-file-if-exists=../../.env scripts/write-version-info.mjs",
    "dev": "node --env-file-if-exists=../../.env scripts/write-version-info.mjs && tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1146.0",
    "@aws-sdk/client-sns": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@poolmaster/mock-contest-feed-provider": "*",
    "@poolmaster/shared": "*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
