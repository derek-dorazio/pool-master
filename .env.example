# PoolMaster — Local Development Environment
# Copy to .env and adjust as needed: cp .env.example .env
#
# What reads the copy: core-api's dev script loads the root .env natively via
# `node --env-file-if-exists` (packages/core-api/package.json "dev"). No dotenv
# dependency is involved, and nothing loads this file in CI or a deployed task.
# `npm run dev:start` makes the copy for you and fills in JWT_SECRET.
#
# Already-exported shell variables win over anything in this file — that is
# Node's own --env-file precedence, not a local convention. So the test lanes
# and CI, which set DATABASE_URL and friends inline, are unaffected by a .env.
#
# The Vite webapp does NOT read this file. Browser-exposed variables live in
# clients/poolmaster/.env.local; see clients/poolmaster/.env.example.

# === Deployment identity ===
# Both are REQUIRED — core-api will not start without them
# (packages/core-api/src/core/config.ts). There is deliberately no default:
# a hardcoded fallback means a misconfigured deployment reports something
# plausible and wrong instead of failing at startup.
# POOLMASTER_ENVIRONMENT is the one variable that says which environment this is:
# development, test, ci, qa, staging or prod. Our code never reads NODE_ENV, which
# belongs to Node and libraries and is "production" in every deployment (#184).
POOLMASTER_ENVIRONMENT=development
# POOLMASTER_SERVICE_VERSION is read at BUILD time, not by the running service:
# packages/core-api/scripts/write-version-info.mjs writes it into
# packages/core-api/version-info.json, and /version and log lines read that file
# (#180). `npm run dev` and `npm run build` run the script; it fails when this is
# unset. CI passes the commit SHA as a Docker build arg.
POOLMASTER_SERVICE_VERSION=0.0.0-local

# === Auth ===
# JWT signing key. Required at startup — the bootstrap throws if unset
# (see packages/core-api/src/core/config.ts; pool-master-rop.76.1).
# Generate a value yourself; do NOT commit it. Suggested:
#   openssl rand -base64 48 | tr -d '\n'
# Production must set the variable via the deployment's secret manager
# (AWS Secrets Manager → ECS task `secrets` block, K8s Secret mounted
# as env, etc.) — never via a committed file.
JWT_SECRET=

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster

# === Service Ports ===
# There is no per-service port variable. Every service reads one `PORT` and
# supplies its own default when it is unset:
#   core-api                    3000  (packages/core-api/src/index.ts)
#   mock-contest-feed-provider  3105  (packages/mock-contest-feed-provider/src/index.ts)
# Because the name is shared, `PORT` belongs to one process and not to this
# file — set it inline for the single service you are moving, e.g.
#   PORT=3001 npx tsx packages/core-api/src/index.ts
# Deployed tasks set it per service in infrastructure/terraform/main.tf.
# PORT=

# === Email ===
# Provider: "smtp" (Mailpit for dev, inbox at http://localhost:8025) or "ses" (LocalStack for dev,
# real SES for prod). Whether email is sent at all, per-email switches and the Reply-To address
# are the EMAIL_CONFIG app setting on /manage/settings, not env.
APP_BASE_URL=http://localhost:5173
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@poolmaster.local

# Optional SMTP transport settings, read by
# packages/core-api/src/modules/email/mail-delivery.ts. SMTP_SECURE counts only
# the literal string "true" as true. Mailpit needs no credentials, and both are
# left blank for the same reason JWT_SECRET is — do not commit a value.
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# SES config (used when EMAIL_PROVIDER=ses)
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SES_FROM_EMAIL=noreply@poolmaster.local
SES_CONFIGURATION_SET=

# === Message Bus ===
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:poolmaster-notifications
SQS_QUEUE_URL=http://localhost:4566/000000000000/poolmaster-notification-queue

# === External APIs ===
# The Odds API — sign up at https://the-odds-api.com (500 free req/month)
ODDS_API_KEY=

# === Sport Data Providers ===
# Both are REQUIRED in a deployed runtime. With POOLMASTER_ENVIRONMENT set to
# qa, staging or prod, core-api throws while building the app if no default
# provider is configured, and the QA deploy fails outright when the task
# definition is missing either name
# (packages/core-api/src/modules/ingestion/core/provider-bindings.ts for the reads,
# infrastructure/terraform/main.tf for the values it sets on the core-api task,
# and the jq contract check in .github/workflows/ci.yml for the deploy gate).
#
# Locally both are optional, and empty is the working default: no provider is
# registered and ingestion stays disabled. `mock-contest-feed` is the only
# provider id this service implements, and its binding needs a baseUrl. To
# exercise ingestion locally, start the mock provider (it listens on 3105) and
# set both, in this shape:
#   SPORT_DATA_DEFAULT_PROVIDER=mock-contest-feed
#   SPORT_DATA_PROVIDER_BINDINGS_JSON={"providers":{"mock-contest-feed":{"baseUrl":"http://localhost:3105"}}}
SPORT_DATA_DEFAULT_PROVIDER=
SPORT_DATA_PROVIDER_BINDINGS_JSON=

# === Scheduler ===
AUTO_START_SCHEDULER=false
