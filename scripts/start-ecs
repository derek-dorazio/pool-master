#!/usr/bin/env bash
set -euo pipefail

AWS_REGION="${AWS_REGION:-us-east-2}"
ECS_CLUSTER="${ECS_CLUSTER:-poolmaster-qa-cluster}"
ECS_SERVICES="${ECS_SERVICES:-poolmaster-qa-core-api poolmaster-qa-mock-contest-feed-provider}"
ECS_DESIRED_COUNT="${ECS_DESIRED_COUNT:-1}"

for service in $ECS_SERVICES; do
  aws ecs update-service \
    --region "$AWS_REGION" \
    --cluster "$ECS_CLUSTER" \
    --service "$service" \
    --desired-count "$ECS_DESIRED_COUNT"
done
