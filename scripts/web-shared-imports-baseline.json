{
  "$comment": "#2107 -- names the web app imports from @poolmaster/shared, /domain or /dto that are not contract vocabulary, with how many imports each may have. Read by scripts/check-web-shared-imports.mjs. Each count only falls: a slice that removes imports runs the check with --update in the same PR. The fix for an entry is a DTO field the API decides (rules/domain-model-conventions-rules.md §17); the ticket that removes each is in notes/web-violations-by-slice-2026-11-25.md and #2108-#2110. Types and enums are always allowed; $allowed lists the other name patterns that are vocabulary, each with its reason.",
  "$allowed": [
    {
      "pattern": "Order$",
      "reason": "An enum's declared order list (rules/domain-model-conventions-rules.md enum order)."
    },
    {
      "pattern": "^explicitOrder",
      "reason": "Reads an enum's declared order."
    },
    {
      "pattern": "^compareByEnumOrder$",
      "reason": "Sorts by an enum's declared order."
    },
    {
      "pattern": "^assertNever$",
      "reason": "Exhaustiveness check, no domain value."
    },
    {
      "pattern": "^pluralize$",
      "reason": "Display helper."
    },
    {
      "pattern": "^format",
      "reason": "Display formatter: turns a value the API sent into text."
    },
    {
      "pattern": "^describe",
      "reason": "Display formatter: describes rules the API sent."
    },
    {
      "pattern": "^PRODUCT_",
      "reason": "Brand strings (brand.ts)."
    },
    {
      "pattern": "^(sportVocabulary|sportLeagueNounOf|sportNoun)$",
      "reason": "Sport display words, looked up by the sport's code."
    },
    {
      "pattern": "ImagePath$",
      "reason": "Path of a static image."
    },
    {
      "pattern": "Schema$",
      "reason": "A zod schema of the contract."
    },
    {
      "pattern": "^isApiErrorCode$",
      "reason": "Checks an error code the API sent against the contract's codes."
    }
  ],
