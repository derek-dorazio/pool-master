{
  "name": "poolmaster",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant fantasy sports pool management platform",
  "workspaces": [
    "packages/*",
    "clients/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=@poolmaster/shared --filter=@poolmaster/core-api --filter=@poolmaster/poolmaster && npm run api:check && npm run api:validate",
    "build:service": "npm run build --workspace @poolmaster/shared && npm run build --workspace @poolmaster/core-api && npm run api:check && npm run api:validate",
    "build:poolmaster": "npm run build --workspace @poolmaster/shared && npm run build --workspace @poolmaster/poolmaster",
    "dev": "turbo run dev --parallel --filter=@poolmaster/core-api --filter=@poolmaster/poolmaster",
    "dev:start": "./scripts/dev-start.sh",
    "dev:infra": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d postgres mailpit",
    "dev:infra:all": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "dev:infra:stop": "docker compose -f infrastructure/docker/docker-compose.dev.yml down",
    "db:migrate": "cd packages/core-api && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster npx prisma migrate dev",
    "db:reset": "cd packages/core-api && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster npx prisma migrate reset",
    "db:test:migrate": "cd packages/core-api && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster_test npx prisma migrate deploy --schema prisma/schema.prisma",
    "db:test:reset": "cd packages/core-api && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster_test npx prisma migrate reset --force --skip-seed --schema prisma/schema.prisma",
    "db:test:recreate": "npm run db:test:reset",
    "db:drift:check": "node scripts/check-schema-migration-drift.mjs",
    "db:reset:qa": "cd packages/core-api && node scripts/reset-qa-database.mjs",
    "db:reset:qa:apply": "cd packages/core-api && node scripts/reset-qa-database.mjs --apply --confirm-qa-reset",
    "db:studio": "cd packages/core-api && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster npx prisma studio",
    "lint": "eslint 'packages/**/*.ts' 'tests/**/*.{ts,tsx}' 'clients/poolmaster/src/**/*.{ts,tsx}' --max-warnings 0 && npm run lint:theme-tokens",
    "lint:theme-tokens": "node scripts/check-feature-theme-tokens.mjs",
    "rules:check:route-discipline": "node scripts/check-route-discipline.mjs --warn-only",
    "rules:check:dto-conversion": "node scripts/check-dto-conversion-complete.mjs",
    "rules:check:migration-timestamps": "node scripts/check-migration-timestamps.mjs",
    "rules:check:form-query-mirror": "node scripts/check-form-query-mirror.mjs --warn-only",
    "rules:check:pr-review-triggers": "node scripts/check-pr-review-triggers.mjs",
    "rules:check:route-authorization": "node scripts/check-route-authorization.mjs",
    "rules:check": "npm run rules:check:migration-timestamps && npm run rules:check:dto-conversion && npm run rules:check:route-discipline && npm run rules:check:route-authorization && npm run rules:check:form-query-mirror && npm run rules:check:skill-references && npm run rules:check:plan-references",
    "typecheck": "turbo run typecheck --filter=@poolmaster/shared --filter=@poolmaster/core-api --filter=@poolmaster/poolmaster --force",
    "test": "jest --config tests/jest.config.js",
    "test:unit": "jest --config tests/jest.config.js tests/unit",
    "test:scripts": "node --test scripts/*.test.mjs packages/core-api/scripts/*.test.mjs",
    "test:integration": "jest --config tests/integration/jest.config.js --forceExit",
    "test:service:unit": "npm run test:unit",
    "test:service:integration": "npm run test:integration",
    "test:service:functional-api": "node scripts/run-service-functional-api.mjs",
    "test:service:integration:fresh": "npm run db:test:reset && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster_test npm run test:integration",
    "test:service:functional-api:fresh": "npm run db:test:reset && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster_test npm run test:service:functional-api",
    "test:poolmaster:unit": "npm run test --workspace @poolmaster/poolmaster",
    "test:poolmaster:browser-e2e": "npm run test:e2e --workspace @poolmaster/poolmaster",
    "test:poolmaster:browser-e2e:list": "npm run test:e2e:list --workspace @poolmaster/poolmaster",
    "test:poolmaster:browser-e2e:smoke": "npm run test:e2e:smoke --workspace @poolmaster/poolmaster",
    "test:coverage:service:unit": "jest --config tests/jest.config.js --coverage --coverageDirectory coverage/service-unit --coverageReporters=json-summary --coverageReporters=json --coverageReporters=lcovonly --coverageReporters=clover --coverageReporters=text-summary --forceExit",
    "test:coverage:service:integration": "jest --config tests/integration/jest.config.js --coverage --coverageDirectory coverage/service-integration --coverageReporters=json-summary --coverageReporters=json --coverageReporters=lcovonly --coverageReporters=clover --coverageReporters=text-summary --forceExit",
    "test:coverage:service:functional-api": "node scripts/run-service-functional-api-coverage.mjs",
    "test:coverage:service:merged": "node scripts/run-backend-coverage.mjs",
    "test:coverage:service:fresh": "npm run db:test:reset && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolmaster_test npm run test:coverage:service:merged",
    "test:coverage:poolmaster:unit": "npm run test:coverage --workspace @poolmaster/poolmaster",
    "test:functional": "npm run test:service:functional-api",
    "test:functional:coverage": "npm run test:coverage:service:functional-api",
    "test:coverage:backend": "npm run test:coverage:service:merged",
    "test:poolmaster": "npm run test:poolmaster:unit",
    "test:coverage:poolmaster": "npm run test:coverage:poolmaster:unit",
    "test:api": "jest --config tests/jest.config.js tests/api",
    "format": "prettier --write .",
    "api:export": "npm run build --workspace @poolmaster/shared && node --import tsx packages/core-api/scripts/export-openapi.ts",
    "api:generate": "npx @hey-api/openapi-ts -f packages/shared/openapi-ts.config.ts && npx openapi-typescript packages/shared/generated/openapi.json -o packages/shared/generated/api-types.ts",
    "api:check": "node scripts/check-openapi-fresh.mjs && node scripts/generate-api-routes.mjs --check",
    "api:routes": "node scripts/generate-api-routes.mjs",
    "api:validate": "node --import tsx scripts/validate-openapi-spec.ts",
    "api:refresh": "npm run api:export && npm run api:generate && npm run api:routes",
    "rules:check:skill-references": "node scripts/check-skill-references.mjs",
    "rules:check:plan-references": "node scripts/check-plan-references.mjs --warn-only",
    "lint:service": "eslint 'packages/**/*.ts' 'tests/**/*.{ts,tsx}' --max-warnings 0",
    "lint:webapp": "eslint 'clients/poolmaster/src/**/*.{ts,tsx}' --max-warnings 0 && npm run lint:theme-tokens",
    "typecheck:service": "turbo typecheck --filter=!@poolmaster/poolmaster",
    "typecheck:webapp": "turbo typecheck --filter=@poolmaster/poolmaster",
    "typecheck:tests": "tsc --noEmit --project tests/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit --project clients/poolmaster/tsconfig.e2e.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.95.0",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-vitest": "^0.5.4",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.7",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "v8-to-istanbul": "^9.3.0"
  },
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=20.12.0"
  }
}
