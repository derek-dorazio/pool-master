# Staging environment — deployed manually or on release branch
# Copy to staging.tfvars: cp staging.tfvars.example staging.tfvars
environment = "staging"
region      = "us-east-2"

# Database
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
# db_password and jwt_secret: deliberately not assigned in this file. Set via
# TF_VAR_db_password and TF_VAR_jwt_secret
# in your shell so the value never lands in a committed file. Do NOT add a
# `db_password` or `jwt_secret` line here — tfvars-file precedence is higher than
# TF_VAR_*, so an assignment here would silently override the env var.
# Generate jwt_secret with: openssl rand -base64 48 | tr -d '\n'

# ECS
ecs_cpu    = 256
ecs_memory = 512
core_api_bootstrap_image_tag = "bootstrap"

# Sports data providers
# Bind staging to approved real providers when that integration is ready.
sport_data_default_provider = ""
sport_data_provider_bindings_json = "{}"

# Domain → stage-ultimateofficepoolmanager.com
domain_name         = "ultimateofficepoolmanager.com"
acm_certificate_arn = "arn:aws:acm:us-east-2:614049083306:certificate/4d0fbf35-523d-4e71-bb33-3086aae9e4c8"
route53_zone_id     = "Z020704038X1AEGE6QNM9"
